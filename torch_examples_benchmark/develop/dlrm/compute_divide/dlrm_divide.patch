+# Copyright (c) Huawei Platforms, Inc. and affiliates.
+# 单卡 EBC：通过 EmbCacheEmbeddingCollectionSharder 创建 EmbCacheShardedEmbeddingCollection
+
+from __future__ import annotations
+
+from typing import Any, Dict, List, Optional
+
+import torch
+from torch import nn
+
+from torchrec.sparse.jagged_tensor import JaggedTensor, KeyedJaggedTensor
+from torchrec.distributed.types import ParameterSharding, ShardingEnv
+from torchrec_embcache.distributed.embedding import (
+    EmbCacheEmbeddingCollection,
+    EmbCacheShardedEmbeddingCollection,
+)
+from torchrec_embcache.distributed.sharding.embedding_sharder import (
+    EmbCacheEmbeddingCollectionSharder,
+)
+from torchrec_embcache.distributed.sharding.rw_sharding import (
+    EmbCacheRwSparseFeaturesDistAwaitable,
+)
+from torchrec_embcache.embcache_pybind import restore_async
+
+
+def create_single_card_embcache_sharded_embedding_collection(
+    sharder: EmbCacheEmbeddingCollectionSharder,
+    module: EmbCacheEmbeddingCollection,
+    table_name_to_parameter_sharding: Dict[str, ParameterSharding],
+    env: ShardingEnv,
+    device: Optional[torch.device] = None,
+    module_fqn: Optional[str] = None,
+) -> EmbCacheShardedEmbeddingCollection:
+    """
+    单卡 EBC 方法：通过传入 EmbCacheEmbeddingCollectionSharder 创建 EmbCacheShardedEmbeddingCollection。
+
+    Args:
+        sharder: EmbCacheEmbeddingCollectionSharder 实例（需已用单卡 cpu_env/npu_env 构造）
+        module: 未分片的 EmbCacheEmbeddingCollection
+        table_name_to_parameter_sharding: 表名到 ParameterSharding 的映射（单卡 plan）
+        env: 单卡 ShardingEnv（通常 world_size=1, rank=0）
+        device: 可选 NPU 设备
+        module_fqn: 可选模块全限定名
+
+    Returns:
+        EmbCacheShardedEmbeddingCollection，forward 使用基类实现，如需自定义可子类化后重写 forward。
+    """
+    return sharder.shard(
+        module=module,
+        params=table_name_to_parameter_sharding,
+        env=env,
+        device=device,
+        module_fqn=module_fqn,
+    )
+
+
+# Plan 中 embedding collection 的 FQN（与 DLRMTrain.model.sparse_arch.embedding_collection 一致）
+
+
+
+class SingleCardEmbCacheShardedEmbeddingCollection(nn.Module):
+    """
+    单卡 EmbCache Sharded Embedding Collection，包装 EmbCacheShardedEmbeddingCollection。
+    构造：直接传入 sharder.shard() 得到的 EmbCacheShardedEmbeddingCollection 实例。
+    """
+
+    def __init__(self, ebc_collection: EmbCacheShardedEmbeddingCollection) -> None:
+        super().__init__()
+        self._ec: EmbCacheShardedEmbeddingCollection = ebc_collection
+
+    def embedding_configs(self) -> list:
+        """供 SparseArchEC 等使用，与未分片 EC 接口一致。"""
+        return getattr(self._ec, "_embedding_configs", [])
+
+    def forward(self, features: KeyedJaggedTensor) -> Dict[str, JaggedTensor]:
+        """
+        单卡 forward：执行 input_dist、swap、restore，不做 output_dist（all2all），
+        查表后直接按 feature 名返回 Dict[str, JaggedTensor]。
+        """
+        ec = self._ec
+        ctx = ec.create_context()
+        kjt_list_split_awaitable = ec.input_dist(ctx, features)
+        for ind, awaitable in enumerate(kjt_list_split_awaitable.awaitables):
+            if isinstance(awaitable, EmbCacheRwSparseFeaturesDistAwaitable):
+                kjt_list_split_awaitable.awaitables[ind] = awaitable.wait()
+        dist_input = kjt_list_split_awaitable.wait().wait()
+        post_dist_input = ec.post_input_dist(ctx, dist_input).wait()
+        swap_info = ec.compute_swap_info_async(post_dist_input).get()
+
+        _stb_eb_codegen = ec.get_batched_embedding_kernels()[0][0]
+        swapout_offs = swap_info.swapout_offs.to(ec._device, non_blocking=True)
+        swapout_embs = _stb_eb_codegen.gather_embs(swapout_offs).to(ec._cpu_device)
+        swapout_optims = [
+            m.to(ec._cpu_device) for m in _stb_eb_codegen.gather_momentum(swapout_offs)
+        ]
+        ec.host_embedding_update_async(
+            swap_info, swapout_embs, swapout_optims
+        ).get()
+
+        swapin_tensor = ec.host_embedding_lookup_async(swap_info).get()
+        swap_embs = swapin_tensor.swapin_embs.to(ec._device, non_blocking=True)
+        swapin_optims = [
+            o.to(ec._device, non_blocking=True) for o in swapin_tensor.swapin_optims
+        ]
+        swapin_offs = swap_info.swapin_offs.to(ec._device, non_blocking=True)
+        _stb_eb_codegen.scatter_update_embs(swapin_offs, swap_embs)
+        _stb_eb_codegen.scatter_update_momentum(swapin_offs, swapin_optims)
+
+        restore_async(
+            swap_info.batch_offs,
+            post_dist_input[0].unique_inverse,
+            post_dist_input[0].unique_offset,
+            post_dist_input[0].offset_per_key(),
+            post_dist_input[0].hash_indices,
+        ).get()
+        post_dist_input[0].unique_indices = swap_info.batch_offs
+        post_dist_input[0] = post_dist_input[0].to(ec._device, non_blocking=True)
+
+        for sharding_ctx in ctx.sharding_contexts:
+            sharding_ctx.sparse_features_recat = None
+            if sharding_ctx.unbucketize_permute_tensor is not None:
+                sharding_ctx.unbucketize_permute_tensor = (
+                    sharding_ctx.unbucketize_permute_tensor.to(
+                        ec._device, non_blocking=True
+                    )
+                )
+            sharding_ctx.features_before_input_dist = (
+                sharding_ctx.features_before_input_dist.to(
+                    ec._device, non_blocking=True
+                )
+            )
+
+        result: Dict[str, JaggedTensor] = {}
+        for idx, (lookup, sharding_ctx, input_feat, sharding_type) in enumerate(
+            zip(
+                ec._lookups,
+                ctx.sharding_contexts,
+                post_dist_input,
+                ec._sharding_type_to_sharding,
+            )
+        ):
+            sharding_ctx.lengths_after_input_dist = input_feat.lengths().view(
+                -1, input_feat.stride()
+            )
+            lookup_ret = lookup(input_feat)
+            embedding_dim = ec._embedding_dim_for_sharding_type(sharding_type)
+            lookup_ret = lookup_ret.view(-1, embedding_dim)
+            lengths = sharding_ctx.lengths_after_input_dist.view(-1)
+            names = ec._embedding_names_per_sharding[idx]
+            # 按 feature 切分：每个 name 对应自己的 values 段和 lengths 段
+            offsets = input_feat.offset_per_key()
+            stride = input_feat.stride()
+
+            for i, name in enumerate(names):
+                start, end = offsets[i], offsets[i + 1]
+                result[name] = JaggedTensor(
+                    values=lookup_ret[start:end],
+                    lengths=lengths[i * stride : (i + 1) * stride],
+                )
+        return result

+import os
+import torch
+import numpy as np
+
+class ioChecker:
+    def __init__(self, save_dir, device, check):
+        self.path = save_dir
+        self.device = device
+        self.check = check
+        torch.backends.cudnn.deterministic = self.check
+        torch.backends.cudnn.benchmark = not self.check
+
+    def _to_cpu_detached(self, obj):
+        if isinstance(obj, torch.Tensor):
+            return obj.detach().cpu()
+        if isinstance(obj, dict):
+            return {k: self._to_cpu_detached(v) for k, v in obj.items()}
+        if isinstance(obj, (list, tuple)):
+            t = [self._to_cpu_detached(v) for v in obj]
+            return type(obj)(t)
+        return obj
+
+    def _to_device(self,obj, device):
+        if isinstance(obj, torch.Tensor):
+            return obj.to(device)
+        if isinstance(obj, dict):
+            return {k: self._to_device(v, device) for k, v in obj.items()}
+        if isinstance(obj, (list, tuple)):
+            t = [self._to_device(v) for v in obj]
+            return type(obj)(t)
+        return obj
+
+    def load_or_save_inputs(self, inputs, t, name):
+        if not self.check:
+            return inputs
+        if t != 0:
+            return inputs
+        save_path = os.path.normpath(self.path + f'{name}.pt')
+        if os.path.exists(save_path):
+            data = torch.load(save_path, map_location="cpu", weights_only=False)
+            print(f" loading input from {save_path}")
+            return self._to_device(data, self.device) if self.device else data
+
+        os.makedirs(self.path, exist_ok=True)
+        torch.save(self._to_cpu_detached(inputs), save_path)
+        print(f" save input to {self.path}")
+        return inputs
+
+
+    def save_outputs(self, outputs, t, name):
+        if t == 0 and self.check:
+            save_path = os.path.normpath(self.path + f'{name}.pt')
+            os.makedirs(self.path, exist_ok=True)
+            torch.save(self._to_cpu_detached(outputs), save_path)
+            print(f" save output to {save_path}")
+        return outputs
+
+def load_value(path):
+    x = torch.load(path, map_location="cpu", weights_only=False)
+    if isinstance(x, torch.Tensor):
+        return x.detach().cpu().float()
+    if isinstance(x, np.ndarray):
+        return torch.from_numpy(x).cpu().float()
+    return torch.tensor(x).cpu().float()
+
+def compare_tensor_outputs(gpu_path, npu_path, atol=1e-5, rtol=1e-5):
+    gpu = load_value(gpu_path)
+    npu = load_value(npu_path)
+    print("gpu:",gpu)
+    print("npu:",npu)
+
+    if gpu.shape != npu.shape:
+        raise ValueError(f"Shape mismatch: gpu={gpu.shape}, npu={npu.shape}")
+
+    diff = (npu - gpu).abs()
+
+    p99 = torch.quantile(diff, 0.99).item()
+    eps = 1e-12
+    rel = diff / (gpu.abs() + eps)
+
+    all_ok = torch.allclose(npu, gpu, atol=atol, rtol=rtol)
+
+    pyPath = "[ check_results.py ]"
+    print(f"{pyPath} ==== NPU vs GPU output====")
+    print(f"{pyPath} files: gpu={gpu_path} ")
+    print(f"{pyPath} files: npu={npu_path}")
+    print(f"{pyPath} shape: {tuple(gpu.shape)} | numel: {gpu.numel()}")
+    print(f"{pyPath} allclose(atol={atol}, rtol={rtol}): {all_ok}")
+    print(f"{pyPath} mean_abs_err  : {diff.mean().item():.6g}")
+    print(f"{pyPath} mean_rel_err  : {rel.mean().item():.6g}")
+    print(f"{pyPath} p99_abs_err   : {p99:.6g}")
+    torch.testing.assert_close(gpu, npu, rtol=rtol, atol=atol, equal_nan=True)
+
+
+if __name__ == "__main__":
+    compare_tensor_outputs(
+        gpu_path="",
+        npu_path="",
+        atol=1e-3,
+        rtol=1e-3,
+    )

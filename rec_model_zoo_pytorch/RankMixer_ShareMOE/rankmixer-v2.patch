+class FFN_npu_swiglu(torch.nn.Module):
+    def __init__(self, dim: int, hidden_dim: int, dtype, dropout=0, ):
+        super().__init__()
+        if ENABLE_NPU:
+            self.w1 = torch.nn.Linear(dim, hidden_dim, bias=False).to(dtype).to("npu")
+            self.w2 = torch.nn.Linear(hidden_dim, dim, bias=False).to(dtype).to("npu")
+            self.w3 = torch.nn.Linear(dim, hidden_dim, bias=False).to(dtype).to("npu")
+        else:
+            self.w1 = torch.nn.Linear(dim, hidden_dim, bias=False).to(dtype).cuda()
+            self.w2 = torch.nn.Linear(hidden_dim, dim, bias=False).to(dtype).cuda()
+            self.w3 = torch.nn.Linear(dim, hidden_dim, bias=False).to(dtype).cuda()
+        self.dropout = torch.nn.Dropout(dropout).to(dtype)
+
+
+    def forward(self, x):
+        return self.dropout(self.w2(F.silu(self.w1(x)) * self.w3(x)))
+
+class MOERouter(torch.nn.Module):
+    def __init__(self, emb_dim, expert_number, top_k_number, dtype):
+        super().__init__()
+        self.gate = torch.nn.Linear(emb_dim, expert_number, dtype=dtype)
+        for param in self.gate.parameters():
+            param.requires_grad = False
+            param.copy_(torch.empty_like(param).uniform_(-0.5, 0.5))
+        self.expert_number = expert_number
+        self.top_k = top_k_number
+
+    def forward(self, hidden_states):
+        router_logits = self.gate(hidden_states)
+        router_weights, selected_experts = torch.topk(router_logits, self.top_k, dim=-1)
+        router_weights = torch.softmax(router_weights, dim=-1)
+        selected_experts = selected_experts.contiguous()
+        expert_mask = F.one_hot(selected_experts, num_classes=self.expert_number).to(torch.int32)
+        group_list = expert_mask.sum(dim=1)
+        group_list = group_list.permute(1, 0)
+        group_list = group_list.sum(dim=1)
+        expert_mask = expert_mask.permute(2, 1, 0)
+
+        return router_weights, expert_mask, selected_experts, group_list
+
+class SparseMOE_share(torch.nn.Module):
+    def __init__(
+            self,
+            emb_dim,
+            expert_number,
+            top_k,
+            dtype,
+    ):
+        super().__init__()
+
+        self.ffn_hidden_dim = emb_dim*4
+        self.expert_number = expert_number
+        self.experts = torch.nn.ModuleList([
+            FFN_npu_swiglu(emb_dim, self.ffn_hidden_dim, dtype) for _ in range(self.expert_number)])
+        self.cw1, self.cw2, self.cw3 = self.create_expert_weights(self.experts)
+        self.router = MOERouter(emb_dim, expert_number, top_k, dtype)  # todo 专家token blance
+        self.top_k = top_k
+        self.dtype = dtype
+
+    def create_expert_weights(self, experts):
+        """创建多个专家的权重"""
+        w1_list = []
+        w2_list = []
+        w3_list = []
+
+        if ENABLE_NPU:
+            for item in experts:
+                w1 = item.w1.weight.T
+                w2 = item.w2.weight.T
+                w3 = item.w3.weight.T
+                w1_list.append(w1)
+                w2_list.append(w2)
+                w3_list.append(w3)
+
+            return w1_list, w2_list, w3_list
+
+        for item in experts:
+            w1 = item.w1.weight.unsqueeze(0)
+            w2 = item.w2.weight.unsqueeze(0)
+            w3 = item.w3.weight.unsqueeze(0)
+            w1_list.append(w1)
+            w2_list.append(w2)
+            w3_list.append(w3)
+
+        return torch.concat(w1_list), torch.concat(w2_list), torch.concat(w3_list)
+
+    def reload_weights(self):
+        self.cw1, self.cw2, self.cw3 = self.create_expert_weights(self.experts)
+
+    def compute_ffn_with_grouped_matmul(self, expanded_x, w1_list, w2_list, w3_list, group_list):
+        if ENABLE_NPU:
+            w1_out = torch_npu.npu_grouped_matmul(
+                x=[expanded_x],
+                weight=w1_list,
+                scale=None,
+                group_list=group_list,
+                split_item=2,
+                group_list_type=1,
+                group_type=0,
+                output_dtype=self.dtype,)[0]
+
+            w3_out = torch_npu.npu_grouped_matmul(
+                x=[expanded_x],
+                weight=w3_list,
+                scale=None,
+                group_list=group_list,
+                split_item=2,
+                group_list_type=1,
+                group_type=0,
+                output_dtype=self.dtype,)[0]
+
+            gate = F.silu(w1_out)
+            combined = gate * w3_out
+
+            w2_out = torch_npu.npu_grouped_matmul(
+                x=[combined],
+                weight=w2_list,
+                scale=None,
+                group_list=group_list,
+                split_item=2,
+                group_list_type=1,
+                group_type=0,
+                output_dtype=self.dtype,)[0]
+
+            return w2_out
+
+        w1_out = grouped_gemm.ops.gmm(expanded_x, w1_list, group_list,trans_b=True)
+        w3_out = grouped_gemm.ops.gmm(expanded_x, w3_list, group_list,trans_b=True)
+        gate = F.silu(w1_out)
+        combined = gate * w3_out
+        w2_out = grouped_gemm.ops.gmm(combined, w2_list, group_list,trans_b=True)
+
+        return w2_out

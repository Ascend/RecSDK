+        if ENABLE_NPU:
+            gates = torch.zeros_like(router_weights)
+            gates.scatter_(dim=-1, index=selected_experts, src=router_weights)
+            reg_loss = gates.sum(-1).sum(-1)
+            tokens = x.reshape(bs * seq_len, hidden_dim)
+

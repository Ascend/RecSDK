+    def _generate_cache_key(self, config, data):
+        # 生成基于模型状态和数据集的缓存键
+        model_state = {}
+        for name, param in self.model.named_parameters():
+            if 'item' in name.lower() or 'llm' in name.lower():  # 只考虑与item相关的参数
+                # 处理BFloat16等不支持的数据类型
+                param_data = param.data.cpu()
+                if param_data.dtype == torch.bfloat16:
+                    param_data = param_data.float()
+                    self.logger.warning(f"Don't support bfloat16 for {name}, trans dtype to: {param_data.dtype}")
+                model_state[name] = param_data.numpy().tobytes()
+
+        cache_info = {
+            'model_state': model_state,
+            'item_num': data.item_num,
+            'use_text': self.use_text,
+            'stage': config.get('stage', None),
+            'model_name': config.get('model', ''),
+        }
+
+        cache_str = str(sorted(cache_info.items()))
+        cache_key = hashlib.md5(cache_str.encode()).hexdigest()
+        return cache_key
+
+    def _get_cache_path(self, cache_key):

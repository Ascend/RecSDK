diff --git a/code/REC/model/HLLM/flash_self_attn_npu.py b/code/REC/model/HLLM/flash_self_attn_npu.py
new file mode 100644
--- /dev/null	(revision fb6619e096b7b3a00a88e34f6daff9e000afa55e)
+++ b/code/REC/model/HLLM/flash_self_attn_npu.py	(revision fb6619e096b7b3a00a88e34f6daff9e000afa55e)
@@ -0,0 +1,121 @@
+from typing import Optional
+
+import torch
+import torch_npu
+import torch._dynamo as dynamo
+
+
+@dynamo.disable
+def compute_flash_attention(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    v: torch.Tensor,
+    attention_mask: Optional[torch.Tensor] = None,
+    cu_input_lens: Optional[torch.Tensor] = None,
+    causal: bool = True,
+    training: bool = False,
+    attention_dropout: float = 0.0,
+):
+    """Modified from https://github.com/LAION-AI/Open-Assistant/blob/main/model/model_training/models/patching_utils.py"""
+    # q, k, v: [bs, seq_len, num_attention_heads, attn_head_size]
+    # attention_mask (float): [bs, seq_len]
+    if q.dtype not in (torch.float16, torch.bfloat16):
+        q = q.to(torch.bfloat16)
+        k = k.to(torch.bfloat16)
+        v = v.to(torch.bfloat16)
+    batch_size, max_len = q.size(0), q.size(1)
+
+    qkv = torch.stack([q, k, v], dim=2)  # [bs, seq_len, 3, num_attention_heads, attn_head_size]
+
+    if cu_input_lens is not None:
+        qkv.squeeze_(0)
+        cu_seqlens = cu_input_lens.cumsum(dim=0, dtype=torch.int32)
+
+        S = cu_input_lens.max().item()
+        N = q.shape[1]
+        causal_mask = torch.triu(torch.ones(S, S, device=q.device, dtype=torch.bool), diagonal=1) if causal else None
+        cu_seqlens_array = cu_seqlens.cpu().numpy().tolist()
+        softmax_scale = 1 / (q.shape[-1] ** 0.5)
+
+        return torch_npu.npu_fused_infer_attention_score(
+            query=q,
+            key=k,
+            value=v,
+            input_layout="TND",
+            num_heads=N,
+            num_key_value_heads=N,
+            scale=softmax_scale,
+            actual_seq_lengths=cu_seqlens_array,
+            actual_seq_lengths_kv=cu_seqlens_array,
+            sparse_mode=0,
+            atten_mask=causal_mask,
+            pre_tokens=S,
+            next_tokens=0,
+        )[0]
+    elif attention_mask is None:
+        S = q.shape[1]
+        N = q.shape[2]
+        causal_mask = torch.triu(torch.ones(S, S, device=q.device, dtype=torch.bool), diagonal=1) if causal else None
+        softmax_scale = 1 / (q.shape[-1] ** 0.5)
+        return torch_npu.npu_fused_infer_attention_score(
+            query=q,
+            key=k,
+            value=v,
+            input_layout="TND",
+            num_heads=N,
+            scale=softmax_scale,
+            sparse_mode=0,
+            atten_mask=causal_mask,
+            pre_tokens=S,
+            next_tokens=0,
+        )[0]
+    else:
+        # Limitation: non-contiguous attention mask will not be handled correctly
+        # model will be able to pay attention between the first and last non-masked token, i.e. left- and right-side padding is supported.
+        cur_mask = attention_mask >= 0
+        csums = cur_mask.cumsum(dim=1, dtype=torch.int32)
+        ends = csums.argmax(dim=1) + 1
+        starts = ends - csums.max(dim=1).values
+        seqlens = ends - starts
+
+        # qkv = torch.cat([qkv[i, starts[i] : ends[i]] for i in range(batch_size)], dim=0)
+        qkv = qkv.view(batch_size*max_len, *qkv.size()[2:])
+        cur_mask_idx = cur_mask.flatten().nonzero().squeeze()
+        qkv = torch.index_select(qkv, dim=0, index=cur_mask_idx)
+        cu_seqlens = seqlens.cumsum(dim=0, dtype=torch.int32)
+
+        S = torch.max(seqlens).item()
+        N = qkv.shape[-2]
+        cu_seqlens_array = cu_seqlens.cpu().numpy().tolist()
+        softmax_scale = 1 / (q.shape[-1] ** 0.5)
+        causal_tri = torch.triu(
+            torch.ones(2048, 2048, device=q.device, dtype=torch.bool), diagonal=1) if causal else None
+        out = torch_npu.npu_fused_infer_attention_score(
+            query=qkv[:, 0, :, :],
+            key=qkv[:, 1, :, :],
+            value=qkv[:, 2, :, :],
+            input_layout="TND",
+            num_heads=N,
+            num_key_value_heads=N,
+            scale=softmax_scale,
+            actual_seq_lengths=cu_seqlens_array,
+            actual_seq_lengths_kv=cu_seqlens_array,
+            sparse_mode=3,
+            atten_mask=causal_tri,
+            pre_tokens=S,
+            next_tokens=0,
+        )[0]
+        D = out.shape[-1]
+        seqlens = ends - starts
+        batch_indices = torch.repeat_interleave(torch.arange(batch_size, device=out.device), seqlens)
+        start_offsets = torch.repeat_interleave(starts, seqlens)
+        base_offsets = torch.arange(seqlens.sum().item(), device=out.device)
+        offsets = base_offsets - torch.repeat_interleave(
+            torch.cat([torch.tensor([0], device=out.device), seqlens.cumsum(0)[:-1]]),
+            seqlens
+        )
+        seq_indices = start_offsets + offsets
+        out_rebuilt = torch.zeros((batch_size * S, N * D), device=out.device, dtype=out.dtype)
+        out_rebuilt.index_put_([batch_indices * S + seq_indices], out.view(-1, N * D))
+
+        return out_rebuilt.view(batch_size, S, N, D)

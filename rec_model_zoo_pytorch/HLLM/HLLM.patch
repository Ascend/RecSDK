+                                                  refresh=False)
+                        iter_data.set_postfix_str(set_color('NPU RAM: ' + get_gpu_usage(self.device), 'yellow'),
+                                                  refresh=False)
+                    self.eval_collector.eval_batch_collect(scores, positive_u, positive_i)
+                    e2e_time = fwd_time - start_time
+                    self.logger.info(f"E2E time for batch-{batch_idx}: {e2e_time:.3f}")
+                    if profiler:
+                        prof.step()
+                    if wait_steps + warmup_steps + profiler_batch_count + 1 <= batch_idx <= total_steps - 1:
+                        e2e_records.append({
+                            "batch_idx": batch_idx,
+                            "e2e_time": e2e_time,
+                        })
+
+                    # Save precision
+                    check_precision = os.getenv('CHECK_PRECISION', False)
+                    precision_path = os.getenv('PRECISION_PATH', '/tmp')
+                    if check_precision:
+                        self.logger.info(f"Checking precision for batch-{batch_idx}")
+                        torch.save(scores, os.path.join(precision_path, f"scores-{batch_idx}.pt"))
+                        torch.save(positive_u, os.path.join(precision_path, f"positive_u-{batch_idx}.pt"))
+                        torch.save(positive_i, os.path.join(precision_path, f"positive_i-{batch_idx}.pt"))
+
+                    if profiler and batch_idx >= total_steps - 1:
+                        self.logger.info("Profiler finished, stop evaluating early")
+                        break
+                    if check_precision_with_gpu:
+                        self.logger.info("Check precision mode, stop evaluating early")
+                        break
+
+                # E2E time
+                df = pd.DataFrame(e2e_records)
+                csv_path = os.path.join(self.checkpoint_dir, 'e2e_records.csv')
+                df.to_csv(csv_path, index=False)
+                self.logger.info(f"E2E records written to {csv_path}")
+                try:
+                    lat_ms = df['e2e_time'].to_numpy(dtype=float) * 1000.0
+                    p99_latency = float(np.percentile(lat_ms, 99))
+                    p90_latency = float(np.percentile(lat_ms, 90))
+                    avg_latency = float(lat_ms.mean())
+                    batch_size = self.config.get('eval_batch_size', 128)
+                    qps = (1000.0 * batch_size) / avg_latency if avg_latency > 0 else 0.0
+                    summary = {
+                        "count": int(lat_ms.shape[0]),
+                        "batch_size": int(batch_size),
+                        "p99_latency_ms": round(p99_latency, 6),
+                        "p90_latency_ms": round(p90_latency, 6),
+                        "avg_latency_ms": round(avg_latency, 6),
+                        "qps": round(qps, 3),
+                    }
+                    summary_path = os.path.join(self.checkpoint_dir, 'e2e_latency_summary.csv')
+                    pd.DataFrame([summary]).to_csv(summary_path, index=False)
+                    self.logger.info(f"E2E Latency summary written to {summary_path}")
+                    self.logger.info(f"E2E latency metrics: {summary}")
+                except Exception as e:
+                    self.logger.warning(f"Failed to write e2e latency metrics: {e}")
+
+            num_total_examples = len(eval_data.sampler.dataset)
+            struct = self.eval_collector.get_data_struct()
+            result = self.evaluator.evaluate(struct)
+
+            metric_decimal_place = 5 if self.config['metric_decimal_place'] == None else self.config['metric_decimal_place']
+            for k, v in result.items():
+                result_cpu = self.distributed_concat(torch.tensor([v]).to(self.device), num_total_examples).cpu()
+                result[k] = round(result_cpu.item(), metric_decimal_place)
+            self.wandblogger.log_eval_metrics(result, head='eval')
+
+            return result
+
+    def save_input_output(self, input, output, dir="./precision", filename="input_output.pt"):
+        os.makedirs(dir, exist_ok=True)
+        file_path = os.path.join(dir, filename)
+        file_path = get_unique_path(file_path)
+        data = {
+            "HLLM": {
+                "type": "model",
+                "input": to_clean_cpu_tensor(input),
+                "output": to_clean_cpu_tensor(output),
+            }
+        }
+        self.logger.info(f"Saving input and output...")
+        torch.save(data, file_path)
+        self.logger.info(f"Saved input and output to {file_path}")

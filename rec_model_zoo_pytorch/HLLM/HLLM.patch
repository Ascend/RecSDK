+def patch_manual_graph(model):
+    model.graph = torch.cuda.CUDAGraph()
+    model.graph_prepared = False
+    model.static_pos_embedding = None
+    model.static_attention_mask = None
+    model.static_outputs = None
+    orig_func = model.get_seq_output
 
+    def get_seq_output_graph(pos_embedding, attention_mask):
+        if not model.graph_prepared:
+            model.static_pos_embedding = pos_embedding.clone()
+            model.static_attention_mask = attention_mask.clone()
+            # warmup
+            for _ in range(3):
+                with torch.no_grad():
+                    _ = orig_func(model.static_pos_embedding, model.static_attention_mask)
+            torch.cuda.synchronize()
+            model.graph_prepared = True
+            with torch.cuda.graph(model.graph):
+                model.static_outputs = orig_func(model.static_pos_embedding, model.static_attention_mask)
+        else:
+            model.static_pos_embedding.copy_(pos_embedding)
+            model.static_attention_mask.copy_(attention_mask)
+        model.graph.replay()
+        torch.cuda.synchronize()
+        return model.static_outputs
+    model.get_seq_output = get_seq_output_graph

+        cache_files = [f for f in os.listdir(cache_dir) if f.endswith('.pkl')]
+        if not cache_files:
+            return None
+        cache_file = cache_files[0]
+        cache_path = os.path.join(cache_dir, cache_file)
+        return self._load_item_feature_cache(cache_path)

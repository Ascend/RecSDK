+def get_unique_path(path):
+    path = Path(path)
+    if not(path.exists()):
+        return path
+    stem = path.stem
+    suffix = path.suffix
+    parent = path.parent
+    counter = 1
+    while True:
+        new_name = f"{stem}_{counter}{suffix}"
+        new_path = parent / new_name
+        if not new_path.exists():
+            return new_path
+        counter += 1
+
+
+def to_clean_cpu_tensor(data):
+    if isinstance(data, torch.Tensor):
+        return data.detach().cpu()
+    elif isinstance(data, (list, tuple)):
+        return type(data)(to_clean_cpu_tensor(item) for item in data)
+    elif isinstance(data, dict):
+        return {key: to_clean_cpu_tensor(value) for key, value in data.items()}
+    elif isinstance(data, (int, float, bool, str, bytes, type(None))):
+        return data
+    else:
+        return str(data)
 
 

+import os
+
+def _load_flash_attention():
+    device_type = os.getenv('DEVICE_TYPE', 'cpu')
+    try:
+        if device_type == 'npu':
+            print("DEVICE_TYPE type is npu, try import flash_self_attn_npu")
+            from .flash_self_attn_npu import compute_flash_attention
+            return compute_flash_attention
+        else:
+            print(f"DEVICE_TYPE type is {device_type}, import flash_self_attn")
+            from .flash_self_attn import compute_flash_attention
+            return compute_flash_attention
+    except ImportError as e:
+        print(f"DEVICE_TYPE type is {device_type}, import flash_self_attn error: {e}")
+        return None
+
+compute_flash_attention = _load_flash_attention()

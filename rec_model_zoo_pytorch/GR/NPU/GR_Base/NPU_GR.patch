+import torch
+import torch_npu
+
+out_dict = {}
+for i, file_name in enumerate(["eager_out.pt", "inductor_out.pt"]):
+    eager_res = torch.load(file_name)
+    sorted_values, sorted_indices = torch.sort(eager_res, dim=0)
+
+    # 将索引和值从张量转换为列表
+    indices_list = sorted_indices.squeeze().tolist()
+    values_list = sorted_values.squeeze().tolist()
+    out_dict[i] = indices_list
+    # 打印结果
+    print("rank10 idx:", indices_list[-10:])
+    print("rank10 value:", values_list[-10:])
+
+l1 = out_dict[0]
+l2 = out_dict[1]
+diff_list = []
+for value in l1:
+    if value not in l2:
+        diff_list.append(value)
+
+if len(diff_list) <= 2:
+    print("percise correct")
+else:
+    print(f"percise Error diff_list:{diff_list}")

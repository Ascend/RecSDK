+@torch.library.register_fake("mxrec::jagged_to_padded_dense.v1")
+def jagged_to_padded_dense_v1_fake(values, offsets, max_lengths, padding_value):
+    """
+    为 mxrec.jagged_to_padded_dense.v1 算子注册伪实现
+
+    参数:
+        values: 不规则张量的值部分 [total_values, embedding_dim]
+        offsets: 偏移量张量的列表，每个张量形状为 [batch_size + 1]
+        max_lengths: 最大长度，整数
+        padding_value: 填充值，浮点数
+
+    返回:
+        out: 填充后的密集张量 [batch_size, max_lengths, embedding_dim]
+    """
+    # 检查输入条件
+    torch._check(values.dim() == 2, "values must be 2D tensor")
+    torch._check(isinstance(offsets, list), "offsets must be a list")
+    torch._check(len(offsets) > 0, "offsets list cannot be empty")
+    torch._check(all(torch.is_tensor(offset) for offset in offsets),
+                 "All elements in offsets must be Tensors")
+    torch._check(isinstance(max_lengths, int), "max_lengths must be integer")
+    torch._check(isinstance(padding_value, float), "padding_value must be float")
+
+    # 获取输入形状信息
+    total_values, embedding_dim = values.shape
+
+    # 从第一个偏移量张量获取批次大小
+    # 假设所有偏移量张量都有相同的形状 [batch_size + 1]
+    batch_size = offsets[0].shape[0] - 1
+
+    # 计算输出形状 [batch_size, max_lengths, embedding_dim]
+    out_shape = (batch_size, max_lengths, embedding_dim)
+
+    # 创建适当形状和类型的空张量
+    out = torch.empty(
+        out_shape,
+        dtype=values.dtype,
+        device=values.device
+    )
+
+    return out

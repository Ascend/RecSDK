+import torch
+
+def compare_npu_and_gpu_out():
+    print("")
+    out_dict = []
+    input_tensor = []
+    dirs = "input_output/"
+    for item in ["gpu_output.pt", "npu_output.pt"]:
+        try:
+            logistic_out = torch.load(dirs + item)
+            print("")
+            print(item," tensor加载成功 ",item, "的dtype是 ", logistic_out.dtype)
+        except FileNotFoundError:
+            print(item + "未找到，跳过精度验证。")
+            return
+
+        sorted_values, sorted_indices = torch.sort(logistic_out[0:100], dim=0)
+        # 将索引和值从张量转换为列表
+        indices_list = sorted_indices.squeeze().tolist()
+        values_list = sorted_values.squeeze().tolist()
+        input_tensor.append(values_list[-10:])
+        out_dict.append(indices_list)
+        # 打印结果
+        print("rank10 idx:", indices_list[-10:][::-1])
+        print("rank10 value:", values_list[-10:][::-1])
+
+    l1 = out_dict[0][-10:]
+    l2 = out_dict[1][-10:]
+    diff_list = []
+    for value in l1:
+        if value not in l2:
+            diff_list.append(value)
+    print(len(diff_list))
+    if len(diff_list) <= 1:
+        print("NPU GPU eager precise OK")
+
+    t1_abs = torch.abs(torch.tensor(input_tensor[0]))
+    t2_abs = torch.abs(torch.tensor(input_tensor[1]))
+
+    absolute_errors = torch.abs(t1_abs - t2_abs)
+    relative_errors = absolute_errors / torch.abs(t1_abs)
+    average_error = torch.mean(relative_errors)  # 计算平均相对误差
+
+    print("gpu和npuTop10结果 平均绝对误差是", absolute_errors.sum()/10)
+
+
+

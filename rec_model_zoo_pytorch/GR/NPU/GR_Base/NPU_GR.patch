@@ -0,0 +1,77 @@
+rm -rf /tmp/torchinductor_*
+
+#开启编译
+export USE_COMPILE=0
+
+#开启ACLgraph
+export USE_GRAPH=1
+
+# 运行轮数(运行多少轮采集性能数据)
+export RUN_NUM=10
+
+#是否开启端到端时间统计
+export USE_E2E=1
+
+#是否采集profiling
+export USE_PROFILING=1
+
+#是否加载NPU输入,维持和GPU输入一致
+export USE_GPU_INPUT=0
+
+#是否保存输入和输出tensor, 和GPU对比精度
+export SAVE_INPUT_AND_PUTPUT=0
+
+# 模型路径
+export MODEL_PATH=
+
+#库路径
+export LIB_FBGEMM_NPU_API_SO_PATH=/usr/local/python3.11.13/lib/python3.11/site-packages/libfbgemm_npu_api.so
+
+# prof路径
+export PROF_SAVE_PATH="prof_result_2k"
+
+#batchsize 可选值 1 2 4
+export BATCH_SIZE=1
+
+# 精度验证模式
+export PERCISE_VALIDATE=0
+
+# Inductor性能
+export INDUCTOR_ASCEND_AGGRESSIVE_AUTOTUNE=1
+export TORCHINDUCTOR_PROFILE_WITH_DO_BENCH_USING_PROFILING=1
+export INDUCTOR_TINY_KERNEL=1
+export TORCHNPU_PRECOMPILE_THREADS=20
+
+#执行
+LOG_SUFFIX="$(date '+%Y%m%d_%H%M%S')_2k_compile${USE_COMPILE}_aclgraph${ENABLE_ACLGRAPH}_precise${GR_VLLM_PRECISE}_e2e${GR_VLLM_E2E}"
+
+# 根据USE_COMPILE的值决定执行次数
+if [ "$PERCISE_VALIDATE" -eq 1 ]; then
+    export USE_PROFILING=0
+    export USE_COMPILE=0
+    TRITON_DISABLE_FFTS=1 python3  benchmark/inference_benchmark_2b_random.py 2>&1 | tee temp_${LOG_SUFFIX}_warmup.log
+    
+    if [ $? -eq 0 ]; then
+        export USE_COMPILE=1
+        TRITON_DISABLE_FFTS=1 python3  benchmark/inference_benchmark_2b_random.py 2>&1 | tee temp_${LOG_SUFFIX}_profiling.log
+        if [ $? -eq 0 ]; then
+            python rank.py 2>&1 | tee temp_${LOG_SUFFIX}_percise.log
+        fi
+    fi
+elif [ "$USE_COMPILE" -eq 0 ]; then
+    # 如果USE_COMPILE为0，只执行一次（使用性能分析模式）
+    TRITON_DISABLE_FFTS=1 python3  benchmark/inference_benchmark_2b_random.py 2>&1 | tee temp_${LOG_SUFFIX}.log
+else
+    # 如果USE_COMPILE不为0，执行两次（先不分析，后分析）
+    if [ "$USE_PROFILING" -eq 0 ]; then
+        TRITON_DISABLE_FFTS=1 python3  benchmark/inference_benchmark_2b_random.py 2>&1 | tee temp_${LOG_SUFFIX}_onlywarmup.log
+    else
+        export USE_PROFILING=0
+        TRITON_DISABLE_FFTS=1 python3  benchmark/inference_benchmark_2b_random.py 2>&1 | tee temp_${LOG_SUFFIX}_warmup.log
+        
+        if [ $? -eq 0 ]; then
+            export USE_PROFILING=1
+            TRITON_DISABLE_FFTS=1 python3  benchmark/inference_benchmark_2b_random.py 2>&1 | tee temp_${LOG_SUFFIX}_profiling.log
+        fi
+    fi
+fi

+class RelativeBucketedTimeAndPositionBasedBias(torch.nn.Module):
+    """
+    Bucketizes timespans based on ts(next-item) - ts(current-item).
+    """
+
+    def __init__(
+        self,
+        max_seq_len: int,
+        num_buckets: int,
+        device,
+        dtype,
+        bucketization_fn: Callable[[torch.Tensor], torch.Tensor] = None,
+    ) -> None:
+        super().__init__()
+
+        self._max_seq_len: int = max_seq_len
+        self._ts_w = torch.nn.Parameter(
+            torch.empty(num_buckets + 1,device=device, dtype=dtype).normal_(mean=0, std=0.02),)
+        self._pos_w = torch.nn.Parameter(
+            torch.empty(2 * max_seq_len - 1, device=device, dtype=dtype).normal_(mean=0, std=0.02),)
+        self._num_buckets: int = num_buckets
+        self._bucketization_fn = bucketization_fn if bucketization_fn is not None else lambda x: (torch.log(
+            torch.abs(x).clamp(min=1.0)) / 0.301 / 1.).clamp(min=0).long()
+
+
+        # 构建位置偏置矩阵
+        # 对位置权重进行填充和重复以构建相对位置偏置
+        position_weights_padded = F.pad(self._pos_w[:2 * max_seq_len - 1], [0, max_seq_len])  # [2*N-1 + N]
+        position_weights_tiled = position_weights_padded.repeat(max_seq_len)  # [N*(2*N-1+N)]
+        position_weights_trimmed = position_weights_tiled[..., :-max_seq_len]  # [N*(2*N-1+N)-N]
+        self.position_bias_matrix = position_weights_trimmed.reshape(1, max_seq_len, 3 * max_seq_len - 2)  # [1, N, 3*N-2]
+
+    def load_parm_post_init(self):  # 在模型加载，参数随机初始化后，_pos_w会改变，需要重新加载一次
+        position_weights_padded = F.pad(self._pos_w[:2 * self._max_seq_len - 1], [0, self._max_seq_len])  # [2*N-1 + N]
+        position_weights_tiled = position_weights_padded.repeat(self._max_seq_len)  # [N*(2*N-1+N)]
+        position_weights_trimmed = position_weights_tiled[..., :-self._max_seq_len]  # [N*(2*N-1+N)-N]
+        self.position_bias_matrix = position_weights_trimmed.reshape(1, self._max_seq_len,
+                                                                     3 * self._max_seq_len - 2)  # [1, N, 3*N-2]
+
+    def compute_relative_bucketed_time_and_position_bias(
+        self,
+        all_timestamps: torch.Tensor,
+        target_item_lengths: torch.Tensor,
+        history_lengths: torch.Tensor,
+        ts_w: torch.Tensor,
+        pos_w: torch.Tensor,
+        max_seq_len: int,
+        num_buckets: int,
+        bucketization_fn: Callable[[torch.Tensor], torch.Tensor],
+    ) -> torch.Tensor:
+        """
+        计算相对位置和时间的注意力偏置
+
+        Args:
+            all_timestamps: 时间戳张量 (batch_size, max_seq_len)
+            target_item_lengths: 目标项长度 (batch_size,)
+            history_lengths: 历史长度 (batch_size,)
+            ts_w: 时间权重张量 (num_buckets + 1,)
+            pos_w: 位置权重张量 (2 * max_seq_len - 1,)
+            max_seq_len: 最大序列长度
+            num_buckets: 时间桶数量
+            bucketization_fn: 桶化函数
+
+        Returns:
+            torch.Tensor: 相对注意力偏置矩阵 (batch_size, max_seq_len, max_seq_len)
+        """
+        batch_size = all_timestamps.size(0)
+
+
+
+        # 计算相对位置偏置的中心索引
+
+        # 使用原始时间戳（不需要扩展）
+        timestamps = all_timestamps
+        # 计算时间差并进行桶化（离散化）
+        # 使用因果掩码：计算每对位置之间的时间差
+        time_diff_matrix = timestamps.unsqueeze(2) - timestamps.unsqueeze(1)
+        bucketed_timestamps = torch.clamp(
+            bucketization_fn(time_diff_matrix),
+            min=0,
+            max=num_buckets,
+        ).detach()
+
+        # 提取相对位置偏置
+        center_index = (2 * max_seq_len - 1) // 2
+        if batch_size > 1:
+            relative_position_bias = self.position_bias_matrix.repeat(batch_size, 1, 1)[:, :, center_index:-center_index]  # [B, N, 3*N-2]
+        else:
+            relative_position_bias = self.position_bias_matrix[:, :,center_index:-center_index]  # [B, N, 3*N-2]
+
+
+        # 处理多目标场景：确保目标项具有相同的位置偏置
+        for batch_idx in range(batch_size):
+            target_length = target_item_lengths[batch_idx]
+            history_length = history_lengths[batch_idx]
+            # 获取当前批次的位置偏置矩阵
+            current_pos_bias = relative_position_bias[batch_idx]  # [max_seq_len, max_seq_len]
+
+            # 边赋值
+            current_pos_bias[history_length+1 : history_length+target_length, :] = \
+                current_pos_bias[history_length:history_length+1, :].repeat(target_length-1, 1)
+
+            #对角线赋值（核心：掩码*目标值 + 原矩阵*(1-掩码)，仅替换对角线） 不能用arrange, arrange不能入图..
+            sub_matrix = current_pos_bias[history_length:history_length + target_length, history_length:history_length + target_length]
+            diag_value = current_pos_bias[history_length, history_length]
+            identity_mask = torch.eye(target_length, dtype=sub_matrix.dtype, device=sub_matrix.device)
+            sub_matrix = sub_matrix * (1 - identity_mask) + diag_value * identity_mask
+
+
+            relative_position_bias[batch_idx] = current_pos_bias
+
+        # 计算时间偏置
+        relative_time_bias = torch.index_select(ts_w, dim=0, index=bucketed_timestamps.view(-1)).view(
+            batch_size, max_seq_len, max_seq_len)
+
+        # 返回位置偏置和时间偏置的和
+        # print("torch time_bias", relative_time_bias)
+        # return relative_time_bias
+        # print("torch relative_position_bias:", relative_position_bias)
+        # return relative_position_bias
+        return relative_position_bias + relative_time_bias
+
+    def forward(
+        self,
+        all_timestamps: torch.Tensor,
+        target_item_lengths: torch.Tensor,
+        history_lengths: torch.Tensor,
+    ) -> torch.Tensor:
+        """
+        计算相对位置和时间的注意力偏置
+
+        Args:
+            all_timestamps: 时间戳张量 (batch_size, max_seq_len)
+            target_item_lengths: 目标项长度 (batch_size,)
+            history_lengths: 历史长度 (batch_size,)
+
+        Returns:
+            torch.Tensor: 相对注意力偏置矩阵 (batch_size, max_seq_len, max_seq_len)
+        """
+        return self.compute_relative_bucketed_time_and_position_bias(
+            all_timestamps=all_timestamps,
+            target_item_lengths=target_item_lengths,
+            history_lengths=history_lengths,
+            ts_w=self._ts_w,
+            pos_w=self._pos_w,
+            max_seq_len=self._max_seq_len,
+            num_buckets=self._num_buckets,
+            bucketization_fn=self._bucketization_fn,
+        )
+
 

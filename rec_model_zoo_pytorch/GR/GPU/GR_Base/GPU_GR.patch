+# See the License for the specific language governing permissions and
+# limitations under the License.
+import datetime
+import json
+import os
+import random
+import sys
+import time
+
+import numpy as np
+import pandas as pd
+import math
+
+current_working_dir = os.getcwd()
+sys.path.insert(0, current_working_dir)
+
+import torch
+
+from configs import (
+    InferenceEmbeddingConfig,
+    RankingConfig,
+    get_inference_hstu_config,
+)
+from dataset.random_inference_dataset import RandomInferenceDataGenerator
+from dataset.utils import FeatureConfig
+from torch.profiler import ProfilerActivity
+
+sys.path.append("./model/")
+from inference_ranking_gr import InferenceRankingGR
+from out_compare import compare_npu_and_gpu_out
+
+run_num = int(os.getenv("RUN_NUM"))
+use_compile = int(os.getenv("USE_COMPILE")) == 1
+use_cudaGraph = int(os.getenv("USR_CUDA_GRAPH")) == 1
+dataset_path = os.getenv("DATASET_PATH")
+model_path = os.getenv("MODEL_PATH")
+folder_name = os.getenv("PROF_SAVE_PATH")
+is_save_input_and_output = int(os.getenv("SAVE_INPUT_AND_PUTPUT")) == 1
+is_use_npu_input = int(os.getenv("USE_NPU_INPUT")) == 1
+batch_size = int(os.getenv("BATCH_SIZE", "1"))
+
+
+def run_ranking_gr_inference():
+    max_batch_size = batch_size
+    max_seqlen = 2048
+    max_num_candidates = 100
+    max_incremental_seqlen = (max_seqlen - max_num_candidates) // 2
+
+    # context_emb_size = 1000
+    item_fea_name, item_vocab_size = "video_id", 1000000
+    action_fea_name, action_vocab_size = "action_weights", 512
+    feature_configs = [
+        FeatureConfig(
+            feature_names=[item_fea_name, action_fea_name],
+            max_item_ids=[item_vocab_size - 1, action_vocab_size - 1],
+            max_sequence_length=max_seqlen,
+            is_jagged=False,
+        ),
+    ]
+    max_contextual_seqlen = 0
+    total_max_seqlen = sum(
+        [fc.max_sequence_length * len(fc.feature_names) for fc in feature_configs]
+    )
+
+    hidden_dim_size = 4096
+    num_heads = 16
+    head_dim = 256
+    num_layers = 24
+    inference_dtype = torch.bfloat16
+    hstu_cudagraph_configs = {
+        "batch_size": [2**i for i in range(math.ceil(math.log2(max_batch_size)) + 1)],
+        "length_per_sequence": [i * 256 for i in range(8, 9)],
+    }
+
+
+    hstu_config = get_inference_hstu_config(
+        hidden_size=hidden_dim_size,
+        num_layers=num_layers,
+        num_attention_heads=num_heads,
+        head_dim=head_dim,
+        dtype=inference_dtype,
+        max_seq_len=total_max_seqlen,
+        max_batch_size=max_batch_size,
+    )
+
+    emb_configs = [
+        InferenceEmbeddingConfig(
+            feature_names=["action_weights"],
+            table_name="act",
+            vocab_size=action_vocab_size,
+            dim=hidden_dim_size,
+            use_dynamicemb=False,
+        ),
+        InferenceEmbeddingConfig(
+            feature_names=["video_id"],
+            table_name="item",
+            vocab_size=item_vocab_size,
+            dim=hidden_dim_size,
+            use_dynamicemb=False,
+        ),
+    ]
+    num_tasks = 3
+    task_config = RankingConfig(
+        embedding_configs=emb_configs,
+        prediction_head_arch=[[128, 10, 1] for _ in range(num_tasks)],
+    )
+
+    with torch.inference_mode():
+
+        model_predict = InferenceRankingGR(
+            hstu_config=hstu_config,
+            task_config=task_config,
+            use_cudagraph=use_cudaGraph,
+            cudagraph_configs=hstu_cudagraph_configs,
+        )
+
+        cpu_state_dict = torch.load(model_path, map_location='cpu')
+        model_predict.load_state_dict(cpu_state_dict)
+        model_predict.to(torch.cuda.current_device())
+
+        total_params = sum(param.numel() for name, param in model_predict.named_parameters()
+                           if not name.startswith("_embedding_collection"))
+        for name, param in model_predict.named_parameters():
+            print(f"{name}: 形状={param.shape}, 参数数量={param.numel()} type = {param.dtype}")
+        print("====== 模型参数(不包含embdding) is  ", total_params, "  STRUCT IS ======", model_predict)
+
+        model_predict.bfloat16()
+        model_predict.eval()
+
+        data_generator = RandomInferenceDataGenerator(
+            feature_configs=feature_configs,
+            item_feature_name=item_fea_name,
+            contextual_feature_names=[],
+            action_feature_name=action_fea_name,
+            max_num_users=16,
+            max_batch_size=max_batch_size,  # test batch size
+            max_seqlen=max_seqlen,
+            max_num_candidates=max_num_candidates,
+            max_incremental_seqlen=max_incremental_seqlen,
+            full_mode=True,
+        )
+
+        print("动态bs测试开始")
+        for bs in range(1,max_batch_size+1):
+            uids = torch.tensor([bs*10 for i in range(bs)], dtype=torch.int64)
+            batch = data_generator.get_random_inference_batch(uids, torch.tensor([-1] * bs, dtype=torch.int32))
+            print("[model input shape is]", batch.features.values().shape)
+            result = model_predict.forward(batch, uids)
+
+        print("预热开始！")
+        num_warmup_batches = 1
+        infer_list = []
+        for idx in range(num_warmup_batches):
+            uids = torch.tensor([idx for idx in range(max_batch_size)], dtype=torch.int64)
+            batch = data_generator.get_random_inference_batch(uids, torch.tensor([-1] * max_batch_size, dtype=torch.int32))
+
+            if is_save_input_and_output:
+                torch.save(batch.features, "input_output/gpu_input.pt")
+            if is_use_npu_input:
+                batch.features = torch.load("input_output/gpu_input.pt", weights_only=False)
+
+            print("[model input shape is]", batch.features.values().shape)
+            infer_list.append((batch, uids))
+
+        for item in infer_list * run_num:
+            result = model_predict.forward(item[0], item[1])
+            # print([model output is],result)
+            if is_save_input_and_output:
+                torch.save(result.cpu(), "input_output/gpu_output.pt")
+
+        print("性能分析开始！")
+        time_arr = []
+        with torch.profiler.profile(
+                activities=[ProfilerActivity.CUDA, ProfilerActivity.CPU],  # 同时分析 CPU 和 CUDA
+                record_shapes=True,  # 记录张量形状
+        ) as prof:
+            with torch.no_grad():
+                for item in infer_list * run_num:
+                    torch.cuda.synchronize()
+                    start_time = time.perf_counter()
+                    model_predict.forward(item[0], item[1])  # 推理
+                    torch.cuda.synchronize()
+                    duration = (time.perf_counter() - start_time) * 1_000_000
+                    time_arr.append(duration)
+                    print(f"[E2E] time: {duration:.2f} us")
+
+        print("收集端到端时间")
+        report = {'Batch_size': max_batch_size,
+                  'model_name': "GR"}
+
+        time_arr.sort()
+        tail_latency = round(time_arr[int(len(time_arr) * 0.99)] / 1000, 6)
+        p90_latency = round(time_arr[int(len(time_arr) * 0.90)] / 1000, 6)
+        avg_latency = round(sum(time_arr) / len(time_arr) / 1000, 6)
+        qps = int(1000.0 * max_batch_size / avg_latency)
+
+        report["QPS"] = qps
+        report["AVG Latency"] = avg_latency
+        report["P99 Latency"] = tail_latency
+        report["P90 Latency"] = p90_latency
+        print(report)
+        time_str = datetime.datetime.now().strftime("%Y%m%d_%H%M%S_%f")
+
+        if not os.path.exists(folder_name):
+            os.makedirs(folder_name)
+
+        with open(os.path.join(folder_name, f'report_bs{max_batch_size}.json'), "w", encoding="utf-8") as f:
+            json.dump(
+                report,
+                f,
+                ensure_ascii=False,  # 保留非ASCII字符（如中文）
+                indent=4  # 格式化输出，缩进4个空格，增强可读性
+            )
+
+        print("性能分析完成！")
+        print("-" * 30)
+
+        print(prof.key_averages())
+        output_trace_path = os.path.join(folder_name, f'{time_str}_trace.json')
+        prof.export_chrome_trace(output_trace_path)
+
+        # 3. 获取聚合后的性能数据
+        # key_averages() 会按操作名分组聚合事件
+        key_averages_events = prof.key_averages()
+        if key_averages_events:
+            print("可用的 Event 属性列表:")
+            print(dir(key_averages_events[0]))
+
+        # 4. 将 profiler 结果转换为 Pandas DataFrame
+        # 每个事件都有如 name, cpu_time_total, cuda_time_total 等属性
+        # 我们可以用 map(vars, ...) 快速地将每个事件对象转换为字典
+        profiler_data = []
+        for event in key_averages_events:
+            profiler_data.append({
+                'Name': event.key,
+                'CPU Time Total (us)': event.cpu_time_total,
+                'CUDA Time Total (us)': event.device_time_total,  # <-- 修正
+                'CPU Time Self (us)': event.self_cpu_time_total,
+                'CUDA Time Self (us)': event.self_device_time_total,  # <-- 修正
+                'CPU Memory Self (B)': event.self_cpu_memory_usage,
+                'CUDA Memory Self (B)': event.self_device_memory_usage,  # <-- 修正
+                'Number of Calls': event.count,
+            })
+
+        df = pd.DataFrame(profiler_data)
+
+        # 5. (可选) 对数据进行排序，方便分析
+        # 按 CUDA 总时间降序排列
+        df_sorted = df.sort_values(by='CUDA Time Total (us)', ascending=False)
+
+        # 6. 导出到 Excel 文件
+
+        output_excel_path = os.path.join(folder_name, f'{time_str}_profiler_results.xlsx')
+        df_sorted.to_excel(output_excel_path, index=False)
+
+        print(f"Profiler results have been exported to {output_excel_path}")
+
+
+if __name__ == "__main__":
+    torch.manual_seed(42)
+    random.seed(42)
+    np.random.seed(42)
+    run_ranking_gr_inference()
+    compare_npu_and_gpu_out()  # 比较npu gpu输出

+        input_ids,
+        positions,
+        is_dummy = False,
+    ):
+        def deal_slots(slot_mapping, batch_lens, seq_lens):
+            
+            start_idx = 0
+            dealed_slot_mapping = []
+            for idx in range(seq_lens.shape[0]):
+                dealed_slot_mapping.append(slot_mapping[start_idx : start_idx + batch_lens[idx]])
+                start_idx = seq_lens[idx]
+
+            return torch.cat(dealed_slot_mapping, dim=0)
+
+        if attn_metadata is not None:
+            logger.info("Start to deal_metadata")
+            first_metadata = next(iter(attn_metadata.values()))
+            is_prefill = (not input_ids[1] == -1) if not is_dummy else True
+            # uid = input_ids[0].item()
+            uids = []
+            input_ids_list = []
+            if (not is_dummy) and first_metadata.attn_state == AscendAttentionState.ChunkedPrefill:
+                    num_reqs = self.input_batch.num_reqs
+                    first_metadata.query_lens = first_metadata.query_lens[:num_reqs]
+                    first_metadata.query_lens_list = first_metadata.query_lens_list[:num_reqs]
+                    first_metadata.seq_lens = first_metadata.seq_lens[:num_reqs]
+                    first_metadata.seq_lens_list = first_metadata.seq_lens_list[:num_reqs]
+                    first_metadata.slot_mapping = first_metadata.slot_mapping[:first_metadata.num_actual_tokens]
+                    first_metadata.slot_indices = first_metadata.slot_indices[:first_metadata.num_actual_tokens]
+            batch_size = first_metadata.query_lens.shape[0]
+            query_start_loc = torch.zeros(batch_size + 1, dtype=torch.int64, device=first_metadata.query_lens.device)
+            torch.cumsum(first_metadata.query_lens, dim=0, out=query_start_loc[1:])
+            query_start_list = query_start_loc.tolist()
+            is_pd_merge = False
+            
+            if not is_dummy:
+                input_ids = input_ids[: first_metadata.num_actual_tokens]
+                num_candidates_list = []
+                sep_positions = torch.where(input_ids == -1)[0].tolist()
+                for idx in range(len(query_start_list) - 1):
+                    start_idx = query_start_list[idx]
+                    end_idx = query_start_list[idx + 1]
+                    uids.append(input_ids[start_idx].item())
+                    slice_1 = input_ids[start_idx + 1 : sep_positions[idx]]
+                    slice_2 = input_ids[sep_positions[idx] + 1 : end_idx]
+                    input_ids_list.extend([slice_1, slice_2])
+                    candidate_num = end_idx - sep_positions[idx] - 1
+                    num_candidates_list.append(candidate_num)
+                    is_pd_merge = candidate_num > 0
+                input_ids = torch.cat(input_ids_list, dim=0)
+            else:
+                num_candidates_list = [0 for _ in range(first_metadata.query_lens.shape[0])]
+
+            positions = positions[:input_ids.shape[0]]
+            batch_lens = (first_metadata.query_lens - 2) if not is_dummy else first_metadata.query_lens     # CPU上
+            batch_lens_list = batch_lens.tolist()
+            max_query_len = max(batch_lens_list)
+            sum_tokens = sum(batch_lens_list)
+            batch_lens = batch_lens.npu()
+            
+            seq_lens = first_metadata.seq_lens.npu()        # 如果是decode的话，seq_lens应当是batch_lens + prec_his_len
+            if is_dummy:
+                seq_lens = seq_lens - 1
+            
+            query_start_loc = query_start_loc.npu()
+            torch.cumsum(batch_lens, dim=0, out=query_start_loc[1:])
+
+            if not is_prefill:
+                block_table = first_metadata.block_tables
+                deal_seq_lens = seq_lens - batch_lens
+                num_blocks_per_seq = torch.ceil(deal_seq_lens / self.block_size).to(torch.int64) # 向上取整
+
+                # page_offsets 就是 num_blocks_per_seq 的前缀和
+                page_offsets = torch.zeros(batch_size + 1, dtype=torch.int64, device=block_table.device)
+                torch.cumsum(num_blocks_per_seq, dim=0, out=page_offsets[1:])
+
+                last_page_len_tensor = (deal_seq_lens - 1) % self.block_size + 1
+
+                seq_offset_k = torch.zeros(seq_lens.shape[0] + 1, dtype=torch.int64, device=block_table.device)
+                torch.cumsum(seq_lens, dim=0, out=seq_offset_k[1:]) # 计算出每个请求的前缀和
+
+                max_seq_len_k = max(first_metadata.seq_lens_list) - 1 if is_dummy else max(first_metadata.seq_lens_list)
+
+                current_block_tables = block_table[:batch_size]
+
+                page_ids_list = []
+                for i in range(batch_size):
+                    num_blocks_for_req = page_offsets[i + 1] - page_offsets[i]
+                    valid_blocks = current_block_tables[i, :num_blocks_for_req]
+                    page_ids_list.append(valid_blocks)
+
+                page_ids = torch.cat(page_ids_list).to(torch.int64)
+            else:
+                num_candidates = torch.tensor(num_candidates_list, dtype=torch.int64, device=first_metadata.slot_mapping.device)
+
+            first_metadata.query_lens = batch_lens
+            first_metadata.query_lens_list = batch_lens_list
+            first_metadata.seq_lens = batch_lens
+            first_metadata.seq_lens_list = batch_lens_list
+            first_metadata.max_query_len = max_query_len
+            first_metadata.num_actual_tokens = sum_tokens
+            first_metadata.additional_metadata = {}
+            # first_metadata.additional_metadata["uid"] = uid
+            first_metadata.additional_metadata["uids"] = uids
+            first_metadata.additional_metadata["query_start"] = query_start_loc
+            if not is_prefill:
+                first_metadata.attn_state = AscendAttentionState.DecodeOnly
+                first_metadata.slot_indices = deal_slots(first_metadata.slot_indices, batch_lens, seq_lens)
+                first_metadata.additional_metadata["max_seq_len_k"] = max_seq_len_k
+                first_metadata.additional_metadata["seq_offset_k"] = seq_offset_k
+                first_metadata.additional_metadata["seq_offset_t"] = query_start_loc
+                first_metadata.additional_metadata["page_offsets"] = page_offsets
+                first_metadata.additional_metadata["page_ids"] = page_ids
+                first_metadata.additional_metadata["last_page_len"] = last_page_len_tensor
+                first_metadata.additional_metadata["decode_table_offset"] = block_table[0][0].item()
+            else:
+                first_metadata.attn_state = AscendAttentionState.PrefillNoCache
+                first_metadata.slot_mapping = deal_slots(first_metadata.slot_mapping, batch_lens, seq_lens)
+                first_metadata.additional_metadata["num_candidates"] = num_candidates
+                first_metadata.additional_metadata["is_pd_merge"] = is_pd_merge
+            
+        return attn_metadata, input_ids, positions
+

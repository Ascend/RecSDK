+    "PYTORCH_NPU_ALLOC_CONF": "expandable_segments:True",       # 内存分配配置，单进程多卡
+    "HCCL_INTRA_ROCE_ENABLE": "1",      # 使用PCIe环路进行多卡通信
+})
+

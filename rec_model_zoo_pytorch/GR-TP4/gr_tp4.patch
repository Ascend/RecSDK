+class PagedHSTUInferLayer(torch.nn.Module):
+    def __init__(
+        self,
+        vllm_config: VllmConfig,
+        config: InferenceHSTUConfig,
+        layer_idx: int,
+    ):
+        super().__init__()
+        self.layer_idx = layer_idx
+        self._embedding_dim: int = config.hidden_size
+        # per head dim;
+        self._linear_dim_per_head: int = config.head_dim
+        self._attention_dim_per_head: int = config.head_dim
+
+        self._num_heads: int = config.num_heads
+
+        # 获取张量并行配置
+        self.tp_size = get_tensor_model_parallel_world_size()
+        self.tp_rank = get_tensor_model_parallel_rank()
+        self._num_heads_per_partition = self._num_heads // self.tp_size
+
+        self._eps = config.layernorm_epsilon
+        self._is_causal = config.is_causal
+        self._target_group_size = config.target_group_size
+        self._alpha = 1.0 / (self._attention_dim_per_head ** 0.5)
+        self._residual = config.residual
+
+        dtype = (
+            torch.bfloat16
+            if config.bf16
+            else torch.float16
+            if config.fp16
+            else torch.float32
+        )
+        device = torch_npu.npu.current_device()
+
+        self.self_attn = HstuAttention(
+            vllm_config=vllm_config,
+            config=config,
+            layer_idx=layer_idx
+        )
+
+        # output norm
+        self._output_layernorm_weight = torch.nn.Parameter(
+            torch.ones(
+                self._num_heads_per_partition * self.tp_size * self._linear_dim_per_head, dtype=dtype, device=device
+            ),
+            requires_grad=False,
+        )
+        self._output_layernorm_bias = torch.nn.Parameter(
+            torch.zeros(
+                self._num_heads_per_partition * self.tp_size * self._linear_dim_per_head, dtype=dtype, device=device
+            ),
+            requires_grad=False,
+        )
+
+        self._linear_proj = RowParallelFlashCommLinear(
+            input_size=self._linear_dim_per_head * config.num_heads,
+            output_size=self._embedding_dim,
+            tp_size=self.tp_size,
+            tp_rank=self.tp_rank,
+            bias=False,
+            skip_bias_add=False,
+            params_dtype=dtype,
+            quant_config=None,
+            prefix=f"model.layers.{layer_idx}.linear_proj",
+        )
+
+        for param in self._linear_proj.parameters():
+            param.requires_grad = False
+            param.copy_(torch.randn_like(param))
+
+        # ffn
+        self.has_ffn = config.has_ffn
+        if config.has_ffn:
+            self.norm_ffn = RMSNorm_npu(self._embedding_dim, self._eps)
+            self.feed_forward = FFN_npu_swiglu(
+                dim=self._embedding_dim,
+                hidden_dim=self._embedding_dim,
+                dropout=config.dropout_ratio,
+            )
+        self.use_moe = int(os.getenv("USE_MOE")) == 1
+        self.rank_local = get_tensor_model_parallel_rank()
+        if self.use_moe:
+            self.sparse_moe_linear = SparseMOE(
+                emb_dim=self._embedding_dim,
+                expert_number=int(os.getenv("MOE_EXPERT_TOTAL_NUM")),
+                top_k=int(os.getenv("MOE_EXPERT_ACT_NUM")),
+                tp_size = self.tp_size,
+                rank_local = self.rank_local,
+                dtype=dtype
+            )
+
+        max_num_tokens = vllm_config.scheduler_config.max_num_batched_tokens
+        self._input_buffer_ = torch.zeros(
+            max_num_tokens, self._num_heads * self._linear_dim_per_head,
+            dtype=dtype,
+            device=device,
+            requires_grad=False,
+        )
+
+        self._moe_input_buffer_ = torch.zeros(
+            max_num_tokens, self._num_heads * self._linear_dim_per_head,
+            dtype=dtype,
+            device=device,
+            requires_grad=False,
+        )
+
+        self._moe_input_buffer_ = torch.zeros(
+            max_num_tokens, self._num_heads * self._linear_dim_per_head,
+            dtype=dtype,
+            device=device,
+            requires_grad=False,
+        )
+
+        self._moe_output_buffer_ = torch.zeros(
+            max_num_tokens, self._num_heads * self._linear_dim_per_head,
+            dtype=dtype,
+            device=device,
+            requires_grad=False,
+        )
+
+        self._output_buffer_ = torch.zeros(
+            max_num_tokens, self._num_heads * self._linear_dim_per_head,
+            dtype=dtype,
+            device=device,
+            requires_grad=False,
+        )
+    
+    @torch.inference_mode()
+    def forward_input(
+        self,
+        num_tokens: int,
+        input_buffer: torch.Tensor,
+        position: torch.Tensor,
+    ) -> torch.Tensor:
+        layer_input = input_buffer[:num_tokens]
+        attn_output, user = self.self_attn(layer_input, position)
+
+        attn_output = attn_output.view(
+            -1, self._num_heads_per_partition * self._linear_dim_per_head
+        )
+
+        if self.tp_size > 1:
+            attn_output = tensor_model_parallel_all_gather(attn_output)
+        offset = self._linear_dim_per_head * self._num_heads_per_partition
+
+        parallel_input = user * F.layer_norm(
+            attn_output,
+            normalized_shape=[self._num_heads * self._linear_dim_per_head],
+            weight=self._output_layernorm_weight,
+            bias=self._output_layernorm_bias,
+            eps=self._eps,
+        )[:, self.rank_local * offset : (self.rank_local + 1) * offset]
+
+        layer_output, _  = self._linear_proj(parallel_input)
+        self._output_buffer_[:num_tokens] = layer_output
+        return self._output_buffer_[:num_tokens]
+
+    @torch.inference_mode()
+    def forward_moe(
+        self,
+        num_tokens: int,
+    ):
+        layer_output = self._moe_input_buffer_[:num_tokens]
+        if self.use_moe:
+            layer_output = self.sparse_moe_linear(layer_output)
+        self._moe_output_buffer_[:num_tokens] = layer_output
+
+    @torch.inference_mode()
+    def forward_output(
+        self,
+        num_tokens: int,
+        input_buffer: torch.Tensor
+    ):
+        layer_output = input_buffer[:num_tokens]
+        layer_input = self._input_buffer_[:num_tokens]
+        if self.has_ffn:
+            ffn_input, _ = self.norm_ffn(layer_output, layer_input if self._residual else None)
+            layer_output = self.feed_forward(ffn_input) + layer_output
+        else:
+            if self._residual:
+                torch.add(layer_output, layer_input, out=layer_output)
+        self._output_buffer_[:num_tokens] = layer_output
+        return self._output_buffer_[:num_tokens]
+    @torch.inference_mode()
+    def forward(
+        self,
+        layer_input: torch.Tensor,
+        position: torch.Tensor,
+    ) -> torch.Tensor:
+        attn_output, user = self.self_attn(layer_input, position)
+
+        attn_output = attn_output.view(
+            -1, self._num_heads_per_partition * self._linear_dim_per_head
+        )
+
+        if self.tp_size > 1:
+            attn_output = tensor_model_parallel_all_gather(attn_output)
+        offset = self._linear_dim_per_head * self._num_heads_per_partition
+
+        parallel_input = user * F.layer_norm(
+            attn_output,
+            normalized_shape=[self._num_heads * self._linear_dim_per_head],
+            weight=self._output_layernorm_weight,
+            bias=self._output_layernorm_bias,
+            eps=self._eps,
+        )[:, self.rank_local * offset : (self.rank_local + 1) * offset]
+
+        layer_output, _  = self._linear_proj(parallel_input)
+        if self.use_moe:
+            layer_output = self.sparse_moe_linear(layer_output)
+
+        if self.has_ffn:
+            ffn_input, _ = self.norm_ffn(layer_output, layer_input if self._residual else None)
+            layer_output = self.feed_forward(ffn_input) + layer_output
+        else:
+            if self._residual:
+                torch.add(layer_output, layer_input, out=layer_output)
+        print("layerout",layer_output.dtype,layer_output.shape)
+        return layer_output

+
+def _eval_single_card(
+    model: torch.nn.Module,
+    test_dataloader: DataLoader,
+    device: torch.device,
+    limit_batches: Optional[int],
+    stage: str,
+    rank: int,
+) -> float:
+    """
+    仅走 eval 分支：不创建 pipeline，从 dataloader 取 batch 直接调用 model.forward。
+    参考 _evaluate / train_val_test 的评估逻辑。
+    """
+    model.eval()
+    auroc = metrics.AUROC("binary")
+    iterator = itertools.islice(iter(test_dataloader), limit_batches)
+    is_rank_zero = dist.get_rank() == 0
+    if is_rank_zero:
+        pbar = tqdm(
+            iter(int, 1),
+            desc=f"Evaluating {stage} set (single-card)",
+            total=limit_batches or len(test_dataloader),
+            disable=False,
+        )
+    with torch.no_grad():
+        for batch in iterator:
+            batch = batch.to(device=device, non_blocking=True)
+            logits = model(batch.dense_features, batch.sparse_features)
+            preds = torch.sigmoid(logits)
+            # print("preds: ", preds, "labels: ", batch.labels)
+            auroc(preds.detach().cpu(), batch.labels.detach().cpu())
+            if is_rank_zero:
+                pbar.update(1)
+    auroc_result = auroc.compute().item()
+    num_samples = torch.tensor(sum(map(len, auroc.target)), device=device)
+    if is_rank_zero:
+        logging.info("AUROC over %s set (single-card): %s.", stage, auroc_result)
+        logging.info("Number of %s samples: %s.", stage, num_samples)
+    return auroc_result
+
+

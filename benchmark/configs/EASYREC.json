{
    "name": "EasyRec",
    "url": "https://github.com/HKUDS/EasyRec.git",
    "commit_id": "81e818b767689046c89edf5669dfbf64598db221",
    "patch_path": "patches/easyrec_npu.patch",
    "mode": "train",
    "epoch": 100,
    "profiling_flag": false,
    "e2e_flag": true,
    "aclgraph_flag": false,
    "data_type": "bfloat16",
    "run_cmd": ["bash", "benchmark_entry.sh", "--device=npu"],
    "pip_install_self": false,
    "pip_install_requirements": false,
    "extra_cmd": [
        "python -m pip install transformers==4.40.0 accelerate==0.28.0 sentencepiece==0.2.0 scipy tqdm protobuf",
        "mkdir -p baseline_embedders/easyrec-roberta-small",
        "wget -O baseline_embedders/easyrec-roberta-small/config.json https://huggingface.co/hkuds/easyrec-roberta-small/resolve/main/config.json",
        "wget -O baseline_embedders/easyrec-roberta-small/merges.txt https://huggingface.co/hkuds/easyrec-roberta-small/resolve/main/merges.txt",
        "wget -O baseline_embedders/easyrec-roberta-small/pytorch_model.bin https://huggingface.co/hkuds/easyrec-roberta-small/resolve/main/pytorch_model.bin",
        "wget -O baseline_embedders/easyrec-roberta-small/special_tokens_map.json https://huggingface.co/hkuds/easyrec-roberta-small/resolve/main/special_tokens_map.json",
        "wget -O baseline_embedders/easyrec-roberta-small/tokenizer_config.json https://huggingface.co/hkuds/easyrec-roberta-small/resolve/main/tokenizer_config.json",
        "wget -O baseline_embedders/easyrec-roberta-small/vocab.json https://huggingface.co/hkuds/easyrec-roberta-small/resolve/main/vocab.json",
        "wget -O data.zip https://archive.org/download/easyrec_data/data.zip",
        "unzip -o data.zip"
    ]
}

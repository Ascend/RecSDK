{
    "name": "ULTRA_HSTU_META_NPU",
    "model_name": "ULTRA_HSTU_META_NPU",
    "url": "https://github.com/meta-recsys/generative-recommenders.git",
    "commit_id": "d5e2dfe1e547d92146fedef50b2bfc4bf6a6712d",
    "patch_path": "patches/hstu_meta_npu.patch",
    "mode": "train",
    "epoch": 50,
    "profiling_flag": false,
    "aclgraph_flag": false,
    "data_type": "float32",
    "run_cmd": [
        "env",
        "ULTRA_HSTU=1",
        "ULTRA_DEVICE_TYPE=auto",
        "ULTRA_ACTION_ENCODING=1",
        "ULTRA_NUM_ACTIONS=6",
        "ULTRA_SLA=1",
        "ULTRA_LOCAL_WINDOW=128",
        "ULTRA_GLOBAL_WINDOW=32",
        "ULTRA_FULL_LAYERS=1",
        "ULTRA_TRUNCATION_LENGTH=128",
        "USE_NPU_HSTU=0",
        "ENABLE_RAB=1",
        "ASCEND_RT_VISIBLE_DEVICES=0,1,2,3,4,5,6,7",
        "PYTORCH_NPU_ALLOC_CONF=expandable_segments:True",
        "python3",
        "main.py",
        "--gin_config_file",
        "configs/ml-1m/hstu-sampled-softmax-n128-final.gin",
        "--master_port",
        "32355",
        "--batch_size",
        "128",
        "--skip_step_num",
        "2"
    ],
    "pip_install_self": false,
    "pip_install_requirements": false,
    "extra_cmd": [
        "git apply --ignore-space-change ../../../patches/ultra_hstu_meta_overlay.patch",
        "mkdir -p tmp/",
        "python3 preprocess_public_data.py"
    ],
    "lib_fbgemm_npu_api_so_path": "/usr/local/python3.11.0/lib/python3.11/site-packages/libfbgemm_npu_api.so"
}

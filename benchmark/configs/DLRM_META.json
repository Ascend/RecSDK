{
    "name": "DLRM_META",
    "url": "https://github.com/facebookresearch/dlrm.git",
    "model_name": "dlrm_meta",
    "commit_id": "9bc1bc3602aea22afad3206910cec50f2dbe7364",
    "patch_path": "patches/dlrm_meta_npu.patch",
    "mode": "train",
    "epoch": 1,
    "profiling_flag": false,
    "aclgraph_flag": false,
    "data_type": "float32",
    "run_cmd": [
        "torchrun",
        "--master_addr=localhost",
        "--master_port=6100",
        "--nproc_per_node=1",
        "dlrm_s_pytorch.py",
        "--arch-sparse-feature-size", "16",
        "--arch-mlp-bot", "13-512-256-64-16",
        "--arch-mlp-top", "512-256-1",
        "--data-generation", "dataset",
        "--data-set", "kaggle",
        "--raw-data-file", "./input/train.txt",
        "--processed-data-file", "./input/kaggleAdDisplayChallenge_processed.npz",
        "--loss-function", "bce",
        "--round-targets", "True",
        "--learning-rate", "0.1",
        "--print-time",
        "--test-mini-batch-size", "16384",
        "--test-num-workers", "16",
        "--use-npu",
        "--mini-batch-size", "128",
        "--print-freq", "10",
        "--stop-step", "10240",
        "--test-freq", "10240"
    ],
    "pip_install_self": false,
    "pip_install_requirements": false,
    "extra_cmd": ["cp -r ../../../dataset/dlrm_meta/. ./input/"]
}
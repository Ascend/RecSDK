+class DeterministicDropout(torch.nn.Module):
+    """CPU上生成掩码，确保跨设备一致"""
+
+    def __init__(self, p=0.5):
+        super().__init__()
+        self.p = p
+
+    def forward(self, x):
+        if self.p == 0 or not self.training:
+            return x
+
+        # 在 CPU 上生成掩码，然后广播
+        with torch.no_grad():
+            mask = torch.bernoulli(torch.full(x.shape, 1 - self.p, device='cpu'))
+            mask = mask / (1 - self.p)
+            self.mask = mask.to(x.device)
+
+        return x * self.mask
+
+    def extra_repr(self):
+        return f'p={self.p}, deterministic=True'

+
+"""Generate native PEPNet inputs with the official x86 feature generator."""
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+
+
+def main():
+    """Save native DataParser tensor dictionaries for replay on both devices."""
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--data", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    parser.add_argument("--batch-size", type=int, default=4096)
+    parser.add_argument("--steps", type=int, default=3)
+    args = parser.parse_args()
+    os.environ["TZREC_PEPNET_ONLY"] = "1"
+    import pyarrow as pa
+    import pyarrow.compute as pc
+    import pyarrow.parquet as pq
+    import torch
+    from google.protobuf import text_format
+
+    from tzrec.constant import Mode
+    from tzrec.datasets.data_parser import DataParser
+    from tzrec.features.feature import create_features
+    from tzrec.protos.data_pb2 import FgMode
+    from tzrec.protos.pipeline_pb2 import EasyRecConfig
+
+    config = EasyRecConfig()
+    config_text = Path("examples/pepnet_taobao.config").read_text()
+    text_format.Parse(config_text, config)
+    features = create_features(list(config.feature_configs), fg_mode=FgMode.FG_DAG)
+    data_parser = DataParser(
+        features, labels=list(config.data_config.label_fields), mode=Mode.TRAIN
+    )
+    args.output.mkdir(parents=True, exist_ok=True)
+    manifest = {
+        "generator": "upstream DataParser FG_DAG / official pyfg",
+        "config_sha256": hashlib.sha256(config_text.encode()).hexdigest(),
+        "batch_size": args.batch_size,
+        "steps": [],
+        "null_label_policy": "drop rows with null configured labels",
+        "dropped_null_label_rows": 0,
+    }
+    pending = None
+    for path in sorted(args.data.glob("part-*.parquet")):
+        for record in pq.ParquetFile(path).iter_batches(batch_size=args.batch_size):
+            table = pa.Table.from_batches([record])
+            mask = pa.array([True] * table.num_rows)
+            for label in config.data_config.label_fields:
+                mask = pc.and_(mask, pc.is_valid(table[label]))
+            valid = table.filter(mask)
+            manifest["dropped_null_label_rows"] += table.num_rows - valid.num_rows
+            table = valid
+            pending = table if pending is None else pa.concat_tables([pending, table])
+            while pending.num_rows >= args.batch_size:
+                current = pending.slice(0, args.batch_size).combine_chunks()
+                pending = pending.slice(args.batch_size)
+                parsed = data_parser.parse(
+                    {name: current[name].chunk(0) for name in current.column_names}
+                )
+                step = len(manifest["steps"])
+                out = args.output / f"step_{step:04d}.pt"
+                torch.save(parsed, out)
+                manifest["steps"].append(
+                    {
+                        "step": step,
+                        "sha256": hashlib.sha256(out.read_bytes()).hexdigest(),
+                    }
+                )
+                if len(manifest["steps"]) == args.steps:
+                    (args.output / "manifest.json").write_text(
+                        json.dumps(manifest, indent=2)
+                    )
+                    print(json.dumps({"steps": args.steps, "output": str(args.output)}))
+                    return
+    raise RuntimeError("Insufficient real input data; no completed manifest written")
+
+
+if __name__ == "__main__":
+    main()

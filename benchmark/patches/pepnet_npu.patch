+
+"""Train the complete upstream PEPNet with TorchRec on shared real inputs."""
+
+import argparse
+import hashlib
+import importlib
+import json
+import os
+import time
+from pathlib import Path
+
+
+def main():
+    """Check full-model forward, native loss, backward and parameter updates."""
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--device", required=True, choices=["cpu", "cuda", "npu"])
+    parser.add_argument("--batch-size", type=int, default=4096)
+    parser.add_argument("--steps", type=int, default=1000)
+    parser.add_argument("--inputs", type=Path)
+    parser.add_argument("--initial-state", type=Path)
+    parser.add_argument("--write-initial-state", type=Path)
+    parser.add_argument("--output", type=Path)
+    parser.add_argument(
+        "--precision", choices=["float32", "float16", "bfloat16"], default="float32"
+    )
+    parser.add_argument("--learning-rate", type=float, default=0.001)
+    parser.add_argument("--align", action="store_true")
+    args = parser.parse_args()
+    if args.steps < 1 or args.batch_size < 1:
+        parser.error("steps and batch-size must be positive")
+    if not args.write_initial_state and (
+        args.device == "cpu"
+        or not args.inputs
+        or not args.initial_state
+        or not args.output
+    ):
+        parser.error("training requires CUDA/NPU, inputs, initial-state and output")
+    os.environ["TZREC_PEPNET_ONLY"] = "1"
+    if args.device == "npu":
+        os.environ["FBGEMM_ASCEND_FORCE_BUILD_VER"] = "A3"
+    import torch
+
+    local_rank = int(os.getenv("LOCAL_RANK", "0"))
+    rank = int(os.getenv("RANK", "0"))
+    world_size = int(os.getenv("WORLD_SIZE", "1"))
+    device = torch.device(
+        f"{args.device}:{local_rank}" if args.device != "cpu" else "cpu"
+    )
+    if args.device == "npu":
+        importlib.import_module("torch_npu")
+        importlib.import_module("fbgemm_ascend")
+        if args.align:
+            torch.npu.set_option({"ACL_PRECISION_MODE": "must_keep_origin_dtype"})
+            torch.npu.matmul.allow_hf32 = False
+            torch.npu.conv.allow_hf32 = False
+        torch.npu.set_device(local_rank)
+    elif args.device == "cuda":
+        torch.cuda.set_device(local_rank)
+        torch.backends.cuda.matmul.allow_tf32 = False
+        torch.backends.cudnn.allow_tf32 = False
+        if args.align:
+            torch.backends.cuda.matmul.allow_fp16_reduced_precision_reduction = False
+            torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction = False
+    from google.protobuf import text_format
+
+    from tzrec.constant import Mode
+    from tzrec.datasets.data_parser import DataParser
+    from tzrec.features.feature import create_features
+    from tzrec.models.model import TrainWrapper
+    from tzrec.models.pepnet import PEPNet
+    from tzrec.protos.data_pb2 import FgMode
+    from tzrec.protos.pipeline_pb2 import EasyRecConfig
+    from tzrec.utils.state_dict_util import init_parameters
+
+    torch.manual_seed(1234)
+    config = EasyRecConfig()
+    text_format.Parse(Path("examples/pepnet_taobao.config").read_text(), config)
+    if args.align:
+        config.model_config.pepnet.ppnet_dropout_ratio[:] = [0.0, 0.0]
+    features = create_features(list(config.feature_configs), fg_mode=FgMode.FG_NONE)
+    data_parser = DataParser(
+        features, labels=list(config.data_config.label_fields), mode=Mode.TRAIN
+    )
+    model = PEPNet(config.model_config, features, list(config.data_config.label_fields))
+    init_parameters(model, torch.device("cpu"))
+    if args.write_initial_state:
+        torch.save(model.state_dict(), args.write_initial_state)
+        print(f"Saved upstream initial state: {args.write_initial_state}")
+        return
+    manifest_path = args.inputs / "manifest.json"
+    manifest = json.loads(manifest_path.read_text())
+    if (
+        manifest["batch_size"] != args.batch_size
+        or len(manifest["steps"]) < args.steps * world_size
+    ):
+        raise RuntimeError(
+            "Input manifest has insufficient batches or a different batch size"
+        )
+    if (
+        manifest["config_sha256"]
+        != hashlib.sha256(
+            Path("examples/pepnet_taobao.config").read_bytes()
+        ).hexdigest()
+    ):
+        raise RuntimeError(
+            "Input manifest does not match the upstream model configuration"
+        )
+    if args.initial_state:
+        model.load_state_dict(
+            torch.load(args.initial_state, map_location="cpu", weights_only=True)
+        )
+    initial_state = {
+        name: value.detach().cpu().clone() for name, value in model.state_dict().items()
+    }
+    native_model = model
+    import torch.distributed as dist
+    from torchrec.distributed.embeddingbag import EmbeddingBagCollectionSharder
+    from torchrec.distributed.model_parallel import DistributedModelParallel
+    from torchrec.distributed.planner import EmbeddingShardingPlanner, Topology
+    from torchrec.distributed.planner.types import ParameterConstraints
+    from torchrec.modules.embedding_modules import EmbeddingBagCollection
+    from torchrec.optim.apply_optimizer_in_backward import apply_optimizer_in_backward
+    from torchrec.optim.optimizers import in_backward_optimizer_filter
+
+    dist.init_process_group({"npu": "hccl", "cuda": "nccl", "cpu": "gloo"}[args.device])
+    sparse_params, _ = model.sparse_parameters()
+    apply_optimizer_in_backward(
+        torch.optim.Adagrad, sparse_params, {"lr": args.learning_rate}
+    )
+    constraints = {}
+    for module in model.modules():
+        if isinstance(module, EmbeddingBagCollection):
+            for table in module.embedding_bag_configs():
+                constraints[table.name] = ParameterConstraints(
+                    sharding_types=["row_wise"], compute_kernels=["fused"]
+                )
+    wrapper = TrainWrapper(
+        model,
+        device=device,
+        mixed_precision={"float32": None, "float16": "FP16", "bfloat16": "BF16"}[
+            args.precision
+        ],
+    )
+    sharders = [EmbeddingBagCollectionSharder()]
+    planner = EmbeddingShardingPlanner(
+        topology=Topology(
+            world_size=world_size,
+            local_world_size=world_size,
+            compute_device=args.device,
+            hbm_cap=16 * 1024**3,
+            ddr_cap=32 * 1024**3,
+        ),
+        batch_size=args.batch_size,
+        constraints=constraints,
+    )
+    plan = planner.collective_plan(wrapper, sharders, dist.group.WORLD)
+    model = DistributedModelParallel(
+        wrapper, device=device, sharders=sharders, plan=plan
+    )
+    model.load_state_dict(
+        {f"model.{name}": value for name, value in initial_state.items()}
+    )
+    optimizer = torch.optim.Adam(
+        dict(in_backward_optimizer_filter(model.named_parameters())).values(),
+        lr=args.learning_rate,
+    )
+    for name, value in model.state_dict().items():
+        source = initial_state[name.removeprefix("model.")]
+        if hasattr(value, "local_shards"):
+            for shard in value.local_shards():
+                expected = source[
+                    tuple(
+                        slice(offset, offset + size)
+                        for offset, size in zip(
+                            shard.metadata.shard_offsets, shard.metadata.shard_sizes
+                        )
+                    )
+                ]
+                if not torch.equal(expected, shard.tensor.detach().cpu()):
+                    raise RuntimeError(f"Initial embedding shard mismatch: {name}")
+        elif not torch.equal(source, value.detach().cpu()):
+            raise RuntimeError(f"Initial parameter mismatch: {name}")
+    model.train()
+    bs = args.batch_size
+    before = {
+        name: p.detach().cpu().clone()
+        for name, p in native_model.named_parameters()
+        if not name.startswith("embedding_group.")
+    }
+
+    def embedding_hashes():
+        """Hash local embedding shards before and after native optimizer updates."""
+        hashes = {}
+        for name, value in model.state_dict().items():
+            if "embedding_group." not in name:
+                continue
+            shards = (
+                [shard.tensor for shard in value.local_shards()]
+                if hasattr(value, "local_shards")
+                else [value]
+            )
+            digest = hashlib.sha256()
+            for shard in shards:
+                digest.update(shard.detach().cpu().contiguous().numpy().tobytes())
+            hashes[name] = digest.hexdigest()
+        return hashes
+
+    embedding_before = embedding_hashes()
+    losses = []
+    step_times = []
+    input_hashes = []
+    output = args.output.open("w") if args.output and rank == 0 else None
+
+    def gather_digest(digest):
+        """Exchange fixed size hashes on the active communication device."""
+        value = torch.tensor(
+            list(bytes.fromhex(digest)), dtype=torch.float32, device=device
+        )
+        values = [torch.empty_like(value) for _ in range(world_size)]
+        dist.all_gather(values, value)
+        return [bytes(int(x) for x in item.cpu().tolist()).hex() for item in values]
+
+    def verify_dense_replicas():
+        digest = hashlib.sha256()
+        for name, parameter in model.named_parameters():
+            if "embedding_group." not in name:
+                digest.update(name.encode())
+                digest.update(parameter.detach().cpu().contiguous().numpy().tobytes())
+        hashes = gather_digest(digest.hexdigest())
+        if len(set(hashes)) != 1:
+            raise RuntimeError("Dense parameters differ across ranks")
+        return hashes[0]
+
+    verify_dense_replicas()
+    metadata = {
+        "type": "metadata",
+        "upstream": "TorchEasyRec/v1.3.0/ee3ef097fa6ed9821f1c21e317f010c4519f7334",
+        "source_sha256": {
+            name: hashlib.sha256(Path(name).read_bytes()).hexdigest()
+            for name in [
+                "tzrec/modules/personalized_net.py",
+                "tzrec/modules/embedding.py",
+                "tzrec/models/multi_task_rank.py",
+                "tzrec/modules/task_tower.py",
+            ]
+        },
+        "input_manifest_sha256": hashlib.sha256(manifest_path.read_bytes()).hexdigest(),
+        "model_sha256": hashlib.sha256(
+            Path("tzrec/models/pepnet.py").read_bytes()
+        ).hexdigest(),
+        "config_sha256": hashlib.sha256(
+            Path("examples/pepnet_taobao.config").read_bytes()
+        ).hexdigest(),
+        "initial_state_sha256": hashlib.sha256(
+            args.initial_state.read_bytes()
+        ).hexdigest()
+        if args.initial_state
+        else None,
+        "runner_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+        "seed": 1234,
+        "batch_size": bs,
+        "world_size": world_size,
+        "steps": args.steps,
+        "precision": args.precision,
+        "learning_rate": args.learning_rate,
+        "align": args.align,
+        "alignment_policy": (
+            "dropout=0,TF32/HF32=off,CUDA reduced reductions=off,NPU origin dtype"
+        )
+        if args.align
+        else "upstream dropout; standard backend precision",
+        "optimizer": "TorchRec fused Adagrad + torch.optim.Adam",
+        "sharding": "row_wise/fused",
+        "device": args.device,
+        "initial_parameters_verified": True,
+    }
+    if output:
+        output.write(json.dumps(metadata) + "\n")
+    for step in range(args.steps):
+        input_path = args.inputs / f"step_{step * world_size + rank:04d}.pt"
+        input_hashes.append(hashlib.sha256(input_path.read_bytes()).hexdigest())
+        if input_hashes[-1] != manifest["steps"][step * world_size + rank]["sha256"]:
+            raise RuntimeError(f"Input file does not match the manifest: {input_path}")
+        step_input_hashes = gather_digest(input_hashes[-1])
+        parsed = torch.load(input_path, map_location="cpu", weights_only=True)
+        batch = data_parser.to_batch(parsed).to(device)
+        if batch.labels[config.data_config.label_fields[0]].shape[0] != bs:
+            raise RuntimeError(
+                "Input batch size differs from the experiment configuration"
+            )
+        step_start = time.perf_counter()
+        optimizer.zero_grad(set_to_none=True)
+        loss, _ = model(batch)
+        if not torch.isfinite(loss):
+            raise RuntimeError("Non-finite native loss")
+        loss.backward()
+        finite_grads = [
+            torch.isfinite(parameter.grad).all()
+            for parameter in model.parameters()
+            if parameter.grad is not None
+        ]
+        if finite_grads and not torch.stack(finite_grads).all():
+            raise RuntimeError("Non-finite native gradient")
+        optimizer.step()
+        if args.device == "npu":
+            torch.npu.synchronize()
+        elif args.device == "cuda":
+            torch.cuda.synchronize()
+        step_times.append(time.perf_counter() - step_start)
+        reported_loss = loss.detach().float().clone()
+        dist.all_reduce(reported_loss)
+        reported_loss /= world_size
+        losses.append(float(reported_loss.cpu()))
+        replica_hash = None
+        if step == 0 or (step + 1) % 100 == 0 or step + 1 == args.steps:
+            replica_hash = verify_dense_replicas()
+        if output:
+            output.write(
+                json.dumps(
+                    {
+                        "type": "step",
+                        "step": step + 1,
+                        "loss": losses[-1],
+                        "input_hashes": step_input_hashes,
+                        "dense_replica_hash": replica_hash,
+                        "precision": args.precision,
+                        "update": True,
+                    }
+                )
+                + "\n"
+            )
+            output.flush()
+        if rank == 0 and (step == 0 or (step + 1) % 100 == 0):
+            print(f"native step={step + 1} loss={losses[-1]:.9f}", flush=True)
+    changed = [
+        name
+        for name, p in native_model.named_parameters()
+        if name in before and not torch.equal(before[name], p.detach().cpu())
+    ]
+    if not changed:
+        raise RuntimeError("No parameter changed")
+    embedding_after = embedding_hashes()
+    embedding_changed = [
+        name
+        for name, digest in embedding_before.items()
+        if embedding_after[name] != digest
+    ]
+    if not embedding_changed:
+        raise RuntimeError("No embedding table changed")
+    local_updates = torch.tensor(
+        [len(changed), len(embedding_changed)], dtype=torch.float32, device=device
+    )
+    rank_updates = [torch.empty_like(local_updates) for _ in range(world_size)]
+    dist.all_gather(rank_updates, local_updates)
+    per_rank_updates = [value.int().cpu().tolist() for value in rank_updates]
+    if any(dense < 1 or sparse < 1 for dense, sparse in per_rank_updates):
+        raise RuntimeError("A rank did not update dense and embedding parameters")
+    mean_step_time = 1000.0 * sum(step_times) / len(step_times)
+    if rank == 0:
+        final_results = {
+            "dataset_name": "taobao_data_train",
+            "batch_size": args.batch_size,
+            "epoch": 1,
+            "step": args.steps,
+            "final_loss": losses[-1],
+            "ms/step": mean_step_time,
+            "metrics": {
+                "changed_parameters": len(changed),
+                "changed_embedding_tensors": len(embedding_changed),
+            },
+        }
+        model_detail_info = f"{args.device}_PEPNet_eager"
+        output_str = model_detail_info + "_" + str(final_results)
+        print(f"The Final Result: {output_str}", flush=True)
+        result_dir = Path(f"../save_results_{args.device}")
+        result_dir.mkdir(parents=True, exist_ok=True)
+        with (result_dir / "precision_result.txt").open(
+            "a", encoding="utf-8"
+        ) as result_stream:
+            result_stream.write(output_str + "\n")
+    if output:
+        output.write(
+            json.dumps(
+                {
+                    "type": "summary",
+                    "completed": True,
+                    "per_rank_updates": per_rank_updates,
+                }
+            )
+            + "\n"
+        )
+        output.close()
+    dist.destroy_process_group()
+
+
+if __name__ == "__main__":
+    main()

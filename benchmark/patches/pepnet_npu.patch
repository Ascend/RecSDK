+# Copyright (c) 2025, Alibaba Group;
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#    http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Compare native PEPNet losses after checking shared experiment inputs."""
+
+import argparse
+import json
+import math
+from pathlib import Path
+
+
+def read_run(path, steps):
+    """Read a completed run and validate input and parameter update evidence.
+
+    Args:
+        path: JSONL training log.
+        steps: Required number of training updates.
+
+    Returns:
+        Experiment metadata and per-step records.
+    """
+    records = [
+        json.loads(line) for line in path.read_text().splitlines() if line.strip()
+    ]
+    if not records or records[0].get("type") != "metadata":
+        raise ValueError(f"Missing experiment metadata: {path}")
+    if records[-1].get("type") != "summary" or not records[-1].get("completed"):
+        raise ValueError(f"Run did not complete parameter update checks: {path}")
+    metadata, values, summary = records[0], records[1:-1], records[-1]
+    updates = summary.get("per_rank_updates", [])
+    if len(updates) != metadata["world_size"] or any(
+        dense < 1 or sparse < 1 for dense, sparse in updates
+    ):
+        raise ValueError(f"Missing dense/embedding update evidence on a rank: {path}")
+    if metadata["steps"] != steps or len(values) != steps:
+        raise ValueError(f"Expected exactly {steps} updates: {path}")
+    if (
+        not metadata["initial_parameters_verified"]
+        or not metadata["initial_state_sha256"]
+    ):
+        raise ValueError(f"Shared initial parameters were not verified: {path}")
+    for step, record in enumerate(values, 1):
+        if (
+            record["step"] != step
+            or not record["update"]
+            or not math.isfinite(record["loss"])
+        ):
+            raise ValueError(f"Invalid update at step {step}: {path}")
+        if len(record["input_hashes"]) != metadata["world_size"]:
+            raise ValueError(f"Missing per-rank input evidence at step {step}: {path}")
+        if (step == 1 or step % 100 == 0 or step == steps) and not record[
+            "dense_replica_hash"
+        ]:
+            raise ValueError(f"Missing replica verification at step {step}: {path}")
+    return metadata, values
+
+
+def main():
+    """Compare matched GPU and NPU training losses against task thresholds."""
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--ref", type=Path, required=True)
+    parser.add_argument("--target", type=Path, required=True)
+    parser.add_argument("--steps", type=int, default=1000)
+    parser.add_argument("--output", type=Path)
+    args = parser.parse_args()
+    reference_meta, reference = read_run(args.ref, args.steps)
+    target_meta, target = read_run(args.target, args.steps)
+    if {reference_meta["device"], target_meta["device"]} != {"cuda", "npu"}:
+        raise ValueError("Expected one CUDA run and one NPU run")
+    if reference_meta.keys() != target_meta.keys():
+        raise ValueError("Experiment metadata fields differ")
+    for key in reference_meta:
+        if key != "device" and reference_meta[key] != target_meta.get(key):
+            raise ValueError(f"Experiment differs: {key}")
+    for step, (left, right) in enumerate(zip(reference, target), 1):
+        if left["input_hashes"] != right["input_hashes"]:
+            raise ValueError(f"Per-rank inputs differ at step {step}")
+    differences = [
+        abs(left["loss"] - right["loss"]) for left, right in zip(reference, target)
+    ]
+    precision = reference_meta["precision"]
+    threshold = {"float32": 1e-4, "float16": 1e-3, "bfloat16": 1e-2}[precision]
+    result = {
+        "precision": precision,
+        "steps": args.steps,
+        "world_size": reference_meta["world_size"],
+        "mae": sum(differences) / len(differences),
+        "max_abs_error": max(differences),
+        "threshold": threshold,
+        "scope": "1000-step precision"
+        if args.steps == 1000
+        else "short correctness check; not 1000-step acceptance",
+    }
+    result["passed"] = result["mae"] < threshold
+    content = json.dumps(result, indent=2)
+    print(content)
+    if args.output:
+        args.output.write_text(content + "\n")
+    if not result["passed"]:
+        raise SystemExit(1)
+
+
+if __name__ == "__main__":
+    main()

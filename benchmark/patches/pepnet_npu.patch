+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")"
+
+PYTHON_BIN=${PYTHON:-python3}
+DEVICE_TYPE=${DEVICE_TYPE:-npu}
+PRECISION=${PEPNET_PRECISION:-${MODEL_DATA_TYPE:-float32}}
+STEPS=${PEPNET_STEPS:-${MODEL_EPOCH:-1000}}
+BATCH_SIZE=${PEPNET_BATCH_SIZE:-4096}
+NPROC_PER_NODE=${NPROC_PER_NODE:-1}
+RESULT_ROOT=${PEPNET_BENCHMARK_RESULT_ROOT:-../save_results_${DEVICE_TYPE}}
+OUTPUT=${OUTPUT:-${RESULT_ROOT}/PEPNet/${DEVICE_TYPE}_${PRECISION}_${NPROC_PER_NODE}p.jsonl}
+: "${PEPNET_INPUTS:?Set PEPNET_INPUTS to the official preprocessed input directory}"
+: "${PEPNET_INITIAL_PARAMETERS:?Set PEPNET_INITIAL_PARAMETERS to the shared CPU checkpoint}"
+
+export TZREC_PEPNET_ONLY=1
+export PYTHONPATH="$(pwd)${PYTHONPATH:+:$PYTHONPATH}"
+export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
+if [[ "$DEVICE_TYPE" == npu ]]; then
+    export FBGEMM_ASCEND_FORCE_BUILD_VER=A3
+    export HCCL_NPU_SOCKET_PORT_RANGE=${HCCL_NPU_SOCKET_PORT_RANGE:-auto}
+    export HCCL_HOST_SOCKET_PORT_RANGE=${HCCL_HOST_SOCKET_PORT_RANGE:-auto}
+fi
+if [[ ! -f tzrec/protos/pipeline_pb2.py ]]; then
+    "$PYTHON_BIN" -m grpc_tools.protoc -I. --python_out=. \
+        tzrec/protos/*.proto tzrec/protos/models/*.proto
+fi
+mkdir -p "$(dirname "$OUTPUT")"
+arguments=(--device "$DEVICE_TYPE" --precision "$PRECISION"
+    --steps "$STEPS" --batch-size "$BATCH_SIZE"
+    --inputs "$PEPNET_INPUTS" --initial-state "$PEPNET_INITIAL_PARAMETERS"
+    --learning-rate "${PEPNET_LEARNING_RATE:-0.001}" --output "$OUTPUT")
+if [[ "${PEPNET_ALIGN_DEVICES:-0}" == 1 ]]; then
+    arguments+=(--align)
+fi
+"$PYTHON_BIN" -m torch.distributed.run --rdzv-backend=static \
+    --master-addr="${MASTER_ADDR:-127.0.0.1}" --master-port="${MASTER_PORT:-29741}" \
+    --nproc_per_node="$NPROC_PER_NODE" \
+    benchmark_pepnet.py "${arguments[@]}"

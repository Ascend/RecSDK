+# ==============================================================================
+
+from __future__ import annotations
+
+import os
+import pickle
+from typing import Any, Dict
+
+import argparse
+import numpy as np
+import torch
+from torch.distributed.device_mesh import DeviceMesh
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser()
+    parser.add_argument(
+        "--use-fsdp2", action=argparse.BooleanOptionalAction, default=False
+    )
+    parser.add_argument(
+        "--tp-size", type=int, default=1
+    )
+    parser.add_argument(
+        "--manual-seed",
+        "--manual_seed",
+        dest="manual_seed",
+        type=int,
+        default=42,
+    )
+    parser.add_argument(
+        "--use-bf16", action=argparse.BooleanOptionalAction, default=True
+    )
+    parser.add_argument(
+        "--attention-backend",
+        choices=("eager", "sdpa", "ascend"),
+        default="eager",
+    )
+    parser.add_argument(
+        "--resume", action=argparse.BooleanOptionalAction, default=False
+    )
+    parser.add_argument(
+        "--mode",
+        choices=("train", "eval"),
+        default="train",
+    )
+    parser.add_argument(
+        "--compile", action=argparse.BooleanOptionalAction, default=False
+    )
+    parser.add_argument("--data-dir", default="./data/training_data_all-rlData.csv")
+    parser.add_argument("--modelsave-dir", default="./checkpoints/")
+    parser.add_argument("--batch-size", type=int, default=128)
+    args = parser.parse_args()
+    return args
+
+
+def resolve_device() -> torch.device:
+    try:
+        import torch_npu  # type: ignore
+
+        if torch_npu.npu.is_available():
+            return torch.device("npu")
+    except Exception:
+        pass
+    if not torch.cuda.is_available():
+        raise RuntimeError("NPU and CUDA: do not support both.")
+    return torch.device("cuda") if torch.cuda.is_available() else torch.device("cpu")
+
+
+def save_normalize_dict(normalize_dict: Dict[str, Any], save_dir: str) -> None:
+    os.makedirs(save_dir, exist_ok=True)
+    save_path = os.path.join(save_dir, "normalize_dict.pkl")
+    with open(save_path, "wb") as file:
+        pickle.dump(normalize_dict, file)
+
+
+def load_normalize_dict(save_dir: str) -> Dict[str, np.ndarray]:
+    load_path = os.path.join(save_dir, "normalize_dict.pkl")
+    if not os.path.isfile(load_path):
+        raise FileNotFoundError(f"normalization file does not exist: {load_path}")
+    with open(load_path, "rb") as file:
+        normalize_dict = pickle.load(file)
+    if "state_mean" not in normalize_dict or "state_std" not in normalize_dict:
+        raise ValueError(f"invalid normalization file: {load_path}")
+    return {
+        "state_mean": np.asarray(normalize_dict["state_mean"], dtype=np.float32),
+        "state_std": np.asarray(normalize_dict["state_std"], dtype=np.float32),
+    }
+
+
+def get_profiler(device: torch.device, output_dir: str):
+    if device.type == "cuda":
+        return torch.profiler.profile(
+            activities=[
+                torch.profiler.ProfilerActivity.CPU,
+                torch.profiler.ProfilerActivity.CUDA,
+            ],
+            schedule=torch.profiler.schedule(
+                wait=0, warmup=5, active=10, repeat=1, skip_first=10
+            ),
+            on_trace_ready=torch.profiler.tensorboard_trace_handler(
+                dir_name=output_dir
+            ),
+            record_shapes=True,
+            with_stack=True,
+            profile_memory=False,
+            with_modules=False,
+            with_flops=False,
+        )
+    try:
+        import torch_npu  # type: ignore
+
+        if device.type == "npu":
+            return torch_npu.profiler.profile(
+                activities=[
+                    torch_npu.profiler.ProfilerActivity.CPU,
+                    torch_npu.profiler.ProfilerActivity.NPU,
+                ],
+                schedule=torch_npu.profiler.schedule(
+                    wait=0, warmup=5, active=10, repeat=1, skip_first=10
+                ),
+                on_trace_ready=torch_npu.profiler.tensorboard_trace_handler(
+                    dir_name=output_dir
+                ),
+                record_shapes=True,
+                with_stack=True,
+                profile_memory=False,
+                with_modules=False,
+                with_flops=False,
+                experimental_config=torch_npu.profiler._ExperimentalConfig(
+                    export_type=[torch_npu.profiler.ExportType.Text],
+                    aic_metrics=torch_npu.profiler.AiCMetrics.PipeUtilization,
+                    profiler_level=torch_npu.profiler.ProfilerLevel.Level0,
+                    l2_cache=False,
+                ),
+            )
+    except Exception:
+        pass
+
+    return torch.profiler.profile(
+        activities=[torch.profiler.ProfilerActivity.CPU],
+        schedule=torch.profiler.schedule(
+            wait=0, warmup=5, active=10, repeat=1, skip_first=10
+        ),
+        on_trace_ready=torch.profiler.tensorboard_trace_handler(dir_name=output_dir),
+        record_shapes=True,
+        with_stack=True,
+        profile_memory=False,
+        with_modules=False,
+        with_flops=False,
+    )
+
+
+def init_distribute(
+    extra_config: Dict[str, Any],
+    use_tp: bool = False,
+) -> tuple[int, int, torch.device, DeviceMesh | None]:
+    del extra_config
+    try:
+        local_rank = int(os.environ["LOCAL_RANK"])
+        if torch.cuda.is_available():
+            torch.cuda.set_device(local_rank)
+            if not torch.distributed.is_initialized():
+                torch.distributed.init_process_group(backend="nccl")
+            device = torch.device("cuda", local_rank)
+        else:
+            import torch_npu  # type: ignore
+
+            if torch_npu.npu.is_available():
+                torch_npu.npu.set_device(local_rank)
+                if not torch.distributed.is_initialized():
+                    torch.distributed.init_process_group(backend="hccl")
+                device = torch.device("npu", local_rank)
+            else:
+                raise RuntimeError("neither CUDA nor NPU is available")
+    except Exception as exc:
+        raise RuntimeError("initialize distributed runtime failed") from exc
+
+    rank = torch.distributed.get_rank()
+    world_size = torch.distributed.get_world_size()
+
+    if use_tp:
+        from torch.distributed.device_mesh import init_device_mesh
+
+        tp_mesh = init_device_mesh(
+            device.type,
+            mesh_shape=(world_size,),
+            mesh_dim_names=("tp",),
+        )
+    else:
+        tp_mesh = None
+
+    return rank, world_size, device, tp_mesh

diff --git a/device_utils.py b/device_utils.py
new file mode 100644
index 0000000..215ba6e
--- /dev/null
+++ b/device_utils.py
@@ -0,0 +1,66 @@
+import math
+import os
+from types import MethodType
+
+import torch
+import torch.nn.functional as F
+
+
+class FP32GELU(torch.nn.Module):
+    def forward(self, value):
+        work = value.float()
+        result = work * 0.5 * (1.0 + torch.erf(work / math.sqrt(2.0)))
+        return result.to(value.dtype)
+
+
+def enable_fp32_gelu(model):
+    for layer in model.roberta.encoder.layer:
+        layer.intermediate.intermediate_act_fn = FP32GELU()
+
+
+def enable_fp32_ffn_output(model):
+    def fp32_forward(module, value):
+        with torch.autocast(device_type=value.device.type, enabled=False):
+            bias = module.bias.float() if module.bias is not None else None
+            return F.linear(value.float(), module.weight.float(), bias)
+
+    for layer in model.roberta.encoder.layer:
+        layer.output.dense.forward = MethodType(fp32_forward, layer.output.dense)
+
+
+def initialize_accelerator(device_type=None):
+    device_type = (device_type or os.getenv("EASYREC_DEVICE", "auto")).lower()
+    if device_type not in {"auto", "cuda", "npu", "cpu"}:
+        raise ValueError(f"Unsupported device type: {device_type}")
+
+    if device_type in {"auto", "npu"}:
+        try:
+            import torch_npu  # noqa: F401
+        except ImportError:
+            if device_type == "npu":
+                raise
+
+    if device_type == "auto":
+        if hasattr(torch, "npu") and torch.npu.is_available():
+            device_type = "npu"
+        elif torch.cuda.is_available():
+            device_type = "cuda"
+        else:
+            device_type = "cpu"
+    return device_type
+
+
+def current_device(device_type=None):
+    device_type = initialize_accelerator(device_type)
+    if device_type == "npu":
+        return torch.device("npu", torch.npu.current_device())
+    if device_type == "cuda":
+        return torch.device("cuda", torch.cuda.current_device())
+    return torch.device("cpu")
+
+
+def synchronize(device_type):
+    if device_type == "npu":
+        torch.npu.synchronize()
+    elif device_type == "cuda":
+        torch.cuda.synchronize()

+#!/usr/bin/env bash
+set -euo pipefail
+
+DEVICE_TYPE=${DEVICE_TYPE:-npu}
+PRECISION=${PRECISION:-bfloat16}
+NPROC_PER_NODE=${NPROC_PER_NODE:-1}
+OUTPUT=${OUTPUT:-results/${DEVICE_TYPE}_${PRECISION}_${NPROC_PER_NODE}p.jsonl}
+MASTER_PORT=${MASTER_PORT:-40001}
+PYTHON=${PYTHON:-python}
+
+if [[ "${DEVICE_TYPE}" == "npu" ]]; then
+    export EASYREC_DEVICE=npu
+    export ASCEND_RT_VISIBLE_DEVICES=${ASCEND_RT_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}
+elif [[ "${DEVICE_TYPE}" == "cuda" ]]; then
+    export EASYREC_DEVICE=cuda
+    export CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-0,1,2,3,4,5,6,7}
+elif [[ "${DEVICE_TYPE}" == "cpu" ]]; then
+    export EASYREC_DEVICE=cpu
+    NPROC_PER_NODE=1
+else
+    echo "DEVICE_TYPE must be cuda, npu, or cpu" >&2
+    exit 2
+fi
+
+"${PYTHON}" -m torch.distributed.run \
+    --nnodes=1 --node-rank=0 --nproc-per-node="${NPROC_PER_NODE}" \
+    --master-addr=127.0.0.1 \
+    --master-port="${MASTER_PORT}" benchmark_easyrec.py \
+    --device "${DEVICE_TYPE}" \
+    --precision "${PRECISION}" \
+    --output "${OUTPUT}" \
+    "$@"

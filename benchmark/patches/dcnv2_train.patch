+def _compile_for_inductor(model: nn.Module) -> nn.Module:
+    """Compile model to inductor (NPU).
+
+    sparse fbgemm 算子不入图，留在 eager 执行，避免 dynamo 图捕获失败。
+    训练与推理共用此逻辑（训练侧需配合 TrainPipelineBase 使用）。
+    """
+    import torch._dynamo
+
+    # 当前算子入图功能待开发
+    torch._dynamo.disallow_in_graph(
+        torch.ops.fbgemm.split_embedding_codegen_lookup_sgd_function_pt2
+    )
+    torch._dynamo.disallow_in_graph(torch.ops.fbgemm.permute_2D_sparse_data_input1D)
+    torch._dynamo.disallow_in_graph(torch.ops.fbgemm.block_bucketize_sparse_features)
+    torch._dynamo.disallow_in_graph(torch.ops.fbgemm.get_infos_metadata)
+    torch._dynamo.disallow_in_graph(torch.ops.fbgemm.jagged_to_padded_dense)
+    acl_flag = os.environ.get("MODEL_ACLGRAPH_FLAG", "False").upper() == "TRUE"
+    if acl_flag:
+        return torch.compile(model, backend="inductor", mode="reduce-overhead")
+    return torch.compile(model, backend="inductor")
+

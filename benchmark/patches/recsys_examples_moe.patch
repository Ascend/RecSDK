index 0000000..bfd51b6
--- /dev/null
+++ b/examples/commons/distributed/fsdp2.py
@@ -0,0 +1,267 @@
+# SPDX-FileCopyrightText: Copyright (c) 2025 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+# SPDX-License-Identifier: Apache-2.0

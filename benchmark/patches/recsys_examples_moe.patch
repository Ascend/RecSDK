@@ -199,18 +201,89 @@ class HSTUSequenceDataset(IterableDataset[HSTUBatch]):
 
     # We do batching in our own
     def __len__(self) -> int:
+        if self._num_samples % self._global_batch_size < self._world_size:
+            return math.floor(self._num_samples / self._global_batch_size)
         return math.ceil(self._num_samples / self._global_batch_size)
 
+    def _balance_batch(self):
+        # 按global_batch为粒度切片遍历，每一个切片内进行排序，排序原则为：
+        # 每连续batch size的区块所含的batch长度累加长度均衡
+        if self._batch_size < 2:
+            return
+        ctx_len = len(self._contextual_feature_names)
+        factor = 2 if self._action_feature_name is not None else 1
+        max_cand = max(0, self._max_num_candidates)
+        cap_body = self._max_history_seqlen - ctx_len - max_cand
+
+        chunks = [self._sample_ids[i:i + self._global_batch_size] for i in range(0, self._num_samples, self._global_batch_size)]
+        col = self._seq_logs_frame[self._item_feature_name]
+        cost = 0 # seq len作为cost
+        for chunk in chunks:
+            start = time.perf_counter_ns()
+            vals = [col.iat[int(sid)] for sid in chunk]
+            vals_len = [self._fast_seq_len(x) for x in vals]
+            cost += (time.perf_counter_ns() - start)
+            cand_len = [min(max_cand, max(0, l)) for l in vals_len]
+            body_len = [max(0, l - c) for l, c in zip(vals_len, cand_len)]
+            trunc_body_len = [min(b, max(0, cap_body)) for b in body_len]
+            total_len = [tb + c for tb, c in zip(trunc_body_len, cand_len)]
+            costs = [factor * t + ctx_len for t in total_len]
+            self._balance_by_costs(chunk, costs)
+
+    def _balance_by_costs(self, ids, costs):
+        """
+        针对一个sample_ids的costs进行排序，排序结果让batch_size块的总和负载均衡
+        排序算法策略：
+        1. 将2个列表拼在一起
+        2. 按照costs升序排列ids
+        3. 排序后，按照每个排序好的分块，贪心策略一大一小的顺序取序列分配给rank
+        """
+        if len(ids) < self._global_batch_size:
+            # 尾部不足一个global_batch,先不考虑负载均衡
+            return
+        if len(ids) != len(costs):
+            return
+        pairs = list(zip(ids, costs))
+        pairs.sort(key=lambda x: x[1])
+        idssort = [x[0] for x in pairs]
+        idsidx = 0
+        ranknum = self._world_size
+        # 按rank遍历分id
+        rank = self._rank
+        idsidx = rank * self._batch_size
+        for i in range(self._batch_size):
+            if idsidx % 2 == 0:
+                ids[idsidx] = idssort[i * ranknum + rank]
+            else:
+                ids[idsidx] = idssort[i * ranknum + (ranknum - rank) - 1]
+            idsidx += 1
+
+    def _fast_seq_len(self, x) -> int:
+        # 根据json字符串估算长度
+        s = x.strip()
+        if len(s) <= 2:
+            return 0
+        return s.count(',') + 1
+
     def __iter__(self) -> Iterator[HSTUBatch]:
         for i in range(len(self)):
-            local_batch_start = min(
-                i * self._global_batch_size + self._rank * self._batch_size,
-                len(self._sample_ids),
-            )
-            local_batch_end = min(
-                i * self._global_batch_size + (self._rank + 1) * self._batch_size,
-                len(self._sample_ids),
-            )
+            if i == len(self) - 1:
+                last_batch_size = (len(self._sample_ids) - i * self._global_batch_size) // self._world_size
+                local_batch_start = (
+                    i * self._global_batch_size + self._rank * last_batch_size
+                )
+                local_batch_end = min(
+                    i * self._global_batch_size + (self._rank + 1) * last_batch_size,
+                    len(self._sample_ids),
+                )
+            else:
+                local_batch_start = (
+                    i * self._global_batch_size + self._rank * self._batch_size
+                )
+                local_batch_end = min(
+                    i * self._global_batch_size + (self._rank + 1) * self._batch_size,
+                    len(self._sample_ids),
+                )
             sample_ids = self._sample_ids[local_batch_start:local_batch_end]
 
             actual_batch_size = local_batch_end - local_batch_start

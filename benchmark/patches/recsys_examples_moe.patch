+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+from typing import Any, Dict, List, Optional, Set, Tuple, Union
+
+try:
+    from torch.distributed import DeviceMesh as DeviceMesh
+    HAVE_FSDP = True
+except ImportError:
+    HAVE_FSDP = False
+
+import dataclasses
+import torch
+import yaml
+from commons.optimizer import OptimizerParam
+from megatron.core.distributed import DistributedDataParallelConfig
+from megatron.core.distributed import TorchFullyShardedDataParallel
+from megatron.core.optimizer import OptimizerConfig, get_megatron_optimizer
+from megatron.core.transformer import TransformerConfig
+from megatron.core.transformer.module import Float16Module
+from torch.distributed._composable.fsdp import MixedPrecisionPolicy, CPUOffloadPolicy, OffloadPolicy
+from torchrec.distributed.model_parallel import DistributedModelParallel
+from megatron.core import parallel_state
+
+
+def _get_dtype(dtype_str: str):
+    DTYPE_MAP = {
+        'fp16': torch.float16,
+        'bf16': torch.bfloat16,
+        'fp32': torch.float32,
+    }
+    if dtype_str not in DTYPE_MAP:
+        raise ValueError(f"Unsupported dtype: {dtype_str}")
+    return DTYPE_MAP[dtype_str]
+
+
+def _get_class_type(name: str) -> type:
+    if isinstance(name, type):
+        return name
+    names = name.rsplit('.', 1)
+    if len(names) == 1:
+        raise RuntimeError(f"Please provide a module.class name, got {name}")
+    module_name, class_name = names
+    import importlib
+    module = importlib.import_module(module_name)
+    class_type = getattr(module, class_name, None)
+    return class_type
+
+
+@dataclasses.dataclass
+class Fsdp2Config:
+    sharding_size: Optional[int] = None
+    sub_modules_to_wrap: Optional[Any] = None
+    reshard_after_forward: Union[bool, int] = True
+    param_dtype: Optional[str] = None
+    reduce_dtype: Optional[str] = None
+    output_dtype: Optional[str] = None
+    cast_forward_inputs: bool = True
+    offload_to_cpu: bool = False
+    pin_memory: bool = True
+    num_to_forward_prefetch: Optional[int] = 0
+    ignored_modules: Optional[Any] = None
+    recompute_modules: Optional[Any] = None
+
+    def to_dict(self):
+        mp_policy = self._mp_policy()
+        offload_policy = CPUOffloadPolicy(pin_memory=self.pin_memory) if self.offload_to_cpu else OffloadPolicy()
+        kwargs = {
+            "mp_policy": mp_policy,
+            "reshard_after_forward": self.reshard_after_forward,
+            "offload_policy": offload_policy,
+        }
+        return kwargs
+
+    def _mp_policy(self):
+        param_dtype = _get_dtype(self.param_dtype) if self.param_dtype else None
+        reduce_dtype = _get_dtype(self.reduce_dtype) if self.reduce_dtype else None
+        output_dtype = _get_dtype(self.output_dtype) if self.output_dtype else None
+        return MixedPrecisionPolicy(
+            param_dtype=param_dtype,
+            reduce_dtype=reduce_dtype,
+            output_dtype=output_dtype,
+            cast_forward_inputs=self.cast_forward_inputs,
+        )
+
+    def _str_to_module(self, module_names):
+        if module_names:
+            module_set = set(_get_class_type(m) for m in module_names)
+            module_set.discard(None)
+        else:
+            module_set = set()
+        return module_set
+
+    @classmethod
+    def load_from_yaml(cls, yml_file: str):
+        with open(yml_file, 'r') as f:
+            config = yaml.safe_load(f)
+        kwargs = {}
+        for field in dataclasses.fields(cls):
+            if field.name in config:
+                kwargs[field.name] = config[field.name]
+        return cls(**kwargs)
+
+    @classmethod
+    def load_from_dict(cls, config_dict: Dict[str, Any]):
+        kwargs = {}
+        for field in dataclasses.fields(cls):
+            if field.name in config_dict:
+                kwargs[field.name] = config_dict[field.name]
+        return cls(**kwargs)
+
+    def __post_init__(self):
+        if self.sub_modules_to_wrap:
+            self.sub_modules_to_wrap = self._str_to_module(self.sub_modules_to_wrap)
+        if self.ignored_modules:
+            self.ignored_modules = self._str_to_module(self.ignored_modules)
+        if self.recompute_modules:
+            self.recompute_modules = self._str_to_module(self.recompute_modules)
+
+
+def _create_device_mesh(sharding_size: Optional[int], process_group) -> "DeviceMesh":
+    from torch.distributed import DeviceMesh, get_process_group_ranks
+
+    if sharding_size is None:
+        sharding_size = torch.distributed.get_world_size(process_group)
+
+    world_size = torch.distributed.get_world_size(process_group)
+    group_global_ranks = torch.tensor(
+        get_process_group_ranks(process_group),
+        device="cpu",
+        dtype=torch.int,
+    )
+    replicating_size = world_size // sharding_size
+
+    if replicating_size * sharding_size != world_size:
+        raise ValueError(
+            f"World size {world_size} must be divisible by sharding_size {sharding_size}."
+        )
+
+    if replicating_size == 1:
+        device_mesh = DeviceMesh.from_group(
+            process_group,
+            "cuda",
+            mesh_dim_names=["Shard"],
+        )
+    else:
+        mesh = group_global_ranks.view(replicating_size, sharding_size)
+        device_mesh = DeviceMesh(
+            "cuda",
+            mesh,
+            mesh_dim_names=["Replicate", "Shard"],
+        )
+
+    return device_mesh
+
+
+class TorchFullyShardedDataParallelAdaptor(TorchFullyShardedDataParallel):
+    def __init__(
+        self,
+        config: TransformerConfig,
+        ddp_config: DistributedDataParallelConfig,
+        fsdp2_config: Union[Dict, str],
+        module: torch.nn.Module,
+        sub_modules_to_wrap: Set[torch.nn.Module] = None,
+        process_group=None,
+    ):
+        from torch.distributed._composable.fsdp import fully_shard
+
+        assert HAVE_FSDP, 'TorchFullyShardedDataParallelAdaptor requires PyTorch >= 2.4.0 with FSDP2 support.'
+
+        if sub_modules_to_wrap is None:
+            sub_modules_to_wrap = set()
+
+        if process_group is None:
+            process_group = parallel_state.get_data_parallel_group(with_context_parallel=True)
+        self.process_group = process_group
+
+        if isinstance(fsdp2_config, str):
+            fsdp2_cfg = Fsdp2Config.load_from_yaml(fsdp2_config)
+        else:
+            fsdp2_cfg = Fsdp2Config.load_from_dict(fsdp2_config)
+        fsdp2_kwargs = {}
+        fsdp2_kwargs.update(fsdp2_cfg.to_dict())
+        self.device_mesh = _create_device_mesh(fsdp2_cfg.sharding_size, self.process_group)
+        fsdp2_kwargs["mesh"] = self.device_mesh
+
+        def save_custom_attrs(mod):
+            custom_attrs = {}
+            for name, param in mod.named_parameters():
+                attrs = vars(param)
+                custom_attrs[name] = {k: v for k, v in attrs.items()}
+            return custom_attrs
+
+        def restore_custom_attrs(mod, custom_attrs):
+            for name, param in mod.named_parameters():
+                if name in custom_attrs:
+                    for attr_name, attr_value in custom_attrs[name].items():
+                        setattr(param, attr_name, attr_value)
+
+        attrs = save_custom_attrs(module)
+
+        sub_modules_to_wrap = fsdp2_cfg.sub_modules_to_wrap if fsdp2_cfg.sub_modules_to_wrap is not None else set(sub_modules_to_wrap)
+        ignored_params = set()
+        if fsdp2_cfg.ignored_modules:
+            for sub_module in module.modules():
+                if isinstance(sub_module, tuple(fsdp2_cfg.ignored_modules)):
+                    from torch.distributed.fsdp._fully_shard._fsdp_init import _get_device_from_mesh

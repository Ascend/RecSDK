diff --git a/examples/hstu/modules/sparse_moe.py b/examples/hstu/modules/sparse_moe.py
new file mode 100644
index 0000000..39c087d
--- /dev/null
+++ b/examples/hstu/modules/sparse_moe.py
@@ -0,0 +1,165 @@
+import os
+import torch
+import torch.nn.functional as F
+import torch_npu
+from torch.autograd import Function
+from mindspeed.ops import gmm
+
+class SparseMOE(torch.nn.Module):
+    def __init__(
+            self,
+            emb_dim,
+            expert_number,
+            top_k,
+            hidden_size,
+            dtype,
+            is_use_gmm=True,
+            aux_loss_weight=0.01,
+        ):
+        super().__init__()
+
+        self.expert_number = expert_number
+        if not is_use_gmm:
+            self.experts = torch.nn.ModuleList([
+                FFN_npu_swiglu(emb_dim, hidden_size, dtype) for _ in range(expert_number)])
+        else:
+            device = torch_npu.npu.current_device()
+            self.cw1 = torch.nn.Parameter(torch.empty(expert_number, hidden_size, emb_dim, device=device))
+            self.cw2 = torch.nn.Parameter(torch.empty(expert_number, emb_dim, hidden_size, device=device))
+            self.cw3 = torch.nn.Parameter(torch.empty(expert_number, hidden_size, emb_dim, device=device))
+            self._init_weights()
+        
+        self.router = MOERouter(emb_dim, expert_number, top_k, dtype, aux_loss_weight)
+        self.top_k = top_k
+        self.dtype = dtype
+
+    def _init_weights(self):
+        for param in [self.cw1, self.cw2, self.cw3]:
+            torch.nn.init.xavier_uniform_(param)
+
+    def compute_ffn_with_grouped_matmul(self, expanded_x, w1_list, w2_list, w3_list, group_list):
+        # w1(x): 投影到隐藏维度
+        w1_out = gmm.npu_gmm_v2(
+            x=expanded_x,
+            weight=w1_list.transpose(-1, -2),
+            group_list=group_list,
+            group_type=0
+        )
+
+        w3_out = gmm.npu_gmm_v2(
+            x=expanded_x,
+            weight=w3_list.transpose(-1, -2),
+            group_list=group_list,
+            group_type=0
+        )
+        gate = F.silu(w1_out)
+        combined = gate * w3_out
+
+        w2_out = gmm.npu_gmm_v2(
+            x=combined,
+            weight=w2_list.transpose(-1, -2),
+            group_list=group_list,
+            group_type=0
+        )
+
+        return w2_out
+
+    def forward(self, x):
+        # x shape is (b, s, hidden_dim)
+        seq_len, hidden_dim = x.size()
+        hidden_states = x.view(-1, hidden_dim)  # shape is (b * s, hidden_dim)
+
+        router_weights, expert_mask, selected_experts, group_list, aux_loss = self.router(hidden_states)
+
+        expend_x, idx = torch_npu.npu_moe_token_permute(
+            tokens=x,
+            indices=selected_experts,
+            num_out_tokens=seq_len*self.top_k
+        )
+
+        expanded_permuted_rows = self.compute_ffn_with_grouped_matmul(
+            expend_x, self.cw1, self.cw2, self.cw3, group_list
+        )
+
+        return torch_npu.npu_moe_token_unpermute(expanded_permuted_rows,idx, router_weights), aux_loss
+
+    def forward_naive(self, x):
+        # x shape is (b, s, hidden_dim)
+        seq_len, hidden_dim = x.size()
+        hidden_states = x.view(-1, hidden_dim)  # shape is (b * s, hidden_dim)
+
+        router_weights, expert_mask, selected_experts, group_list, aux_loss = self.router(hidden_states)
+
+        final_hidden_states = torch.zeros(
+            (seq_len, hidden_dim),
+            dtype=hidden_states.dtype,
+            device=hidden_states.device
+        )
+
+        for expert_idx in range(self.expert_number):
+            expert_layer = self.experts[expert_idx]
+            idx, top_x = torch.where(expert_mask[expert_idx])
+            current_state = hidden_states.unsqueeze(0)[:, top_x, :].reshape(-1, hidden_dim)  # token选取专家
+            current_hidden_states = expert_layer(current_state) * router_weights[top_x, idx].unsqueeze(-1)  # 专家运算
+            final_hidden_states.index_add_(dim=0, index=top_x, source=current_hidden_states)  # 专家权重相加
+
+        return final_hidden_states, aux_loss
+
+
+class MOERouter(torch.nn.Module):
+    def __init__(self, emb_dim, expert_number, top_k_number, dtype, aux_loss_weight=0.01):
+        super().__init__()
+        self.gate = torch.nn.Linear(emb_dim, expert_number)
+        self.expert_number = expert_number
+        self.top_k = top_k_number
+        self.aux_loss_weight = aux_loss_weight
+
+    def _compute_aux_loss(self, router_logits, topk_weights, topk_indices):
+        num_experts = router_logits.size(-1)
+
+        # top-k索引转为 one-hot编码
+        topk_mask = F.one_hot(topk_indices, num_classes=num_experts).to(torch.float32)  # shape is (b * s, top_k, num_experts)
+
+        # 计算每个token分给每个专家的权重
+        expert_weights = (topk_mask * topk_weights.unsqueeze(-1)).sum(dim=1)  # shape is (b * s, num_experts)
+
+        f_i = expert_weights.mean(dim=0)  # 每个专家的平均权重
+        P_i = router_logits.mean(dim=0)  # 每个专家的平均路由概率
+
+        aux_loss = num_experts * torch.sum(f_i.detach() * P_i)  # 辅助损失计算公式
+
+        return aux_loss * self.aux_loss_weight
+        
+    def forward(self, hidden_states):
+        # 计算路由logits
+        router_logits = F.softmax(self.gate(hidden_states),dim=-1)  # shape is (b * s, dim)
+
+        # 计算topk的专家的输出
+        router_weights, selected_experts = torch.topk(router_logits, self.top_k, dim=-1)  # shape都是 (b * s, top_k)
+
+        # 专家权重归一化
+        router_weights = torch.softmax(router_weights, dim=-1)
+
+        # 计算辅助损失
+        aux_loss = self._compute_aux_loss(router_logits, router_weights, selected_experts)
+
+        # 生成专家掩码
+        expert_mask = F.one_hot(selected_experts,num_classes=self.expert_number).to(torch.int32)  # shape是 (b * s, top_k, expert_number)
+        group_list = expert_mask.sum(dim=1)
+        group_list = group_list.permute(1, 0)
+        group_list = group_list.sum(dim=1)
+        expert_mask = expert_mask.permute(2, 1, 0)  # (expert_number, top_k, b * s)
+
+        return router_weights,  expert_mask, selected_experts, group_list, aux_loss
+
+# 专家ffn
+class FFN_npu_swiglu(torch.nn.Module):
+    def __init__(self, dim: int, hidden_dim: int, dtype=torch.bfloat16):
+        super().__init__()
+        self.w1 = torch.nn.Linear(dim, hidden_dim, bias=False)
+        self.w2 = torch.nn.Linear(hidden_dim, dim, bias=False)
+        self.w3 = torch.nn.Linear(dim, hidden_dim, bias=False)
+
+    def forward(self, x):
+        return self.w2(F.silu(self.w1(x)) * self.w3(x))
+

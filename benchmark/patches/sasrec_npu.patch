+def latency_summary(latency_list, batch_size, model_name, device_name, inductor_flag):
+    latency_array = np.array(latency_list)
+    avg_step = np.mean(latency_array, axis=0)
+    avg_time = np.mean(avg_step)
+    avg_step.sort()
+
+    if len(avg_step) > 0:
+        p90 = np.percentile(avg_step, 90, method="lower")
+        p95 = np.percentile(avg_step, 95, method="lower")
+        p99 = np.percentile(avg_step, 99, method="lower")
+        p999 = np.percentile(avg_step, 99.9, method="lower")
+
+    e2e_result = {
+        "Batch_size": batch_size,
+        "model_name": model_name,
+        "AVG Latency": avg_time,
+        "P999 Latency": p999,
+        "P99 Latency": p99,
+        "P95 Latency": p95,
+        "P90 Latency": p90,
+    }
+
+    model_detail_info = device_name + "_" + model_name + "_" + inductor_flag
+    output_str = "performance: " + model_detail_info + "_" + str(e2e_result)
+
+    os.makedirs(f"../../save_results_{device_name}/", exist_ok=True)
+    with open(f"../../save_results_{device_name}/performance_result.txt", "a", encoding="utf-8") as f:
+        f.write(output_str + "\n")
+
+    filtered_avg_step = avg_step[avg_step < p99]
+    if len(filtered_avg_step) == 0:
+        return avg_time
+
+    mean_below_p99 = np.mean(filtered_avg_step)

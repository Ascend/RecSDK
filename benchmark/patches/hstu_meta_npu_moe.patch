index 0000000000000000000000000000000000000000..7ef1465de2ddc67d71bd9481c50c38a3714318aa
--- /dev/null
+++ b/generative_recommenders/modules/moe_layer.py
@@ -0,0 +1,165 @@
+import torch
+import torch.nn.functional as F
+
+ENABLE_NPU=True
+try:
+    import torch_npu
+except ImportError as exc:
+    ENABLE_NPU = False
+    print(f"In GPU environment. Importing grouped_gemm ops.")
+    from grouped_gemm import ops
+
+class NPUGroupedMatmulFunction(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, weight, group_list):
+        weight_transposed = weight.transpose(-1, -2)
+        ctx.save_for_backward(x, weight_transposed, group_list)
+        return torch_npu.npu_grouped_matmul(
+            x=[x],
+            weight=[weight_transposed],
+            bias=None,
+            group_list=group_list,
+            split_item=2,
+            group_list_type=1,
+            group_type=0,
+            output_dtype=x.dtype,
+        )[0]
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        x, weight_transposed, group_list = ctx.saved_tensors
+        grad_output = grad_output.contiguous()
+        grad_x = torch_npu.npu_grouped_matmul(
+            x=[grad_output],
+            weight=[weight_transposed.transpose(-1, -2)],
+            bias=None,
+            group_list=group_list,
+            split_item=2,
+            group_list_type=1,
+            group_type=0,
+            output_dtype=x.dtype,
+        )[0]
+        grad_weight = torch_npu.npu_grouped_matmul(
+            x=[x.transpose(0, 1)],
+            weight=[grad_output],
+            bias=None,
+            group_list=group_list,
+            split_item=3,
+            group_list_type=1,
+            group_type=2,
+            output_dtype=weight_transposed.dtype,
+        )[0]
+
+        grad_weight = grad_weight.transpose(-1, -2)
+        return grad_x, grad_weight, None
+
+class MOERouter(torch.nn.Module):
+    def __init__(self, emb_dim, expert_number, top_k_number, aux_loss_weight=0.01):
+        super().__init__()
+        self.gate = torch.nn.Linear(emb_dim, expert_number)
+        self.expert_number = expert_number
+        self.top_k = top_k_number
+        self.aux_loss_weight = aux_loss_weight  # 辅助损失权重，可以根据需要调整
+
+    def forward(self, hidden_states):
+        # 计算路由logits
+        router_logits = F.softmax(self.gate(hidden_states),dim=-1)  # shape is (b * s, dim)
+
+        # 计算topk的专家的输出
+        router_weights, selected_experts = torch.topk(router_logits, self.top_k, dim=-1)  # shape都是 (b * s, top_k)
+
+        # 专家权重归一化
+        router_weights = router_weights / router_weights.sum(dim=-1, keepdim=True)
+
+        # 计算辅助损失
+        aux_loss = self.compute_aux_loss(router_logits, router_weights, selected_experts)
+
+        # 生成专家掩码
+        expert_mask = F.one_hot(selected_experts,num_classes=self.expert_number).to(torch.int32)  # shape是 (b * s, top_k, expert_number)
+        group_list = expert_mask.sum(dim=1).permute(1, 0).sum(dim=1)
+        expert_mask = expert_mask.permute(2, 1, 0)  # (expert_number, top_k, b * s)
+
+        return router_weights, expert_mask, selected_experts, group_list, aux_loss
+
+    def compute_aux_loss(self, router_logits, topk_weights, topk_indices):
+        num_experts = router_logits.size(-1)
+
+        # top-k索引转为 one-hot编码
+        topk_mask = F.one_hot(topk_indices, num_classes=num_experts).to(torch.float32)  # shape is (b * s, top_k, num_experts)
+
+        # 计算每个token分给每个专家的权重
+        expert_weights = (topk_mask * topk_weights.unsqueeze(-1)).sum(dim=1)  # shape is (b * s, num_experts)
+
+        f_i = expert_weights.mean(dim=0)  # 每个专家的平均权重
+        P_i = router_logits.mean(dim=0)  # 每个专家的平均路由概率
+
+        aux_loss = num_experts * torch.sum(f_i.detach() * P_i)  # 辅助损失计算公式
+
+        return aux_loss * self.aux_loss_weight
+
+class SparseMOE(torch.nn.Module):
+    def __init__(
+            self,
+            emb_dim,
+            expert_number,
+            top_k,
+            hidden_size,
+            aux_loss_weight=0.01,
+        ):
+        super().__init__()
+
+        self.expert_number = expert_number
+        self.top_k = top_k
+        self.router = MOERouter(emb_dim, expert_number, top_k, aux_loss_weight)
+        self.cw1 = torch.nn.Parameter(torch.empty((expert_number, hidden_size, emb_dim)))
+        self.cw2 = torch.nn.Parameter(torch.empty((expert_number, emb_dim, hidden_size)))
+        self.cw3 = torch.nn.Parameter(torch.empty((expert_number, hidden_size, emb_dim)))
+        self.init_weights()
+
+    def init_weights(self):
+        for param in [self.cw1, self.cw2, self.cw3]:
+            torch.nn.init.xavier_uniform_(param)
+
+    def _npu_grouped_gemm(self, x, weight, group_list):
+        return NPUGroupedMatmulFunction.apply(x, weight, group_list)
+
+    def compute_ffn_with_grouped_gemm(self, x, cw1, cw2, cw3, group_list):
+        if ENABLE_NPU:
+            w1_out = self._npu_grouped_gemm(x, cw1, group_list)
+            w3_out = self._npu_grouped_gemm(x, cw3, group_list)
+        else:
+            group_list_cpu =group_list.cpu()
+            w1_out = ops.gmm(x, cw1, group_list_cpu, trans_b=True)
+            w3_out = ops.gmm(x, cw3, group_list_cpu, trans_b=True)
+
+        gate = F.silu(w1_out)
+        combined = gate * w3_out
+
+        if ENABLE_NPU:
+            w2_out = self._npu_grouped_gemm(combined, cw2, group_list)
+        else:
+            w2_out = ops.gmm(combined, cw2, group_list_cpu, trans_b=True)
+
+        return w2_out
+
+    def forward(self, x):
+        seq_len, hidden_dim = x.size()
+        hidden_states = x.view(-1, hidden_dim)
+
+        router_weights, expert_mask, selected_experts, group_list, aux_loss = self.router(hidden_states)
+
+        if ENABLE_NPU:
+            expend_x, idx = torch_npu.npu_moe_token_permute(
+                tokens=x,
+                indices=selected_experts,
+                num_out_tokens=seq_len * self.top_k,
+            )
+        else:
+            expend_x, idx = ops.permute(x, selected_experts)
+
+        expand_permuted_rows = self.compute_ffn_with_grouped_gemm(expend_x, self.cw1, self.cw2, self.cw3, group_list)
+
+        if ENABLE_NPU:
+            return torch_npu.npu_moe_token_unpermute(expand_permuted_rows, idx, router_weights), aux_loss
+        else:
+            return ops.unpermute(expand_permuted_rows, idx, router_weights), aux_loss

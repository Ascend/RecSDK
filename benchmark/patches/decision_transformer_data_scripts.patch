@@ -0,0 +1,162 @@
+#!/usr/bin/env bash
+
+set -Eeuo pipefail
+
+# Single-node, multi-NPU FSDP2 launcher.
+#
+# Examples:
+#   bash scripts/run_fsdp2.sh
+#   NPROC_PER_NODE=4 BATCH_SIZE=4 bash scripts/run_fsdp2.sh
+#   RESUME=1 MODEL_DIR=./outputs/checkpoints/fsdp2 bash scripts/run_fsdp2.sh
+#   USE_BF16=0 MASTER_PORT=29600 bash scripts/run_fsdp2.sh
+
+# Both launchers live in scripts/, while run.py and runtime directories live
+# at the repository root.
+SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
+source ${SCRIPT_DIR}/scripts/multi_node_env.sh
+
+# Source the Ascend environment only when an explicit script is provided.
+# If single-NPU training already works in the current shell, this is unnecessary.
+if [[ -n "${ASCEND_ENV_SCRIPT:-}" ]]; then
+    if [[ ! -f "${ASCEND_ENV_SCRIPT}" ]]; then
+        echo "ASCEND_ENV_SCRIPT does not exist: ${ASCEND_ENV_SCRIPT}" >&2
+        exit 1
+    fi
+    # shellcheck disable=SC1090
+    source "${ASCEND_ENV_SCRIPT}"
+fi
+
+NPROC_PER_NODE="${NPROC_PER_NODE:-8}"
+VISIBLE_DEVICES=${VISIBLE_DEVICES:-"0,1,2,3,4,5,6,7"}
+export CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-$VISIBLE_DEVICES}
+export ASCEND_RT_VISIBLE_DEVICES=${ASCEND_RT_VISIBLE_DEVICES:-$VISIBLE_DEVICES}
+
+BATCH_SIZE="${BATCH_SIZE:-8}"
+MASTER_ADDR="${MASTER_ADDR:-127.0.0.1}"
+MASTER_PORT="${MASTER_PORT:-29500}"
+USE_BF16="${USE_BF16:-1}"
+ATTENTION_BACKEND="${ATTENTION_BACKEND:-eager}"
+RESUME="${RESUME:-0}"
+OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
+
+OUTPUT_DIR="${OUTPUT_DIR:-${SCRIPT_DIR}/outputs}"
+[[ "${OUTPUT_DIR}" = /* ]] || OUTPUT_DIR="${SCRIPT_DIR}/${OUTPUT_DIR}"
+
+DATA_DIR="${DATA_DIR:-${SCRIPT_DIR}/data/training_data_all-rlData.csv}"
+MODEL_DIR="${MODEL_DIR:-${OUTPUT_DIR}/checkpoints/fsdp2}"
+LOG_DIR="${LOG_DIR:-${OUTPUT_DIR}/logs/fsdp2/$(date +%Y%m%d_%H%M%S)}"
+PROFILER_OUT_DIR="${PROFILER_OUT_DIR:-${OUTPUT_DIR}/profiler/fsdp2}"
+
+# Interpret user-provided relative paths from the repository directory, not
+# from whichever directory happened to invoke this script.
+[[ "${DATA_DIR}" = /* ]] || DATA_DIR="${SCRIPT_DIR}/${DATA_DIR}"
+[[ "${MODEL_DIR}" = /* ]] || MODEL_DIR="${SCRIPT_DIR}/${MODEL_DIR}"
+[[ "${LOG_DIR}" = /* ]] || LOG_DIR="${SCRIPT_DIR}/${LOG_DIR}"
+[[ "${PROFILER_OUT_DIR}" = /* ]] || PROFILER_OUT_DIR="${SCRIPT_DIR}/${PROFILER_OUT_DIR}"
+
+if ! command -v torchrun >/dev/null 2>&1; then
+    echo "torchrun was not found in PATH" >&2
+    exit 1
+fi
+if [[ ! "${NPROC_PER_NODE}" =~ ^[1-9][0-9]*$ ]]; then
+    echo "NPROC_PER_NODE must be a positive integer, got: ${NPROC_PER_NODE}" >&2
+    exit 1
+fi
+if [[ ! "${BATCH_SIZE}" =~ ^[1-9][0-9]*$ ]]; then
+    echo "BATCH_SIZE must be a positive integer, got: ${BATCH_SIZE}" >&2
+    exit 1
+fi
+if [[ ! "${MASTER_PORT}" =~ ^[0-9]+$ ]] || (( MASTER_PORT < 1 || MASTER_PORT > 65535 )); then
+    echo "MASTER_PORT must be in [1, 65535], got: ${MASTER_PORT}" >&2
+    exit 1
+fi
+if [[ "${USE_BF16}" != "0" && "${USE_BF16}" != "1" ]]; then
+    echo "USE_BF16 must be 0 or 1, got: ${USE_BF16}" >&2
+    exit 1
+fi
+if [[ "${ATTENTION_BACKEND}" != "eager" && "${ATTENTION_BACKEND}" != "sdpa" && "${ATTENTION_BACKEND}" != "ascend" ]]; then
+    echo "ATTENTION_BACKEND must be eager, sdpa, or ascend, got: ${ATTENTION_BACKEND}" >&2
+    exit 1
+fi
+if [[ "${ATTENTION_BACKEND}" == "ascend" && "${USE_BF16}" != "1" ]]; then
+    echo "ATTENTION_BACKEND=ascend requires USE_BF16=1" >&2
+    exit 1
+fi
+if [[ "${RESUME}" != "0" && "${RESUME}" != "1" ]]; then
+    echo "RESUME must be 0 or 1, got: ${RESUME}" >&2
+    exit 1
+fi
+if [[ ! -f "${DATA_DIR}" ]]; then
+    echo "Training dataset does not exist: ${DATA_DIR}" >&2
+    exit 1
+fi
+
+if [[ "${RESUME}" == "1" ]]; then
+    if [[ ! -d "${MODEL_DIR}/decision_transformer_dcp" ]]; then
+        echo "FSDP2 checkpoint does not exist: ${MODEL_DIR}/decision_transformer_dcp" >&2
+        exit 1
+    fi
+    if [[ ! -f "${MODEL_DIR}/normalize_dict.pkl" ]]; then
+        echo "Normalization state does not exist: ${MODEL_DIR}/normalize_dict.pkl" >&2
+        exit 1
+    fi
+fi
+
+mkdir -p "${MODEL_DIR}" "${LOG_DIR}" "${PROFILER_OUT_DIR}"
+
+export OMP_NUM_THREADS
+export PYTHONUNBUFFERED=1
+export PYTHONPATH="${SCRIPT_DIR}${PYTHONPATH:+:${PYTHONPATH}}"
+export PROFILER_OUT_DIR
+
+TRAIN_ARGS=(
+    --use-fsdp2
+    --attention-backend "${ATTENTION_BACKEND}"
+    --mode train
+    --data-dir "${DATA_DIR}"
+    --modelsave-dir "${MODEL_DIR}"
+    --batch-size "${BATCH_SIZE}"
+)
+
+if [[ "${USE_BF16}" == "1" ]]; then
+    TRAIN_ARGS+=(--use-bf16)
+else
+    TRAIN_ARGS+=(--no-use-bf16)
+fi
+
+if [[ "${RESUME}" == "1" ]]; then
+    TRAIN_ARGS+=(--resume)
+fi
+
+NNODES="${NNODES:-1}"
+NODE_RANK="${NODE_RANK:-0}"
+
+GLOBAL_BATCH_SIZE=$((NPROC_PER_NODE * BATCH_SIZE))
+echo "Starting single-node FSDP2 training"
+echo "  NPU processes : ${NPROC_PER_NODE}"
+echo "  Batch per NPU : ${BATCH_SIZE}"
+echo "  Global batch  : ${GLOBAL_BATCH_SIZE}"
+echo "  Attention     : ${ATTENTION_BACKEND}"
+echo "  BF16          : ${USE_BF16}"
+echo "  Resume        : ${RESUME}"
+echo "  Output root   : ${OUTPUT_DIR}"
+echo "  Dataset       : ${DATA_DIR}"
+echo "  Checkpoint    : ${MODEL_DIR}"
+echo "  Logs          : ${LOG_DIR}"
+echo "  Profiler      : ${PROFILER_OUT_DIR}"
+echo "  Rendezvous    : ${MASTER_ADDR}:${MASTER_PORT}"
+
+cd "${SCRIPT_DIR}"
+
+exec torchrun \
+    --nnodes="${NNODES}" \
+    --nproc-per-node="${NPROC_PER_NODE}" \
+    --node-rank="${NODE_RANK}" \
+    --master-addr="${MASTER_ADDR}" \
+    --master-port="${MASTER_PORT}" \
+    --max-restarts=0 \
+    --log-dir="${LOG_DIR}" \
+    --tee=3 \
+    "${SCRIPT_DIR}/main.py" \
+    "${TRAIN_ARGS[@]}" \
+    "$@"

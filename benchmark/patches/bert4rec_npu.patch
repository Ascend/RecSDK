+def str_to_bool(s):
+    if isinstance(s, bool):
+        return s
+    if s is None:
+        raise ValueError("Invalid input value: None, must be true/false")
+    normalized = str(s).strip().lower()
+    if normalized in ('true', '1', 'yes', 'y', 'on'):
+        return True
+    if normalized in ('false', '0', 'no', 'n', 'off'):
+        return False
+    raise ValueError(f"Invalid input string: {s}, must be true/false")
+

+                for step in range(steps):
+                    for batch_data in data_generator:
+                        return_dict = self.forward(batch_data)
+                        y_pred.extend(return_dict["y_pred"].data.cpu().numpy().reshape(-1))
+                        prof.step()
             y_pred = np.array(y_pred, np.float64)
             return y_pred
 

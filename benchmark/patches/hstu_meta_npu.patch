+class FusedIndexSelect(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, index):
+        result = torch.index_select(x, dim=0, index=index)
+        ctx.save_for_backward(x, index)
+        return result
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        x, index = ctx.saved_tensors
+        grad_x, grad_index = torch.ops.mxrec.index_select_for_rank1_backward(
+            grad_output, x, index
+        )
+        return grad_x, grad_index
+

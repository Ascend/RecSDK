+from __future__ import annotations
+
+import ast
+import random
+
+import torch
+import pandas as pd
+import numpy as np
+from typing import Any, Dict, Iterator, TYPE_CHECKING
+from torch.utils.data import Dataset, Sampler
+
+if TYPE_CHECKING:
+    from model import DecisionTransformerConfig
+
+
+class ReplayBuffer(Dataset):
+    def __init__(
+        self,
+        state_dim: int,
+        act_dim: int,
+        data_path: str,
+        config: DecisionTransformerConfig,
+        extra: Dict[str, Any],
+        max_eplen: int = 24,
+        return_scale: float = 2_000.0,
+        context_len: int = 20,
+    ) -> None:
+        super(ReplayBuffer, self).__init__()
+
+        self.max_ep_len = max_eplen
+        self.scale = return_scale
+
+        self.state_dim = state_dim
+        self.act_dim = act_dim
+        if self.act_dim != 1:
+            raise ValueError(
+                f"expect act_dim == 1, but got act_dim = {self.act_dim}"
+            )
+
+        self.context_len = context_len
+        training_data = pd.read_csv(data_path)
+
+        def safe_literal_eval(val: Any) -> Any:
+            if pd.isna(val):
+                return val
+            try:
+                return ast.literal_eval(val)
+            except (ValueError, SyntaxError):
+                return val
+
+        training_data["state"] = training_data["state"].apply(safe_literal_eval)
+        training_data["next_state"] = training_data["next_state"].apply(
+            safe_literal_eval
+        )
+        self.trajectories = training_data
+
+        self.states, self.rewards, self.actions = [], [], []
+        self.returns, self.traj_lens, self.dones = [], [], []
+        _state, _reward, _action, _dones = [], [], [], []
+        for _, row in self.trajectories.iterrows():
+            _state.append(row["state"])
+            _reward.append(row["reward"])
+            _action.append(row["action"])
+            _dones.append(row["done"])
+            if row["done"]:
+                # 单步 Episode 被丢弃
+                if len(_state) != 1:
+                    self.states.append(np.array(_state))
+                    self.rewards.append(np.expand_dims(np.array(_reward), axis=1))
+                    self.actions.append(
+                        np.expand_dims(np.array(_action), axis=1)
+                    )  # TODO 可能生成错误的 [T,1,A]
+                    self.returns.append(sum(_reward))
+                    self.traj_lens.append(len(_state))
+                    self.dones.append(np.array(_dones))
+                _state, _reward, _action, _dones = [], [], [], []
+        self.traj_lens, self.returns = np.array(self.traj_lens), np.array(self.returns)
+
+        tmp_states = np.concatenate(self.states, axis=0)
+        self.state_mean, self.state_std = (
+            np.mean(tmp_states, axis=0),
+            np.std(tmp_states, axis=0) + 1e-6,
+        )
+
+        self.trajectories = []
+        for i, state in enumerate(self.states):
+            self.trajectories.append(
+                {
+                    "observations": state,
+                    "actions": self.actions[i],
+                    "rewards": self.rewards[i],
+                    "dones": self.dones[i],
+                }
+            )
+
+        num_timesteps = max(sum(self.traj_lens), 1)
+        sorted_inds = np.argsort(self.returns, kind="stable")
+
+        num_trajectories = 1
+        timesteps = self.traj_lens[sorted_inds[-1]]
+        ind = len(self.trajectories) - 2
+        while (
+            ind >= 0 and timesteps + self.traj_lens[sorted_inds[ind]] <= num_timesteps
+        ):
+            timesteps += self.traj_lens[sorted_inds[ind]]
+            num_trajectories += 1
+            ind -= 1
+        self.sorted_inds = sorted_inds[-num_trajectories:]
+        self.p_sampler = self.traj_lens[self.sorted_inds] / sum(
+            self.traj_lens[self.sorted_inds]
+        )
+
+    def discount_cumsum(self, x: Any, gamma: float = 1.0) -> Any:
+        discount_cumsum = np.zeros_like(x)
+        discount_cumsum[-1] = x[-1]
+        for t in reversed(range(x.shape[0] - 1)):
+            discount_cumsum[t] = x[t] + gamma * discount_cumsum[t + 1]
+        return discount_cumsum
+
+    def __getitem__(self, index: int | tuple[int, int]) -> Any:
+        if isinstance(index, tuple):
+            trajectory_index, start_t = index
+        else:
+            trajectory_index = index
+            start_t = None
+
+        traj = self.trajectories[int(self.sorted_inds[trajectory_index])]
+        if start_t is None:
+            start_t = random.randint(0, traj["rewards"].shape[0] - 1)
+        elif not 0 <= start_t < traj["rewards"].shape[0]:
+            raise IndexError(
+                f"start_t {start_t} is outside trajectory length "
+                f"{traj['rewards'].shape[0]}"
+            )
+
+        import os
+        if os.getenv("P_TEST", "0") == "1":
+            start_t = 0
+
+        s = traj["observations"][start_t : start_t + self.context_len]
+        a = traj["actions"][start_t : start_t + self.context_len]
+        r = traj["rewards"][start_t : start_t + self.context_len].reshape(-1, 1)
+        d = (
+            traj["terminals"][start_t : start_t + self.context_len]
+            if "terminals" in traj
+            else traj["dones"][start_t : start_t + self.context_len]
+        )
+
+        timesteps = np.arange(start_t, start_t + s.shape[0])
+        timesteps[timesteps >= self.max_ep_len] = self.max_ep_len - 1  # padding cutoff
+        rtg = self.discount_cumsum(traj["rewards"][start_t:], gamma=1.0)[
+            : s.shape[0] + 1
+        ].reshape(-1, 1)
+        if rtg.shape[0] <= s.shape[0]:
+            rtg = np.concatenate([rtg, np.zeros((1, 1))], axis=0)
+
+        tlen = s.shape[0]
+        s = np.concatenate(
+            [np.zeros((self.context_len - tlen, self.state_dim)), s], axis=0
+        )
+        s = (s - self.state_mean) / self.state_std
+        a = np.concatenate(
+            [np.ones((self.context_len - tlen, self.act_dim)) * -10.0, a], axis=0
+        )
+        r = np.concatenate([np.zeros((self.context_len - tlen, 1)), r], axis=0)
+        r = r / self.scale
+        d = np.concatenate([np.ones((self.context_len - tlen)) * 2, d], axis=0)
+        rtg = (
+            np.concatenate([np.zeros((self.context_len - tlen, 1)), rtg], axis=0)
+            / self.scale
+        )
+        timesteps = np.concatenate(
+            [np.zeros((self.context_len - tlen)), timesteps], axis=0
+        )
+        mask = np.concatenate(
+            [np.zeros((self.context_len - tlen)), np.ones((tlen))], axis=0
+        )
+
+        # Dataset workers and default_collate must stay on CPU. The complete
+        # batch is transferred to the current rank's device in the training or
+        # evaluation loop, avoiding one device copy per field per sample and
+        # avoiding device-side default_collate stacks.
+        s = torch.from_numpy(np.ascontiguousarray(s, dtype=np.float32))
+        a = torch.from_numpy(np.ascontiguousarray(a, dtype=np.float32))
+        r = torch.from_numpy(np.ascontiguousarray(r, dtype=np.float32))
+        d = torch.from_numpy(np.ascontiguousarray(d, dtype=np.int64))
+        rtg = torch.from_numpy(np.ascontiguousarray(rtg, dtype=np.float32))
+        timesteps = torch.from_numpy(
+            np.ascontiguousarray(timesteps, dtype=np.int64)
+        )
+        mask = torch.from_numpy(np.ascontiguousarray(mask, dtype=np.bool_))
+
+        return s, a, r, d, rtg, timesteps, mask
+
+    def __len__(self) -> int:
+        return len(self.sorted_inds)
+
+
+class TPTrajectoryWindowSampler(Sampler[tuple[int, int]]):
+    """Generate identical trajectory/window pairs on every rank in a TP group."""
+
+    def __init__(
+        self,
+        replay_buffer: ReplayBuffer,
+        *,
+        seed: int,
+        num_samples: int | None = None,
+        weights: Any = None,
+    ) -> None:
+        self.replay_buffer = replay_buffer
+        self.num_samples = len(replay_buffer) if num_samples is None else num_samples
+        if self.num_samples < 0:
+            raise ValueError("num_samples must be non-negative")
+
+        self.weights = (
+            None
+            if weights is None
+            else torch.as_tensor(weights, dtype=torch.double, device="cpu")
+        )
+        if self.weights is not None and self.weights.numel() != len(replay_buffer):
+            raise ValueError(
+                "weights length must match replay buffer length: "
+                f"{self.weights.numel()} != {len(replay_buffer)}"
+            )
+
+        # This generator is deliberately independent of model/dropout RNG state.
+        # Every TP rank constructs it with the same seed and advances it identically.
+        self.generator = torch.Generator(device="cpu")
+        self.generator.manual_seed(seed)
+
+    def __iter__(self) -> Iterator[tuple[int, int]]:
+        if self.weights is None:
+            trajectory_indices = range(len(self.replay_buffer))
+        else:
+            trajectory_indices = torch.multinomial(
+                self.weights,
+                self.num_samples,
+                replacement=True,
+                generator=self.generator,
+            ).tolist()
+
+        for trajectory_index in trajectory_indices:
+            trajectory = self.replay_buffer.trajectories[
+                int(self.replay_buffer.sorted_inds[trajectory_index])
+            ]
+            trajectory_length = int(trajectory["rewards"].shape[0])
+            start_t = int(
+                torch.randint(
+                    trajectory_length,
+                    (1,),
+                    generator=self.generator,
+                ).item()
+            )
+            yield int(trajectory_index), start_t
+
+    def __len__(self) -> int:
+        return self.num_samples

+from __future__ import annotations
+
+import math
+import torch
+import torch.nn.functional as F
+from dataclasses import dataclass
+
+
+@dataclass
+class AttentionConfig:
+    d_model: int = 1024
+    d_hidden: int = 4096
+    n_head: int = 1
+    attn_dropout: float = 0.1
+    resid_dropout: float = 0.1
+    n_ctx: int = 1024
+    n_layer: int = 8
+    activation_function: str = "relu"
+    attention_backend: str = "eager"
+    n_position: int = 1024
+
+    def __post_init__(self) -> None:
+        if self.d_model % self.n_head != 0:
+            raise ValueError(
+                f"d_model ({self.d_model}) must be divisible by n_head ({self.n_head})"
+            )
+        self.attention_backend = self.attention_backend.lower()
+        supported_backends = {"eager", "sdpa", "ascend"}
+        if self.attention_backend not in supported_backends:
+            raise ValueError(
+                f"unsupported attention_backend {self.attention_backend!r}; "
+                f"expected one of {sorted(supported_backends)}"
+            )
+
+
+def _create_activation(name: str) -> torch.nn.Module:
+    activations = {
+        "relu": torch.nn.ReLU,
+        "gelu": torch.nn.GELU,
+        "silu": torch.nn.SiLU,
+    }
+    normalized_name = name.lower()
+    if normalized_name not in activations:
+        raise ValueError(
+            f"unsupported activation_function {name!r}; "
+            f"expected one of {sorted(activations)}"
+        )
+    return activations[normalized_name]()
+
+
+class CausalSelfAttention(torch.nn.Module):
+    def __init__(self, config: AttentionConfig) -> None:
+        super().__init__()
+        self.n_head = config.n_head
+        self.d_model = config.d_model
+        self.n_ctx = config.n_ctx
+        self.attention_backend = config.attention_backend
+        if self.d_model % self.n_head != 0:
+            raise ValueError(
+                f"d_model {self.d_model} is not divisable by n_head {self.n_head}"
+            )
+        self.d_head = self.d_model // self.n_head
+
+        self.qkv = torch.nn.Linear(self.d_model, 3 * self.d_model)
+        self.attn_dropout = torch.nn.Dropout(config.attn_dropout)
+        self.resid_dropout = torch.nn.Dropout(config.resid_dropout)
+
+        self.register_buffer(
+            "bias",
+            torch.tril(torch.ones(self.n_ctx, self.n_ctx)).view(
+                1, 1, self.n_ctx, self.n_ctx
+            ),
+        )
+
+        self.proj = torch.nn.Linear(self.d_model, self.d_model)
+
+    def _eager_attention(
+        self,
+        q: torch.Tensor,
+        k: torch.Tensor,
+        v: torch.Tensor,
+        mask: torch.Tensor | None,
+    ) -> torch.Tensor:
+        seq_len = q.shape[-2]
+        attn = q @ k.transpose(-2, -1)
+        attn = attn * (1.0 / math.sqrt(self.d_head))
+
+        causal_mask = self.bias[:, :, :seq_len, :seq_len]
+        mask_value = torch.finfo(attn.dtype).min
+        attn = attn.masked_fill(causal_mask == 0, mask_value)
+
+        if mask is not None:
+            key_mask = mask[:, None, None, :]
+            attn = attn.masked_fill(key_mask == 0, mask_value)
+
+        attn = F.softmax(attn, dim=-1)
+        if mask is not None:
+            query_mask = mask[:, None, :, None].to(dtype=attn.dtype)
+            attn = attn * query_mask
+        return self.attn_dropout(attn) @ v
+
+    def _sdpa_attention(
+        self,
+        q: torch.Tensor,
+        k: torch.Tensor,
+        v: torch.Tensor,
+        mask: torch.Tensor | None,
+    ) -> torch.Tensor:
+        seq_len = q.shape[-2]
+        dropout_p = self.attn_dropout.p if self.training else 0.0
+
+        if mask is None:
+            return F.scaled_dot_product_attention(
+                q,
+                k,
+                v,
+                dropout_p=dropout_p,
+                is_causal=True,
+                scale=1.0 / math.sqrt(self.d_head),
+            )
+
+        causal_mask = self.bias[:, :, :seq_len, :seq_len].bool()
+        key_mask = mask[:, None, None, :].bool()
+        output = F.scaled_dot_product_attention(
+            q,
+            k,
+            v,
+            attn_mask=causal_mask & key_mask,
+            dropout_p=dropout_p,
+            is_causal=False,
+            scale=1.0 / math.sqrt(self.d_head),
+        )
+        query_mask = mask[:, None, :, None].to(dtype=output.dtype)
+        return output * query_mask
+
+    def _ascend_attention(
+        self,
+        q: torch.Tensor,
+        k: torch.Tensor,
+        v: torch.Tensor,
+        mask: torch.Tensor | None,
+    ) -> torch.Tensor:
+        if q.device.type != "npu":
+            raise RuntimeError(
+                "attention_backend='ascend' requires tensors on an NPU device"
+            )
+        if q.dtype not in (torch.float16, torch.bfloat16):
+            raise RuntimeError(
+                "Ascend fused attention requires float16 or bfloat16 inputs; "
+                "enable --use-bf16 for TP"
+            )
+
+        try:
+            import torch_npu  # type: ignore
+        except ImportError as error:
+            raise RuntimeError(
+                "attention_backend='ascend' requires torch_npu"
+            ) from error
+
+        seq_len = q.shape[-2]
+        local_n_head = q.shape[1]
+        causal_mask = ~self.bias[:, :, :seq_len, :seq_len].bool()
+        if mask is not None:
+            key_mask = ~mask[:, None, None, :].bool()
+            causal_mask = causal_mask | key_mask
+
+        keep_prob = 1.0 - self.attn_dropout.p if self.training else 1.0
+        output = torch_npu.npu_fusion_attention(
+            q,
+            k,
+            v,
+            local_n_head,
+            "BNSD",
+            atten_mask=causal_mask,
+            scale=1.0 / math.sqrt(self.d_head),
+            keep_prob=keep_prob,
+            sparse_mode=0,
+        )[0]
+        if mask is not None:
+            query_mask = mask[:, None, :, None].to(dtype=output.dtype)
+            output = output * query_mask
+        return output
+
+    def forward(
+        self, x: torch.Tensor, mask: torch.Tensor | None = None
+    ) -> torch.Tensor:
+        batch_size, seq_len, d_model = x.shape
+        if d_model % self.n_head != 0:
+            raise ValueError("WRONG: input d_model % n_head != 0.")
+        qkv = self.qkv(x)
+        local_qkv_width = qkv.shape[-1]
+        head_qkv_width = 3 * self.d_head
+        if local_qkv_width % head_qkv_width != 0:
+            raise RuntimeError(
+                "local QKV width must contain complete attention heads: "
+                f"{local_qkv_width} % {head_qkv_width} != 0"
+            )
+        local_n_head = local_qkv_width // head_qkv_width
+        local_width = local_n_head * self.d_head
+
+        qkv: torch.Tensor = qkv.view(
+            batch_size, seq_len, local_n_head, 3, self.d_head
+        ).permute(3, 0, 2, 1, 4).contiguous()
+        q, k, v = qkv.unbind(dim=0)
+
+        if self.attention_backend == "eager":
+            x = self._eager_attention(q, k, v, mask)
+        elif self.attention_backend == "sdpa":
+            x = self._sdpa_attention(q, k, v, mask)
+        else:
+            x = self._ascend_attention(q, k, v, mask)
+
+        x = x.transpose(1, 2).contiguous().view(batch_size, seq_len, local_width)
+        x = self.resid_dropout(self.proj(x))
+        return x
+
+
+class FeedForward(torch.nn.Module):
+    def __init__(self, config: AttentionConfig) -> None:
+        super().__init__()
+        self.fc1 = torch.nn.Linear(config.d_model, config.d_hidden)
+        self.activation = _create_activation(config.activation_function)
+        self.fc2 = torch.nn.Linear(config.d_hidden, config.d_model)
+        self.dropout = torch.nn.Dropout(config.resid_dropout)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return self.dropout(self.fc2(self.activation(self.fc1(x))))
+
+
+class Block(torch.nn.Module):
+    def __init__(self, config: AttentionConfig) -> None:
+        """Pre-LayerNorm Transformer Block"""
+
+        super().__init__()
+        self.d_model = config.d_model
+        self.d_hidden = config.d_hidden
+
+        self.attn = CausalSelfAttention(config=config)
+        self.mlp = FeedForward(config=config)
+
+    def forward(self, x: torch.Tensor, attention_mask: torch.Tensor) -> torch.Tensor:
+        residual = x
+        x = torch.nn.functional.layer_norm(x, (self.d_model,))
+        attn_output = self.attn(x, attention_mask)
+
+        x = residual + attn_output
+        residual = x
+        x = torch.nn.functional.layer_norm(x, (self.d_model,))
+        mlp_output = self.mlp(x)
+
+        return residual + mlp_output

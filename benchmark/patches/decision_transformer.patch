+from __future__ import annotations
+
+import os
+import torch
+import torch.nn.functional as F
+from contextlib import nullcontext
+from typing import Dict, Any, NamedTuple
+from dataclasses import dataclass
+
+from .components import AttentionConfig, Block
+
+
+@dataclass
+class DecisionTransformerConfig:
+    device: torch.device
+    state_dim: int
+    act_dim: int
+    attention_config: AttentionConfig
+    scale: float
+    target_return: Any
+    length_times: Any
+
+    hf32: bool
+    compile: bool
+    graph: bool
+    shape_handle: bool
+
+    modelsave_dir: str
+
+    learning_rate: float
+
+    use_distribution: bool
+    rank: int
+    world_size: int
+    use_bf16: bool = True
+
+    def __post_init__(self) -> None:
+        if self.length_times != 3:
+            raise ValueError(
+                "length_times must be 3 for return/state/action token interleaving"
+            )
+        if self.attention_config.n_ctx % self.length_times != 0:
+            raise ValueError(
+                "attention_config.n_ctx must be divisible by length_times: "
+                f"{self.attention_config.n_ctx} % {self.length_times} != 0"
+            )
+
+    @property
+    def hidden_size(self) -> int:
+        return self.attention_config.d_model
+
+    @property
+    def max_length(self) -> int:
+        return self.attention_config.n_ctx // self.length_times
+
+    @property
+    def max_ep_len(self) -> int:
+        return self.attention_config.n_position
+
+
+class DecisionTransformerInput(NamedTuple):
+    """FSDP-friendly container for floating-point forward inputs.
+
+    FSDP recursively visits standard tuple containers when applying
+    ``MixedPrecisionPolicy.cast_forward_inputs``. Using a ``NamedTuple``
+    keeps attribute access while allowing states/actions/rewards/RTG to be
+    cast to the mixed-precision parameter dtype before ``forward`` runs.
+    """
+
+    states: torch.Tensor
+    actions: torch.Tensor
+    rewards: torch.Tensor
+    returns_to_go: torch.Tensor
+    timesteps: torch.Tensor
+    attention_mask: torch.Tensor | None
+
+
+@dataclass
+class DecisionTransformerBatch:
+    states: torch.Tensor
+    actions: torch.Tensor
+    rewards: torch.Tensor
+    rtg: torch.Tensor
+    timesteps: Any
+    attention_mask: torch.Tensor
+
+    def to_decision_transformer_input(self) -> DecisionTransformerInput:
+        if self.rtg.shape[1] < self.states.shape[1]:
+            raise RuntimeError(f"WRONG: {self.rtg.shape[1]} < {self.states.shape[1]}")
+        return DecisionTransformerInput(
+            states=self.states,
+            actions=self.actions,
+            rewards=self.rewards,
+            returns_to_go=self.rtg[:, : self.states.shape[1]],
+            timesteps=self.timesteps,
+            attention_mask=self.attention_mask,
+        )
+
+
+def _masked_mse(
+    predictions: torch.Tensor,
+    targets: torch.Tensor,
+    valid_mask: torch.Tensor,
+) -> torch.Tensor:
+    """Compute masked MSE with FP32 arithmetic on every accelerator.
+
+    Selecting valid elements avoids multiplying errors by a zero/one mask, and
+    ``F.mse_loss`` leaves the reduction and normalization to one native loss
+    operator instead of a device-dependent chain of sum/multiply/divide ops.
+    """
+    if predictions.shape != targets.shape:
+        raise ValueError(
+            "prediction and target shapes mismatch: "
+            f"{predictions.shape} != {targets.shape}"
+        )
+    if predictions.shape[:-1] != valid_mask.shape:
+        raise ValueError(
+            "mask shape must match [B, T]: "
+            f"{valid_mask.shape} != {predictions.shape[:-1]}"
+        )
+
+    element_mask = valid_mask.to(dtype=torch.bool).unsqueeze(-1).expand_as(predictions)
+    valid_predictions = predictions.float().masked_select(element_mask)
+    valid_targets = targets.float().masked_select(element_mask)
+

+from __future__ import annotations
+
+import math
+from typing import Any, TYPE_CHECKING
+
+import torch
+from torch.distributed import is_initialized
+from torch.distributed.device_mesh import DeviceMesh
+from torch.distributed.fsdp import (
+    FSDPModule,
+    MixedPrecisionPolicy,
+    fully_shard,
+)
+from torch.distributed.tensor.parallel import (
+    ColwiseParallel,
+    RowwiseParallel,
+    parallelize_module,
+)
+
+if TYPE_CHECKING:
+    from .decision_transformer import DecisionTransformer
+
+def decision_transformer_apply_ddp(
+    
+) -> Any:
+    pass
+
+def decision_transformer_apply_fsdp2(
+    model: DecisionTransformer,
+    *,
+    mesh: Any = None,
+    use_bf16: bool = False,
+) -> Any:
+    if not is_initialized():
+        raise RuntimeError(
+            "torch.distributed must be initialized before applying FSDP2"
+        )
+
+    if isinstance(model, FSDPModule):
+        return model
+    if model.optimizer is not None or model.scheduler is not None:
+        raise RuntimeError("apply FSDP2 before create_optimizer()")
+
+    mp_policy = MixedPrecisionPolicy(
+        param_dtype=torch.bfloat16 if use_bf16 else None,
+        reduce_dtype=torch.float32 if use_bf16 else None,
+        cast_forward_inputs=True,
+    )
+    fsdp_kwargs = {"mesh": mesh, "mp_policy": mp_policy}
+
+    for block in model.transformer:
+        fully_shard(block, **fsdp_kwargs)
+    fully_shard(model, **fsdp_kwargs)
+    return model
+
+
+def decision_transformer_apply_tp(
+    model: DecisionTransformer,
+    *,
+    tp_mesh: DeviceMesh,
+) -> DecisionTransformer:
+    tp_size = tp_mesh.size()
+    config = model.block_config
+
+    if config.d_model % tp_size != 0:
+        raise ValueError(f"d_model {config.d_model} must be divisible by tp_size {tp_size}")
+    if config.d_hidden % tp_size != 0:
+        raise ValueError(f"d_hidden {config.d_hidden} must be divisible by tp_size {tp_size}")
+    if config.n_head % tp_size != 0:
+        raise ValueError(f"n_head {config.n_head} must be divisible by tp_size {tp_size}")
+
+    if model.optimizer is not None:
+        raise RuntimeError(
+            "Tensor parallelism must be configured before optimizer creation; "
+            "please apply TP before instantiating the optimizer."
+        )
+
+    for block in model.transformer:
+        parallelize_module(
+            block,
+            tp_mesh,
+            {
+                "attn.qkv": ColwiseParallel(),
+                "attn.proj": RowwiseParallel(),
+                "mlp.fc1": ColwiseParallel(),
+                "mlp.fc2": RowwiseParallel(),
+            },
+        )
+    model.tensor_parallel = True
+    model.tp_mesh = tp_mesh
+    return model
+
+
+@torch.no_grad()
+def tensor_parallel_clip_grad_norm_(
+    parameters: Any,
+    max_norm: float,
+    tp_mesh: DeviceMesh,
+    norm_type: float = 2.0,
+    error_if_nonfinite: bool = False,
+) -> torch.Tensor:
+    """Clip a mixed replicated-Tensor/sharded-DTensor TP model by global norm."""
+
+    from torch.distributed.tensor import DTensor
+
+    if tp_mesh.ndim != 1:
+        raise ValueError(
+            f"TP gradient clipping requires a 1-D mesh, got {tp_mesh.ndim}-D"
+        )
+
+    parameters = list(parameters)
+    gradients = [parameter.grad for parameter in parameters if parameter.grad is not None]
+    if not gradients:
+        return torch.tensor(0.0)
+
+    max_norm = float(max_norm)
+    norm_type = float(norm_type)
+    if max_norm < 0:
+        raise ValueError(f"max_norm must be non-negative, got {max_norm}")
+    if norm_type <= 0:
+        raise ValueError(f"norm_type must be positive, got {norm_type}")
+
+    first_gradient = gradients[0]
+    first_local_gradient = (
+        first_gradient.to_local()
+        if isinstance(first_gradient, DTensor)
+        else first_gradient
+    )
+    accumulator_device = first_local_gradient.device
+
+    replicated_norm = torch.zeros((), dtype=torch.float32, device=accumulator_device)
+    sharded_norm = torch.zeros((), dtype=torch.float32, device=accumulator_device)
+    infinity_norm = math.isinf(norm_type)
+
+    local_gradients = []
+    for gradient in gradients:
+        is_sharded = False
+        if isinstance(gradient, DTensor):
+            if gradient.device_mesh != tp_mesh:
+                raise ValueError("gradient DTensor uses a different device mesh")
+            if any(placement.is_partial() for placement in gradient.placements):
+                raise RuntimeError(
+                    "TP gradient clipping does not accept Partial DTensor gradients"
+                )
+            is_sharded = any(placement.is_shard() for placement in gradient.placements)
+            local_gradient = gradient.to_local()
+        else:
+            local_gradient = gradient
+
+        local_gradients.append(local_gradient)
+        gradient_float = local_gradient.detach().float()
+        if infinity_norm:
+            contribution = gradient_float.abs().max()
+            if is_sharded:
+                sharded_norm = torch.maximum(sharded_norm, contribution)
+            else:
+                replicated_norm = torch.maximum(replicated_norm, contribution)
+        else:
+            contribution = gradient_float.abs().pow(norm_type).sum()
+            if is_sharded:
+                sharded_norm += contribution
+            else:
+                replicated_norm += contribution
+
+    reduce_op = (
+        torch.distributed.ReduceOp.MAX
+        if infinity_norm
+        else torch.distributed.ReduceOp.SUM
+    )
+    torch.distributed.all_reduce(sharded_norm, op=reduce_op, group=tp_mesh.get_group())
+

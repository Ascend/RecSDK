+        ).upper()
+        attention_backend = str(
+            extra.get("attention_backend", "eager")
+        ).lower()
+        final_result = {
+            "dataset_name": dataset_name,
+            "batch_size": batch_size,
+            "epoch": num_epochs,
+            "step": model.global_step,

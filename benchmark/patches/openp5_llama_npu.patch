+"""Prepare checksum-pinned OpenLLaMA 3B v2 and OpenP5 ML-1M assets."""
+
+import argparse
+import hashlib
+import os
+import shutil
+import urllib.error
+import urllib.request
+from pathlib import Path
+
+
+MODEL_REVISION = "438acbcd9f8227aaddf615fca50b95c2f5b506d3"
+MODEL_BASE_URL = f"https://www.modelscope.cn/models/openlm-research/open_llama_3b_v2/resolve/{MODEL_REVISION}"
+MODEL_SHA256 = {
+    "config.json": "c92b16f305e2a41c27bcc8ff882499f3c9fe7253ca1eeda2573850d7998ee2af",
+    "generation_config.json": "1178f82937d00cf2b805a74c57d9eaad593ba4ec34c45b2538cbb1ddf9d4e98a",
+    "pytorch_model.bin": "32268cfa47263b8abef86c9238e3ec7d64faabde504413b8e0a4d56002d76ec0",
+    "special_tokens_map.json": "3833453daeb8222e7a04fc85758cfe429dab30f5fc901d18d389105c501784ad",
+    "tokenizer.model": "91b289e85fa20fd375d8b33dc12f77616f18abc6359804471d1fafcb425fecb8",
+    "tokenizer_config.json": "5a979515b1e98186bdceb56439d17f24bfa68baa669e50e150cc3933c07da3a2",
+}
+DATA_URL = (
+    "https://drive.usercontent.google.com/download?id=1beb14fh-lPxd-yKLU1KVCIP2HuKvKNF3&export=download&confirm=t"
+)
+DATA_SHA256 = "48173f671aad6240aa765f4a5e0e97fb1a0bd9688001be6b7bca59a67dcaf46c"
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--asset-root", default="adaptation/assets")
+    parser.add_argument("--source-root", default=os.getenv("OPENP5_ASSET_SOURCE"))
+    return parser.parse_args()
+
+
+def sha256_file(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def copy_prepared(source_root, asset_root):
+    for relative in (Path("open_llama_3b_v2"), Path("data/ML1M")):
+        source = Path(source_root) / relative
+        if not source.is_dir():
+            raise FileNotFoundError(f"Prepared asset directory not found: {source}")
+        destination = asset_root / relative
+        destination.mkdir(parents=True, exist_ok=True)
+        for path in source.iterdir():
+            if path.is_file():
+                shutil.copy2(path, destination / path.name)
+
+
+def download(url, destination, expected):
+    temporary = destination.with_suffix(destination.suffix + ".download")
+    if temporary.exists() and sha256_file(temporary) == expected:
+        temporary.replace(destination)
+        return
+    offset = temporary.stat().st_size if temporary.exists() else 0
+    request = urllib.request.Request(url)
+    if offset:
+        request.add_header("Range", f"bytes={offset}-")
+    try:
+        response = urllib.request.urlopen(request, timeout=300)
+    except urllib.error.HTTPError as exc:
+        if exc.code != 416 or not offset:
+            raise
+        temporary.unlink()
+        return download(url, destination, expected)
+    with response:
+        if offset and response.status != 206:
+            temporary.unlink()
+            return download(url, destination, expected)
+        content_type = response.headers.get_content_type()
+        if content_type in {"text/html", "application/xhtml+xml"}:
+            raise ValueError(f"Unexpected download content type {content_type}: {url}")
+        if offset and not response.headers.get("Content-Range", "").startswith(f"bytes {offset}-"):
+            raise ValueError(f"Invalid Content-Range for resumed download: {url}")
+        with temporary.open("ab" if offset else "wb") as output:
+            shutil.copyfileobj(response, output)
+    temporary.replace(destination)
+
+
+def main():
+    args = parse_args()
+    asset_root = Path(args.asset_root)
+    if args.source_root:
+        copy_prepared(args.source_root, asset_root)
+    model_root = asset_root / "open_llama_3b_v2"
+    data_root = asset_root / "data/ML1M"
+    model_root.mkdir(parents=True, exist_ok=True)
+    data_root.mkdir(parents=True, exist_ok=True)
+    for filename, expected in MODEL_SHA256.items():
+        path = model_root / filename
+        if not path.exists():
+            download(f"{MODEL_BASE_URL}/{filename}", path, expected)
+        actual = sha256_file(path)
+        if actual != expected:
+            raise ValueError(f"Checksum mismatch for {path}: {actual}")
+    sequence = data_root / "user_sequence.txt"
+    if not sequence.exists():
+        download(DATA_URL, sequence, DATA_SHA256)
+    actual = sha256_file(sequence)
+    if actual != DATA_SHA256:
+        raise ValueError(f"Checksum mismatch for {sequence}: {actual}")
+    print(f"Validated OpenLLaMA assets in {model_root}")
+    print(f"Validated ML-1M assets in {data_root}")
+
+
+if __name__ == "__main__":
+    main()

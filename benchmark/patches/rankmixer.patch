+class NPUGroupedMatmulFunction(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, weight, bias, group_list):
+        ctx.save_for_backward(x, weight, group_list)
+        ctx.has_bias = bias is not None
+        ctx.bias_dtype = bias.dtype if bias is not None else None
+        return torch_npu.npu_grouped_matmul(
+            x=[x],
+            weight=[weight],
+            bias=[bias] if bias is not None else None,
+            group_list=group_list,
+            split_item=2,
+            group_list_type=0,
+            group_type=0,
+            output_dtype=x.dtype,
+        )[0]
+
+    @staticmethod
+    def backward(ctx, grad_output):
+        x, weight, group_list = ctx.saved_tensors
+        grad_output = grad_output.contiguous()
+
+        grad_x = torch_npu.npu_grouped_matmul(
+            x=[grad_output],
+            weight=[weight.transpose(1, 2)],
+            bias=None,
+            group_list=group_list,
+            split_item=2,
+            group_list_type=0,
+            group_type=0,
+            output_dtype=x.dtype,
+        )[0]
+
+        grad_weight = torch_npu.npu_grouped_matmul(
+            x=[x.transpose(0, 1)],
+            weight=[grad_output],
+            bias=None,
+            group_list=group_list,
+            split_item=3,
+            group_list_type=0,
+            group_type=2,
+            output_dtype=weight.dtype,
+        )[0]
+
+        grad_bias = None
+        if ctx.has_bias:
+            group_sizes = torch.cat(
+                (group_list[:1], group_list[1:] - group_list[:-1])
+            )
+            group_indices = torch.repeat_interleave(
+                torch.arange(weight.size(0), device=group_list.device),
+                group_sizes,
+                output_size=grad_output.size(0),
+            )
+            bias_grad_source = grad_output.to(dtype=ctx.bias_dtype)
+            grad_bias = bias_grad_source.new_zeros(weight.size(0), weight.size(2))
+            grad_bias.index_add_(0, group_indices, bias_grad_source)
+
+        return grad_x, grad_weight, grad_bias, None
+
+
+def npu_grouped_matmul_autograd(x, weight, bias, group_list):
+    return NPUGroupedMatmulFunction.apply(x, weight, bias, group_list)

 SAMPLE_SIZE = 64
+logger = logging.getLogger(__name__)
+
+
+def parse_dynamic_shape_list():
+    """Parse SHAPE_LIST as ``batch_size;batch_size`` or ``batch_size,...``."""
+    shape_list = []
+    shape_list_str = os.getenv("SHAPE_LIST", "")
+    for item in shape_list_str.split(";"):
+        item = item.strip()
+        if not item:
+            continue
+        try:
+            shape_list.append(int(item.split(",", 1)[0].strip()))
+        except ValueError as exc:
+            raise ValueError(f"Invalid SHAPE_LIST item: {item!r}") from exc
+    return shape_list
+
+
+def _dynamic_compile_value():
+    value = os.getenv("ENABLE_DYNAMIC_COMPILE", "False").strip().lower()
+    if value in ("true", "false"):
+        return value == "true"
+    if value == "none":
+        return None
+    raise ValueError("ENABLE_DYNAMIC_COMPILE must be True, False, or None")
+
+
+def _model_input_tensor(model, model_input, batch_size):
+    """Build the same flattened feature tensor used by BaseModel.fit/predict."""
+    arrays = []
+    for feature in model.feature_index:
+        value = np.asarray(model_input[feature])
+        if value.ndim == 1:
+            value = np.expand_dims(value, axis=1)
+        indices = np.arange(batch_size) % value.shape[0]
+        arrays.append(value[indices])
+    return torch.from_numpy(np.concatenate(arrays, axis=-1)).float().to(next(model.parameters()).device)
+
+
+def run_dynamic_shape_inference(model, model_input, model_name):
+    """Run a symbolically dynamic batch-shape benchmark when SHAPE_LIST is set.
+
+    Returns True when the dynamic path was selected, otherwise False so callers
+    can retain their original test flow.
+    """
+    shape_list = parse_dynamic_shape_list()
+    if not shape_list or os.getenv("MODEL_MODE", "infer").upper() != "INFER":
+        return False
+
+    base_model = model
+    base_model.enable_dynamic_shape()
+    feature_dim = max(end for _, end in base_model.feature_index.values())
+    model.eval()
+    if not logger.handlers:
+        handler = logging.StreamHandler(sys.stdout)
+        handler.setFormatter(logging.Formatter("%(asctime)s - %(levelname)s - %(message)s"))
+        logger.addHandler(handler)
+    logger.setLevel(logging.INFO)
+    logger.propagate = False
+    dynamic_compile = _dynamic_compile_value()
+    if os.getenv("MODEL_COMPILE_FLAG", "False").upper() == "TRUE":
+        compile_kwargs = {"dynamic": dynamic_compile, "backend": "inductor"}
+        if os.getenv("MODEL_ACLGRAPH_FLAG", "False").upper() == "TRUE":
+            compile_kwargs["mode"] = "reduce-overhead"
+            model = torch.compile(model, **compile_kwargs)
+            logger.info("Inductor Aclgraph MODE YES")
+        else:
+            model = torch.compile(model, **compile_kwargs)
+            logger.info("Inductor MODE YES")
+
+    def run_once(batch_size):
+        inputs = _model_input_tensor(base_model, model_input, batch_size)
+        if dynamic_compile is None:
+            torch._dynamo.mark_dynamic(inputs, 0)
+        return model(inputs)
+
+    def sync():
+        device_type = next(model.parameters()).device.type
+        if device_type == "cuda":
+            torch.cuda.synchronize()
+        elif device_type == "npu":
+            torch.npu.synchronize()
+
+    shape_index = 0
+
+    def next_shape():
+        nonlocal shape_index
+        batch_size = shape_list[shape_index % len(shape_list)]
+        shape_index += 1
+        return batch_size
+
+    with torch.no_grad():
+        for index in range(30):
+            batch_size = next_shape()
+            logger.info(f"[warmup {index}] shape=({batch_size}, {feature_dim})")
+            _ = run_once(batch_size)
+
+    times_range = []
+    batches_list = []
+    with torch.no_grad():
+        for index in range(210):
+            batch_size = next_shape()
+            logger.info(f"[iter {index}] shape=({batch_size}, {feature_dim})")
+            sync()
+            start_time = time.time()
+            _ = run_once(batch_size)
+            sync()
+            end_time = time.time()
+            times_range.append(end_time - start_time)
+            batches_list.append(batch_size)
+
+    times_range.sort()
+    average = round(sum(times_range) / len(times_range) * 1000, 6)
+    report = {
+        "Batch_size": "Dynamic" if len(set(shape_list)) > 1 else shape_list[0],
+        "model_name": model_name,
+        "QPS": int(sum(batches_list) / sum(times_range)),
+        "AVG Latency": average,
+        "P99 Latency": round(times_range[int(len(times_range) * 0.99)] * 1000, 6),
+        "P999 Latency": round(times_range[int(len(times_range) * 0.999)] * 1000, 6),
+        "P95 Latency": round(times_range[int(len(times_range) * 0.95)] * 1000, 6),
+        "P90 Latency": round(times_range[int(len(times_range) * 0.90)] * 1000, 6),
+    }
+    logger.info(report)
+    return True
 
 

+"""Reproducible native CUDA/torch_npu training benchmark for OpenP5 T5."""
+
+import argparse
+import hashlib
+import json
+import logging
+import math
+import os
+import random
+import time
+from contextlib import nullcontext
+from pathlib import Path
+
+os.environ.setdefault("CUBLAS_WORKSPACE_CONFIG", ":4096:8")
+os.environ.setdefault("HCCL_DETERMINISTIC", "True")
+
+import numpy as np
+import torch
+import torch.distributed as dist
+import torch.multiprocessing as mp
+from data.MultiTaskDataset import MultiTaskDataset
+from model.P5_T5 import P5_T5
+from processor.Collator import Collator
+from processor.SingleMultiDataTaskSampler import SingleMultiDataTaskSampler
+from runner.SingleRunner import SingleRunner
+from torch.nn.parallel import DistributedDataParallel as DDP
+from torch.utils.data import ConcatDataset
+from transformers import AutoTokenizer, T5Config, get_linear_schedule_with_warmup
+from utils import utils
+
+
+LOGGER = logging.getLogger("openp5_benchmark")
+MODEL_NAME = "OpenP5"
+BASE_COMMIT = "7f110389cd5ab51820e29e94a44b6db83df243fb"
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser = utils.parse_global_args(parser)
+    parser = MultiTaskDataset.parse_dataset_args(parser)
+    parser = SingleMultiDataTaskSampler.parse_sampler_args(parser)
+    parser = SingleRunner.parse_runner_args(parser)
+    parser.add_argument("--device", choices=("cpu", "cuda", "npu"), required=True)
+    parser.add_argument("--device_ids", default="0")
+    parser.add_argument(
+        "--precision",
+        choices=("float32", "float16", "bfloat16"),
+        default="bfloat16",
+    )
+    parser.add_argument("--global_batch_size", type=int, default=128)
+    parser.add_argument("--max_optimizer_steps", type=int, default=1000)
+    parser.add_argument("--scheduler_steps", type=int, default=1000)
+    parser.add_argument("--measurement_warmup_steps", type=int, default=20)
+    parser.add_argument("--grad_scaler_init_scale", type=float, default=1.0)
+    parser.add_argument("--optimizer", choices=("adamw", "sgd"), default="adamw")
+    parser.add_argument("--sgd_momentum", type=float, default=0.0)
+    parser.add_argument(
+        "--profiling",
+        action="store_true",
+        default=os.getenv("MODEL_PROFILING_FLAG", "False").lower() == "true",
+    )
+    parser.add_argument("--output_dir", required=True)
+    parser.add_argument("--run_name", required=True)
+    parser.add_argument("--source_base_commit", default=BASE_COMMIT)
+    return parser.parse_args()
+
+
+def set_determinism(seed, device_type):
+    random.seed(seed)
+    np.random.seed(seed)
+    torch.manual_seed(seed)
+    if device_type == "cuda":
+        torch.cuda.manual_seed_all(seed)
+        torch.backends.cuda.matmul.allow_tf32 = False
+        torch.backends.cudnn.allow_tf32 = False
+        torch.backends.cudnn.benchmark = False
+        torch.backends.cudnn.deterministic = True
+        torch.use_deterministic_algorithms(True)
+    elif device_type == "npu":
+        torch.npu.manual_seed_all(seed)
+        if hasattr(torch.npu, "set_deterministic_level"):
+            torch.npu.set_deterministic_level(1)
+        if hasattr(torch.npu, "matmul"):
+            torch.npu.matmul.allow_hf32 = False
+        if hasattr(torch.npu, "conv"):
+            torch.npu.conv.allow_hf32 = False
+    else:
+        torch.use_deterministic_algorithms(True)
+
+
+def synchronize(device_type):
+    if device_type == "cuda":
+        torch.cuda.synchronize()
+    elif device_type == "npu":
+        torch.npu.synchronize()
+
+
+def select_device(device_type, device_id):
+    if device_type == "cuda":
+        torch.cuda.set_device(device_id)
+        return torch.device("cuda", device_id)
+    if device_type == "npu":
+        import torch_npu
+
+        torch_npu.npu.set_device(device_id)
+        return torch.device("npu", device_id)
+    return torch.device("cpu")
+
+
+def initialize_distributed(args, rank, world_size, device_type):
+    if world_size == 1:
+        return
+    os.environ.setdefault("MASTER_ADDR", args.master_addr)
+    os.environ.setdefault("MASTER_PORT", args.master_port)
+    backend = "hccl" if device_type == "npu" else "nccl"
+    dist.init_process_group(backend=backend, rank=rank, world_size=world_size)
+
+
+def build_dataset(args):
+    component_datasets = [MultiTaskDataset(args, dataset_name, "train") for dataset_name in args.datasets.split(",")]
+    train_set = ConcatDataset(component_datasets)
+    pools = []
+    offset = 0
+    for dataset in component_datasets:
+        for task in args.tasks.split(","):
+            pools.append(
+                {
+                    "name": f"{dataset.dataset}:{task}",
+                    "indices": [offset + index for index in dataset.task_data[task]],
+                }
+            )
+        offset += len(dataset)
+    return train_set, pools
+
+
+def permutation_parameters(seed, pool_index, cycle, length):
+    if length <= 1:
+        return 0, 1
+    generator = random.Random(f"{seed}:{pool_index}:{cycle}")
+    start = generator.randrange(length)
+    stride = generator.randrange(1, length)
+    while math.gcd(stride, length) != 1:
+        stride = 1 if stride + 1 == length else stride + 1
+    return start, stride
+
+
+def build_global_schedule(pools, microstep_count, global_microbatch, seed):
+    positions = [0] * len(pools)
+    cycles = [0] * len(pools)
+    parameters = [
+        permutation_parameters(seed, pool_index, 0, len(pool["indices"])) for pool_index, pool in enumerate(pools)
+    ]
+    schedule = []
+    for microstep in range(microstep_count):
+        pool_index = microstep % len(pools)
+        pool = pools[pool_index]["indices"]
+        batch = []
+        for _ in range(global_microbatch):
+            if positions[pool_index] == len(pool):
+                cycles[pool_index] += 1
+                positions[pool_index] = 0
+                parameters[pool_index] = permutation_parameters(seed, pool_index, cycles[pool_index], len(pool))
+            start, stride = parameters[pool_index]
+            permuted_position = (start + positions[pool_index] * stride) % len(pool)
+            sample_index = pool[permuted_position]
+            positions[pool_index] += 1
+            batch.append(sample_index)
+        schedule.append(batch)
+    return schedule
+
+
+def batch_sha256(indices):
+    digest = hashlib.sha256()
+    for index in indices:
+        digest.update(index.to_bytes(8, "little", signed=False))
+    return digest.hexdigest()
+
+
+def tensor_batches_sha256(batches):
+    digest = hashlib.sha256()
+    for batch in batches:
+        for tensor in batch:
+            value = tensor.detach().cpu().contiguous()
+            digest.update(str(value.dtype).encode("ascii"))
+            digest.update(json.dumps(list(value.shape)).encode("ascii"))
+            digest.update(value.numpy().tobytes())
+    return digest.hexdigest()
+
+
+def portable_openp5_initialization(model, tokenizer, seed):
+    """Apply OpenP5's N(0, 1) initialization with a portable CPU RNG."""
+    generator = np.random.RandomState(seed)
+    whole_word_weight = generator.normal(0.0, 1.0, size=tuple(model.encoder.whole_word_embeddings.weight.shape)).astype(
+        np.float32
+    )
+    with torch.no_grad():
+        model.encoder.whole_word_embeddings.weight.copy_(torch.from_numpy(whole_word_weight))
+
+    token_ids = set()
+    for value in range(30000):
+        encoded = tokenizer.encode(str(value))
+        token_ids.update(index for index in encoded if index not in (1, 3))
+    embedding = model.shared.weight
+    with torch.no_grad():
+        for index in sorted(token_ids):
+            row = generator.normal(0.0, 1.0, size=embedding.shape[1]).astype(np.float32)
+            embedding[index].copy_(torch.from_numpy(row))
+
+
+def build_model(args, tokenizer):
+    set_determinism(args.seed, "cpu")
+    config = T5Config.from_pretrained(args.backbone, local_files_only=True)
+    config.dropout_rate = args.dropout
+    model = P5_T5.from_pretrained(args.backbone, config=config, local_files_only=True)
+    model.resize_token_embeddings(len(tokenizer))
+    if args.random_initialize:
+        portable_openp5_initialization(model, tokenizer, args.seed)
+    return model
+
+
+def optimizer_parameters(model, weight_decay):
+    no_decay = ("bias", "LayerNorm.weight")
+    named_parameters = list(model.named_parameters())
+    return [
+        {
+            "params": [parameter for name, parameter in named_parameters if not any(key in name for key in no_decay)],
+            "weight_decay": weight_decay,
+        },
+        {
+            "params": [parameter for name, parameter in named_parameters if any(key in name for key in no_decay)],
+            "weight_decay": 0.0,
+        },
+    ]
+
+
+def autocast_context(device_type, precision):
+    if precision == "float32":
+        return nullcontext()
+    dtype = torch.float16 if precision == "float16" else torch.bfloat16
+    return torch.autocast(device_type=device_type, dtype=dtype)
+
+
+def calculate_loss(model, tensors, args, device_type):
+    input_ids, attention, whole_word_ids, output_ids, output_attention = tensors
+    with autocast_context(device_type, args.precision):
+        output = model(
+            input_ids=input_ids,
+            whole_word_ids=whole_word_ids,
+            attention_mask=attention,
+            labels=output_ids,
+            alpha=args.alpha,
+            return_dict=True,
+        )
+        token_loss = output["loss"]
+        loss_mask = output_attention.ne(0).float()
+        batch_size, output_length = output_ids.shape
+        masked = token_loss.view(batch_size, output_length) * loss_mask
+        return (masked.sum(dim=1) / loss_mask.sum(dim=1).clamp(min=1)).mean()
+
+
+def write_json(path, value):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8")
+    temporary.replace(path)
+
+
+def init_profiler(args, rank):
+    if not args.profiling or rank != 0:
+        return None
+    profiler_dir = (Path("../profiling") / MODEL_NAME / args.device).resolve()
+    profiler_dir.mkdir(parents=True, exist_ok=True)
+    remaining_steps = args.max_optimizer_steps - args.measurement_warmup_steps
+    warmup_steps = int(remaining_steps > 1)
+    active_steps = min(10, remaining_steps - warmup_steps)
+    if args.device == "npu":
+        import torch_npu
+
+        schedule = torch_npu.profiler.schedule(
+            wait=args.measurement_warmup_steps,
+            warmup=warmup_steps,
+            active=active_steps,
+            repeat=1,
+        )
+        experimental_config = torch_npu.profiler._ExperimentalConfig(
+            export_type=[torch_npu.profiler.ExportType.Text],
+            profiler_level=torch_npu.profiler.ProfilerLevel.Level1,
+            aic_metrics=torch_npu.profiler.AiCMetrics.AiCoreNone,
+            data_simplification=False,
+        )
+        profiler = torch_npu.profiler.profile(
+            activities=[
+                torch_npu.profiler.ProfilerActivity.CPU,
+                torch_npu.profiler.ProfilerActivity.NPU,
+            ],
+            schedule=schedule,
+            on_trace_ready=torch_npu.profiler.tensorboard_trace_handler(str(profiler_dir)),
+            experimental_config=experimental_config,
+        )
+    else:
+        schedule = torch.profiler.schedule(
+            wait=args.measurement_warmup_steps,
+            warmup=warmup_steps,
+            active=active_steps,
+            repeat=1,
+        )
+        activities = [torch.profiler.ProfilerActivity.CPU]
+        if args.device == "cuda":
+            activities.append(torch.profiler.ProfilerActivity.CUDA)
+        profiler = torch.profiler.profile(
+            activities=activities,
+            schedule=schedule,
+            on_trace_ready=torch.profiler.tensorboard_trace_handler(str(profiler_dir)),
+        )
+    LOGGER.info("Profiler traces will be written to %s", profiler_dir)
+    return profiler
+
+
+def latency_summary(measured, args):
+    values = np.asarray(measured, dtype=np.float64)
+    percentiles = {
+        name: float(np.percentile(values, percentile, method="lower"))
+        for name, percentile in (("p90_ms", 90), ("p95_ms", 95), ("p99_ms", 99), ("p999_ms", 99.9))
+    }
+    mean_ms = float(values.mean())
+    result = {
+        "samples": len(measured),
+        "mean_ms": mean_ms,
+        "median_ms": float(np.median(values)),
+        "stddev_ms": float(values.std(ddof=1)) if len(values) > 1 else 0.0,
+        **percentiles,
+        "min_ms": float(values.min()),
+        "max_ms": float(values.max()),
+        "global_samples_per_second": args.global_batch_size * 1000.0 / mean_ms,
+    }
+    output_dir = Path("..") / f"save_results_{args.device}"
+    output_dir.mkdir(parents=True, exist_ok=True)
+    benchmark_result = {
+        "Batch_size": args.global_batch_size,
+        "model_name": MODEL_NAME,
+        "QPS": result["global_samples_per_second"],
+        "AVG Latency": mean_ms,
+        "P999 Latency": result["p999_ms"],
+        "P99 Latency": result["p99_ms"],
+        "P95 Latency": result["p95_ms"],
+        "P90 Latency": result["p90_ms"],
+    }
+    with (output_dir / "performance_result.txt").open("a", encoding="utf-8") as stream:
+        stream.write(f"{args.device}_{MODEL_NAME}_eager_{benchmark_result}\n")
+    return result
+
+
+def validate_args(args, world_size):
+    if args.max_optimizer_steps <= args.measurement_warmup_steps:
+        raise ValueError("max_optimizer_steps must exceed measurement_warmup_steps")
+    if args.scheduler_steps < args.max_optimizer_steps:
+        raise ValueError("scheduler_steps must cover every optimizer step")
+    denominator = world_size * args.gradient_accumulation_steps
+    if args.global_batch_size % denominator:
+        raise ValueError("global_batch_size must be divisible by world_size * gradient_accumulation_steps")
+    if args.dropout != 0.0:
+        raise ValueError("Cross-platform acceptance requires --dropout 0.0")
+    if args.grad_scaler_init_scale <= 0:
+        raise ValueError("grad_scaler_init_scale must be positive")
+    if not 0.0 <= args.sgd_momentum < 1.0:
+        raise ValueError("sgd_momentum must be in [0, 1)")
+    if args.source_base_commit != BASE_COMMIT:
+        raise ValueError(f"Expected source base commit {BASE_COMMIT}")
+
+
+def run_training(rank, world_size, device_ids, args):
+    args.rank = rank
+    args.world_size = world_size
+    args.distributed = int(world_size > 1)
+    validate_args(args, world_size)
+    device_id = device_ids[rank]
+    device = select_device(args.device, device_id)
+    initialize_distributed(args, rank, world_size, args.device)
+    set_determinism(args.seed, args.device)
+
+    tokenizer = AutoTokenizer.from_pretrained(args.backbone, local_files_only=True)
+    train_set, pools = build_dataset(args)
+    microbatch_per_rank = args.global_batch_size // (world_size * args.gradient_accumulation_steps)
+    global_microbatch = microbatch_per_rank * world_size
+    microstep_count = args.max_optimizer_steps * args.gradient_accumulation_steps
+    schedule = build_global_schedule(pools, microstep_count, global_microbatch, args.seed)
+    collator = Collator(tokenizer)
+
+    model = build_model(args, tokenizer)
+    model.to(device)
+    if world_size > 1:
+        model = DDP(model, device_ids=[device_id], broadcast_buffers=False)
+
+    parameter_groups = optimizer_parameters(model, args.weight_decay)
+    if args.optimizer == "adamw":
+        optimizer = torch.optim.AdamW(
+            parameter_groups,
+            lr=args.lr,
+            eps=args.adam_eps,
+            foreach=False,
+        )
+    else:
+        optimizer = torch.optim.SGD(
+            parameter_groups,
+            lr=args.lr,
+            momentum=args.sgd_momentum,
+            foreach=False,
+        )
+    warmup_scheduler_steps = int(args.scheduler_steps * args.warmup_prop)
+    scheduler = get_linear_schedule_with_warmup(optimizer, warmup_scheduler_steps, args.scheduler_steps)
+    scaler = torch.amp.GradScaler(
+        args.device,
+        init_scale=args.grad_scaler_init_scale,
+        enabled=args.precision == "float16",
+    )
+
+    output_dir = Path(args.output_dir)
+    if rank == 0:
+        output_dir.mkdir(parents=True, exist_ok=True)
+        write_json(
+            output_dir / "manifest.json",
+            {
+                "run_name": args.run_name,
+                "source_base_commit": args.source_base_commit,
+                "device": args.device,
+                "device_ids": device_ids,
+                "precision": args.precision,
+                "seed": args.seed,
+                "world_size": world_size,
+                "microbatch_per_rank": microbatch_per_rank,
+                "gradient_accumulation_steps": args.gradient_accumulation_steps,
+                "global_batch_size": args.global_batch_size,
+                "optimizer_steps": args.max_optimizer_steps,
+                "optimizer": args.optimizer,
+                "learning_rate": args.lr,
+                "weight_decay": args.weight_decay,
+                "adam_epsilon": args.adam_eps if args.optimizer == "adamw" else None,
+                "sgd_momentum": args.sgd_momentum if args.optimizer == "sgd" else None,
+                "scheduler_steps": args.scheduler_steps,
+                "scheduler_warmup_steps": warmup_scheduler_steps,
+                "measurement_warmup_steps": args.measurement_warmup_steps,
+                "profiling": args.profiling,
+            },
+        )
+
+    model.train()
+    optimizer.zero_grad(set_to_none=True)
+    step_records = []
+    profiler = init_profiler(args, rank)
+    if profiler:
+        profiler.start()
+    for optimizer_step in range(1, args.max_optimizer_steps + 1):
+        prepared_batches = []
+        global_batches = []
+        for accumulation_index in range(args.gradient_accumulation_steps):
+            schedule_index = (optimizer_step - 1) * args.gradient_accumulation_steps + accumulation_index
+            global_indices = schedule[schedule_index]
+            local_start = rank * microbatch_per_rank
+            local_indices = global_indices[local_start : local_start + microbatch_per_rank]
+            prepared_batches.append(collator([train_set[index] for index in local_indices]))
+            global_batches.append(global_indices)
+
+        synchronize(args.device)
+        start_time = time.perf_counter()
+        local_step_loss = torch.zeros((), dtype=torch.float32, device=device)
+        learning_rate = optimizer.param_groups[0]["lr"]
+        for accumulation_index, cpu_batch in enumerate(prepared_batches):
+            tensors = tuple(tensor.to(device, non_blocking=True) for tensor in cpu_batch)
+            should_sync = accumulation_index + 1 == args.gradient_accumulation_steps
+            sync_context = nullcontext() if should_sync or world_size == 1 else model.no_sync()
+            with sync_context:
+                loss = calculate_loss(model, tensors, args, args.device)
+                local_step_loss += loss.detach().float() / args.gradient_accumulation_steps
+                scaler.scale(loss / args.gradient_accumulation_steps).backward()
+
+        scaler.unscale_(optimizer)
+        if args.clip > 0:
+            torch.nn.utils.clip_grad_norm_(model.parameters(), args.clip, foreach=False)
+        if scaler.is_enabled():
+            scale_before = scaler.get_scale()
+            scaler.step(optimizer)
+            scaler.update()
+            if scaler.get_scale() < scale_before:
+                raise RuntimeError("Gradient overflow skipped an update; optimizer-step contract broken")
+        else:
+            optimizer.step()
+        scheduler.step()
+        optimizer.zero_grad(set_to_none=True)
+        synchronize(args.device)
+        latency_ms = (time.perf_counter() - start_time) * 1000.0
+
+        reduced_loss = local_step_loss.clone()
+        reduced_latency = torch.tensor(latency_ms, dtype=torch.float32, device=device)
+        if world_size > 1:
+            dist.all_reduce(reduced_loss, op=dist.ReduceOp.SUM)
+            reduced_loss /= world_size
+            dist.all_reduce(reduced_latency, op=dist.ReduceOp.MAX)
+        if rank == 0:
+            flattened_indices = [index for batch in global_batches for index in batch]
+            record = {
+                "optimizer_step": optimizer_step,
+                "loss": float(reduced_loss.cpu()),
+                "latency_ms": float(reduced_latency.cpu()),
+                "learning_rate": learning_rate,
+                "global_batch_sha256": batch_sha256(flattened_indices),
+                "rank0_input_batch_sha256": tensor_batches_sha256(prepared_batches),
+                "warmup": optimizer_step <= args.measurement_warmup_steps,
+            }
+            step_records.append(record)
+            if optimizer_step == 1 or optimizer_step % args.logging_step == 0:
+                LOGGER.info(
+                    "optimizer_step=%d loss=%.8f latency_ms=%.3f",
+                    optimizer_step,
+                    record["loss"],
+                    record["latency_ms"],
+                )
+        if profiler:
+            profiler.step()
+
+    if profiler:
+        profiler.stop()
+
+    if rank == 0:
+        step_path = output_dir / "steps.jsonl"
+        with step_path.open("w", encoding="utf-8") as stream:
+            for record in step_records:
+                stream.write(json.dumps(record, sort_keys=True) + "\n")
+        measured = [record["latency_ms"] for record in step_records if not record["warmup"]]
+        measurement = latency_summary(measured, args)
+        measurement.update(
+            {
+                "unit": "ms/optimizer-step",
+                "warmup_steps": args.measurement_warmup_steps,
+                "first_measured_optimizer_step": args.measurement_warmup_steps + 1,
+                "last_measured_optimizer_step": args.max_optimizer_steps,
+            }
+        )
+        summary = {
+            "run_name": args.run_name,
+            "status": "complete",
+            "optimizer_steps": args.max_optimizer_steps,
+            "loss_samples": len(step_records),
+            "measurement": measurement,
+        }
+        write_json(output_dir / "summary.json", summary)
+        print(json.dumps(summary, indent=2, sort_keys=True))
+
+    if world_size > 1:
+        dist.barrier()
+        dist.destroy_process_group()
+
+
+def main():
+    logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
+    args = parse_args()
+    device_ids = [int(value) for value in args.device_ids.split(",") if value.strip()]
+    if args.device == "cpu":
+        device_ids = [0]
+    if len(device_ids) == 1:
+        run_training(0, 1, device_ids, args)
+        return
+
+    AutoTokenizer.from_pretrained(args.backbone, local_files_only=True)
+    T5Config.from_pretrained(args.backbone, local_files_only=True)
+    os.environ["HF_HUB_OFFLINE"] = "1"
+    os.environ["TRANSFORMERS_OFFLINE"] = "1"
+    mp.spawn(
+        run_training,
+        args=(len(device_ids), device_ids, args),
+        nprocs=len(device_ids),
+        join=True,
+    )
+
+
+if __name__ == "__main__":
+    main()

+"""Prepare checksum-pinned T5-small and OpenP5 ML-1M assets."""
+
+import argparse
+import hashlib
+import os
+import shutil
+import urllib.request
+from pathlib import Path
+
+
+MODEL_REVISION = "df1b051c49625cf57a3d0d8d3863ed4d13564fe4"
+MODEL_SHA256 = {
+    "config.json": "530e25060e3a8d5f7b0fcf53bfea9f3601165161f3b1914676e98d97cf07bcf1",
+    "generation_config.json": "f5a1c7e2be8092018d8835128987edf0111637dd98e90599cc80310fef75d95a",
+    "model.safetensors": "bd944e5f1b3ad9b70dd9d00010a517059e19265671076b8b0a4a58d9491842bc",
+    "spiece.model": "d60acb128cf7b7f2536e8f38a5b18a05535c9e14c7a355904270e15b0945ea86",
+    "tokenizer.json": "d2acde0d8d71dd30a711834b07781b9c89feaac33fd332f60507699282740066",
+    "tokenizer_config.json": "d1e7146101aa96282057f374aa9c3b260fba2109e5990edb1775d6efc70ffa3c",
+}
+DATA_URL = (
+    "https://drive.usercontent.google.com/download?id=1beb14fh-lPxd-yKLU1KVCIP2HuKvKNF3&export=download&confirm=t"
+)
+DATA_SHA256 = {
+    "user_sequence.txt": "48173f671aad6240aa765f4a5e0e97fb1a0bd9688001be6b7bca59a67dcaf46c",
+}
+DERIVED_SHA256 = {
+    "user_indexing.txt": "9afec1d242970a4daafb7c7ad519456c83b2aedcfafd52a5beb65d4031690cda",
+    "item_sequential_indexing_original.txt": "4f79d4eab01855cbfea92ac9a76f1d3c3c6738ceba3a87a4717617085042db3c",
+    "user_sequence_sequential_indexing_original.txt": "674b1761c4ee30718b88044e392e714d5b0cfc3c380b282eefa8632965fcd1e7",
+}
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--asset-root", default="adaptation/assets")
+    parser.add_argument(
+        "--source-root",
+        default=os.getenv("OPENP5_ASSET_SOURCE"),
+        help="Optional prepared root containing t5-small/ and data/ML1M/",
+    )
+    return parser.parse_args()
+
+
+def sha256_file(path):
+    digest = hashlib.sha256()
+    with Path(path).open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def validate_files(root, expected, *, require_all=True):
+    missing = []
+    for filename, checksum in expected.items():
+        path = root / filename
+        if not path.is_file():
+            missing.append(filename)
+            continue
+        actual = sha256_file(path)
+        if actual != checksum:
+            raise ValueError(f"Checksum mismatch for {path}: expected {checksum}, got {actual}")
+    if require_all and missing:
+        raise FileNotFoundError(f"Missing assets under {root}: {', '.join(missing)}")
+    return missing
+
+
+def copy_prepared_assets(source_root, asset_root):
+    source_root = Path(source_root)
+    relatives = [Path("t5-small"), Path("data/ML1M")]
+    for relative in relatives:
+        source = source_root / relative
+        if not source.is_dir():
+            raise FileNotFoundError(f"Prepared asset directory not found: {source}")
+        destination = asset_root / relative
+        destination.mkdir(parents=True, exist_ok=True)
+        for path in source.iterdir():
+            if path.is_file():
+                shutil.copy2(path, destination / path.name)
+
+
+def download_model(model_root):
+    from huggingface_hub import snapshot_download
+
+    snapshot_download(
+        repo_id="t5-small",
+        revision=MODEL_REVISION,
+        local_dir=model_root,
+        allow_patterns=sorted(MODEL_SHA256),
+    )
+
+
+def download_dataset(data_root):
+    data_root.mkdir(parents=True, exist_ok=True)
+    destination = data_root / "user_sequence.txt"
+    temporary = data_root / "user_sequence.txt.download"
+    with urllib.request.urlopen(DATA_URL, timeout=300) as response:
+        with temporary.open("wb") as output:
+            shutil.copyfileobj(response, output)
+    actual = sha256_file(temporary)
+    expected = DATA_SHA256["user_sequence.txt"]
+    if actual != expected:
+        temporary.unlink(missing_ok=True)
+        raise ValueError(f"Dataset checksum mismatch: expected {expected}, got {actual}")
+    temporary.replace(destination)
+
+
+def main():
+    args = parse_args()
+    asset_root = Path(args.asset_root)
+    model_root = asset_root / "t5-small"
+    data_root = asset_root / "data/ML1M"
+    if args.source_root:
+        copy_prepared_assets(args.source_root, asset_root)
+
+    model_missing = validate_files(model_root, MODEL_SHA256, require_all=False)
+    if model_missing:
+        model_root.mkdir(parents=True, exist_ok=True)
+        download_model(model_root)
+    validate_files(model_root, MODEL_SHA256)
+
+    data_missing = validate_files(data_root, DATA_SHA256, require_all=False)
+    if data_missing:
+        download_dataset(data_root)
+    validate_files(data_root, DATA_SHA256)
+
+    # OpenP5 regenerates missing indexes. Reject corrupt cached indexes first.
+    for filename, expected in DERIVED_SHA256.items():
+        path = data_root / filename
+        if path.exists() and sha256_file(path) != expected:
+            path.unlink()
+    print(f"Validated model assets in {model_root}")
+    print(f"Validated dataset assets in {data_root}")
+
+
+if __name__ == "__main__":
+    main()
